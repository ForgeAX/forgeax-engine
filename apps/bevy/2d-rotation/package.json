{
  "name": "@forgeax/bevy-2d-rotation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Reproduction of Bevy's generic 2D rotation example with player motion and tracking enemies.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "rotation",
      "category": "2D Rendering",
      "status": "implemented"
    },
    "rhiDebug": {
      "riskFamilies": [
        "geometry-scale"
      ]
    },
    "smokeInvocation": "pnpm --filter @forgeax/bevy-2d-rotation smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "demo bundle downstream of engine-runtime sizes"
      },
      "fps": {
        "enabled": false,
        "reason": "motion behavior is covered by deterministic smoke"
      },
      "bench": {
        "enabled": false,
        "reason": "demo-specific benchmark is not the target"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/bevy-2d-rotation smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; Bevy example reproduction"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-input": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
