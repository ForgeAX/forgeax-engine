{
  "name": "@forgeax/bevy-bloom-2d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Reproduce Bevy's `bloom_2d` example with bright 2D meshes and a camera bloom toggle.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "bloom_2d",
      "category": "2D Rendering",
      "status": "implemented"
    },
    "smokeInvocation": "pnpm --filter @forgeax/bevy-bloom-2d smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle downstream of engine-runtime sizes already tracked at the package level"
      },
      "fps": {
        "enabled": false,
        "reason": "static demo; fps no-regression covered by engine-runtime gates"
      },
      "bench": {
        "enabled": false,
        "reason": "static demo; benchmark focus remains on engine packages"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/bevy-bloom-2d smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; Bevy example reproduction"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine": "workspace:*",
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-input": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
