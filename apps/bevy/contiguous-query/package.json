{
  "name": "@forgeax/bevy-contiguous-query",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Reproduce Bevy's `contiguous_query` example with dense ECS column slices.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "contiguous_query",
      "category": "ECS (Entity Component System)",
      "status": "implemented"
    },
    "smokeInvocation": "pnpm --filter @forgeax/bevy-contiguous-query smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "demo bundle is downstream of engine package metrics"
      },
      "fps": {
        "enabled": false,
        "reason": "contiguous query is verified by ECS behavior"
      },
      "bench": {
        "enabled": false,
        "reason": "dense slice behavior is covered by unit and smoke evidence"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/bevy-contiguous-query smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
