{
  "name": "@forgeax/bevy-custom-skinned-mesh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Reproduction of Bevy's animation/custom_skinned_mesh example with a code-authored weighted ribbon and two-joint palette.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "custom_skinned_mesh",
      "category": "Animation",
      "status": "implemented"
    },
    "rhiDebug": {
      "riskFamilies": [
        "skinning-joints"
      ]
    },
    "smokeInvocation": "pnpm --filter @forgeax/bevy-custom-skinned-mesh smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "demo bundle; engine package sizes are tracked separately"
      },
      "fps": {
        "enabled": false,
        "reason": "custom skin demo; hello-cube and hello-room own fps coverage"
      },
      "bench": {
        "enabled": false,
        "reason": "custom skin demo; no benchmark surface"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/bevy-custom-skinned-mesh smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "implemented Bevy animation reproduction"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-skinning": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
