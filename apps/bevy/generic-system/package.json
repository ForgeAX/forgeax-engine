{
  "name": "@forgeax/bevy-generic-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Reproduce Bevy's generic_system example with state-scoped generic cleanup systems.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser-rhi-debug.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "generic_system",
      "category": "ECS",
      "status": "implemented"
    },
    "rhiDebug": {
      "riskFamilies": [
        "ecs-scheduling"
      ]
    },
    "smokeInvocation": "pnpm --filter @forgeax/bevy-generic-system smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle downstream of engine-runtime sizes already tracked at the package level"
      },
      "fps": {
        "enabled": false,
        "reason": "demo-specific fps evidence belongs to its completed reproduction"
      },
      "bench": {
        "enabled": false,
        "reason": "demo-specific benchmarks belong to its completed reproduction"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/bevy-generic-system smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; Bevy example reproduction"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-state": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
