{
  "name": "@forgeax/bevy-load-gltf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Reproduction of Bevy's `gltf/load_gltf` example through the real glTF SceneAsset path.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "load_gltf",
      "category": "glTF",
      "status": "implemented"
    },
    "smokeInvocation": "pnpm --filter @forgeax/bevy-load-gltf smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "demo bundle downstream of engine package sizes"
      },
      "fps": {
        "enabled": false,
        "reason": "demo-specific fps evidence is not the gate"
      },
      "bench": {
        "enabled": false,
        "reason": "not a benchmark demo"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/bevy-load-gltf smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; Bevy example reproduction"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-gltf": "workspace:*",
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-render": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
