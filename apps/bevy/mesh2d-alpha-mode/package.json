{
  "name": "@forgeax/bevy-mesh2d-alpha-mode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Reproduce Bevy's mesh2d_alpha_mode example with opaque, mask, and blend materials.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "mesh2d_alpha_mode",
      "category": "2D Rendering",
      "status": "implemented"
    },
    "rhiDebug": {
      "riskFamilies": [
        "geometry-scale"
      ]
    },
    "smokeInvocation": "pnpm --filter @forgeax/bevy-mesh2d-alpha-mode smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle downstream of engine-runtime sizes already tracked at the package level"
      },
      "fps": {
        "enabled": false,
        "reason": "static demo; alpha/depth ordering is the completed reproduction criterion"
      },
      "bench": {
        "enabled": false,
        "reason": "demo-specific benchmarks belong to engine packages"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/bevy-mesh2d-alpha-mode smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; Bevy example reproduction"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
