{
  "name": "@forgeax/bevy-shader-defs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Reproduction of Bevy's `shader_defs` example with a custom WGSL IS_RED material variant.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "shader_defs",
      "category": "Shaders",
      "status": "implemented"
    },
    "smokeInvocation": "pnpm --filter @forgeax/bevy-shader-defs smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle downstream of engine runtime sizes already tracked at package level"
      },
      "fps": {
        "enabled": false,
        "reason": "shader variant correctness is the demo witness; fps is covered by engine render gates"
      },
      "bench": {
        "enabled": false,
        "reason": "shader variant correctness is not a benchmark surface"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/bevy-shader-defs smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; Bevy shader_defs reproduction"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
