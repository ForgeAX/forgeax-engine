{
  "name": "@forgeax/bevy-shader-material",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Reproduction of Bevy's shader_material example with a custom WGSL material, texture, and alpha blend.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "shader_material",
      "category": "Shaders",
      "status": "implemented"
    },
    "smokeInvocation": "pnpm --filter @forgeax/bevy-shader-material smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "app bundle downstream of engine package metrics"
      },
      "fps": {
        "enabled": false,
        "reason": "custom material behavior is the demo witness"
      },
      "bench": {
        "enabled": false,
        "reason": "custom material behavior is not a benchmark"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/bevy-shader-material smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-shader-compiler": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
