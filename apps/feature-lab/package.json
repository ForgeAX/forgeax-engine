{
  "name": "@forgeax/feature-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "One page per SDK feature-catalog row: obvious visual toggles and structured probes that testers and CI run as the feature checklist.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke:browser": "node scripts/run-features.mjs",
    "verify:animation": "node scripts/verify-animation.mjs"
  },
  "forgeax": {
    "smokeInvocation": "pnpm --filter @forgeax/feature-lab smoke:browser",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "tester-facing catalog app; bundle size is tracked at the package level"
      },
      "fps": {
        "enabled": false,
        "reason": "features are single-purpose demonstrations, not performance scenes; fps gates live in apps/perf"
      },
      "bench": {
        "enabled": false,
        "reason": "no benchmarks; each feature is a pass/fail demonstration"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/feature-lab test"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-shader": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.50.0",
    "pngjs": "^7.0.0",
    "vite": "8.0.16",
    "vitest": "4.1.11",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*"
  }
}
