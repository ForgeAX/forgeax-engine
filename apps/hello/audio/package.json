{
  "name": "@forgeax/hello-audio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Spacebar one-shot SFX + movable 3D listener + collision-triggered audio cleanup demo.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:gauntlet": "node scripts/smoke-gauntlet.mjs"
  },
  "forgeax": {
    "bevyExample": {
      "name": "play_sound_effect",
      "category": "Audio",
      "status": "implemented"
    },
    "gauntletScenario": {
      "id": "hello-audio-stale-decode-epoch-recovery",
      "script": "smoke:gauntlet",
      "domains": [
        "Audio",
        "Host"
      ],
      "packages": [
        "audio",
        "audio-webaudio",
        "app",
        "runtime"
      ],
      "risks": [
        "baseline",
        "fault",
        "behavioral",
        "recovery",
        "cleanup"
      ],
      "phaseInputs": [
        "baseline",
        "pending-decode",
        "stale-stop",
        "replacement",
        "recovery",
        "cleanup"
      ],
      "evidence": {
        "frontDoors": [
          "ecs-world",
          "dawn-node",
          "browser-app"
        ],
        "legs": [
          "semantic",
          "live",
          "behavioral",
          "recovery"
        ]
      },
      "oracle": {
        "stdoutIncludes": [
          "[m20] Dawn normal audio front door: PASS",
          "[m20] Browser stale-decode epoch recovery: PASS"
        ]
      }
    },
    "smokeInvocation": "pnpm --filter @forgeax/hello-audio smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle shape already tracked at engine package level"
      },
      "fps": {
        "enabled": false,
        "reason": "fps no-regression covered by hello-cube / hello-room gates"
      },
      "bench": {
        "enabled": false,
        "reason": "perf bench anchored at engine-runtime / engine-math packages"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/hello-audio smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; production exemplar demo"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-audio": "workspace:*",
    "@forgeax/engine-audio-webaudio": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-input": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/engine-physics": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-render": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "pngjs": "^7.0.0",
    "typescript": "~5.8.3",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
