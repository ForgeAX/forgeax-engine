{
  "name": "@forgeax/hello-cube",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "End-to-end Hello Cube ECS-driven binding exemplar (D-S10 + D-S1 four-path allow-list reused).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "rhiDebug": {
      "riskFamilies": ["programmable-pipelines"]
    },
    "smokeInvocation": "pnpm --filter @forgeax/hello-cube smoke",
    "gauntletScenario": {
      "id": "hello-cube-dawn",
      "script": "smoke",
      "domains": ["World and host contract", "GPU abstraction and implementations"],
      "packages": ["@forgeax/engine-ecs", "@forgeax/engine-runtime", "@forgeax/engine-rhi-wgpu"],
      "risks": ["baseline", "gpu", "behavioral"],
      "phaseInputs": ["baseline"],
      "evidence": {
        "frontDoors": ["dawn-node"],
        "legs": ["semantic", "gpu"]
      },
      "oracle": {
        "stdoutIncludes": [
          "[hello-cube] backend=webgpu",
          "[smoke] frames observed="
        ]
      }
    },
    "_comment": "smokeInvocation = package manifest SSOT for the authoritative dawn-smoke-roster sharded gate; the roster proves this unique 60-frame receipt entry. CI must not duplicate the smoke literal.",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle (dist/assets) shape is downstream of @forgeax/engine-runtime + @forgeax/engine-rhi-webgpu sizes already tracked at the package level"
      },
      "fps": {
        "enabled": false,
        "reason": "triangle baseline anchor only, hello-cube ECS smoke covers GPU"
      },
      "bench": {
        "enabled": false,
        "reason": "ECS-driven binding exemplar; bench focus stays on @forgeax/engine-math"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/hello-cube smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; spike artefacts archived in feat-20260511-naga-rhi-wgpu-merge M5 (PR #34 + git history)"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-rhi": "workspace:*",
    "@forgeax/engine-rhi-webgpu": "workspace:*",
    "@forgeax/engine-rhi-wgpu": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-scene": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*",
    "@webgpu/types": "^0.1.74"
  }
}
