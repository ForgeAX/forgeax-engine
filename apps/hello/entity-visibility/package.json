{
  "name": "@forgeax/hello-entity-visibility",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Visibility inheritance and shadow participation demo.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:rhi-debug": "node scripts/smoke-rhi-debug.mjs"
  },
  "forgeax": {
    "smokeInvocation": "pnpm --filter @forgeax/hello-entity-visibility smoke",
    "rhiDebug": {
      "riskFamilies": [
        "lighting-shadows"
      ]
    },
    "gauntletScenario": {
      "id": "hello-entity-visibility-dawn",
      "script": "smoke",
      "domains": [
        "World and host contract",
        "Rendering and shader construction"
      ],
      "packages": [
        "@forgeax/engine-ecs",
        "@forgeax/engine-render",
        "@forgeax/engine-runtime"
      ],
      "risks": [
        "gpu",
        "behavioral"
      ],
      "phaseInputs": [
        "baseline"
      ],
      "evidence": {
        "frontDoors": [
          "dawn-node",
          "browser"
        ],
        "legs": [
          "semantic",
          "gpu",
          "behavioral"
        ]
      },
      "oracle": {
        "stdoutIncludes": [
          "[hello-entity-visibility] backend=webgpu",
          "[smoke] frames observed="
        ]
      }
    },
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "Demo bundle size is downstream of the shared runtime packages."
      },
      "fps": {
        "enabled": false,
        "reason": "The gate is a deterministic visibility and shadow smoke."
      },
      "bench": {
        "enabled": false,
        "reason": "Visibility behavior is covered by integration and smoke gates."
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/hello-entity-visibility smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "This is a production-path demonstration, not a spike."
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "pngjs": "^7.0.0",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
