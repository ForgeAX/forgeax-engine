{
  "name": "@forgeax/hello-foliage-transmission",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Back-lit foliage panels that falsify KHR diffuse transmission against an opaque control and a texture mask.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:rhi": "FORGEAX_FOLIAGE_CAPTURE_DIR=artifacts/rhi node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:parity": "node scripts/smoke-backend-parity.mjs",
    "perf": "node scripts/perf-dawn.mjs"
  },
  "forgeax": {
    "rhiDebug": {
      "riskFamilies": [
        "materials-textures"
      ]
    },
    "smokeInvocation": "pnpm --filter @forgeax/hello-foliage-transmission smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "demo bundle is downstream of engine-runtime sizes"
      },
      "fps": {
        "enabled": false,
        "reason": "transmission cost is measured by the paired on/off perf script"
      },
      "bench": {
        "enabled": false,
        "reason": "the on/off frame-time comparison is a local diagnostic, not a CI benchmark"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/hello-foliage-transmission smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; diffuse transmission carrier"
      }
    }
  },
  "dependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-rhi-debug": "workspace:*",
    "@forgeax/engine-rhi-webgpu": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
