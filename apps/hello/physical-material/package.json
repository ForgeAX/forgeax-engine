{
  "name": "@forgeax/hello-physical-material",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Physical clearcoat material carrier with rigid and skinned contract surfaces.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "smokeInvocation": "pnpm --filter @forgeax/hello-physical-material smoke",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "material carrier bundle is downstream of engine packages"
      },
      "fps": {
        "enabled": false,
        "reason": "clearcoat correctness is validated by frame and pixel gates"
      },
      "bench": {
        "enabled": false,
        "reason": "this carrier has no benchmark workload"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/hello-physical-material smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "this is a physical material integration carrier"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-image": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-skinning": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-shader": "workspace:*",
    "@forgeax/engine-shader-compiler": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@forgeax/engine-rhi-debug": "workspace:*",
    "@forgeax/engine-rhi-webgpu": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.56.1",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
