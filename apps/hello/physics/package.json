{
  "name": "@forgeax/hello-physics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Physics integration demo (static ground + dynamic sphere free-fall + bounce) using createApp physics opts.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-physics": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-render": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  },
  "forgeax": {
    "smokeInvocation": "pnpm --filter @forgeax/hello-physics smoke",
    "gauntletScenario": {
      "id": "hello-physics-large-delta-recovery",
      "script": "smoke",
      "domains": [
        "World and host contract",
        "Simulation and media implementations"
      ],
      "packages": [
        "@forgeax/engine-ecs",
        "@forgeax/engine-physics",
        "@forgeax/engine-physics-rapier3d"
      ],
      "risks": [
        "baseline",
        "behavioral",
        "fault",
        "recovery",
        "cleanup"
      ],
      "phaseInputs": [
        "baseline",
        "behavioral",
        "fault",
        "recovery",
        "cleanup"
      ],
      "evidence": {
        "frontDoors": [
          "physics-app",
          "dawn-node"
        ],
        "legs": [
          "semantic",
          "behavioral",
          "recovery"
        ]
      },
      "oracle": {
        "stdoutIncludes": [
          "[m25] baseline: PASS",
          "[m25] oversized delta: PASS",
          "[m25] healthy recovery: PASS",
          "[m25] cleanup: PASS",
          "[m25] PASS - physics large-delta recovery"
        ]
      }
    },
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle (dist/assets) shape is downstream of @forgeax/engine-app + @forgeax/engine-runtime sizes already tracked at the package level"
      },
      "fps": {
        "enabled": false,
        "reason": "physics smoke covers structural boot + WASM load, not GPU render path"
      },
      "bench": {
        "enabled": false,
        "reason": "physics demo exemplar; bench focus stays on @forgeax/engine-math and physics backends"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/hello-physics smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; this is the createApp physics integration exemplar"
      }
    }
  }
}
