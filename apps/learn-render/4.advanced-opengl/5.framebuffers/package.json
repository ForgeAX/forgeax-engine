{
  "name": "@forgeax/app-learn-render-4-advanced-opengl-5-framebuffers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "learn-render LearnOpenGL section 4.advanced-opengl 5.framebuffers — offscreen render-to-texture + 6 fullscreen post-process effects (passthrough / inversion / grayscale / sharpen / blur / edge-detection).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs && node scripts/smoke-browser-cycle.mjs",
    "smoke:gauntlet": "node scripts/smoke-gauntlet.mjs",
    "smoke:browser-live": "node scripts/smoke-browser-live.mjs"
  },
  "forgeax": {
    "rhiDebug": {
      "riskFamilies": ["raster-state"]
    },
    "smokeInvocation": "pnpm --filter @forgeax/app-learn-render-4-advanced-opengl-5-framebuffers smoke:gauntlet",
    "gauntletScenario": {
      "id": "m24-render-feature-plan-recovery",
      "script": "smoke:gauntlet",
      "domains": [
        "Rendering and shader construction",
        "Inspection, debugging, and development bridges"
      ],
      "packages": [
        "@forgeax/engine-app",
        "@forgeax/engine-render-graph",
        "@forgeax/engine-render",
        "@forgeax/engine-runtime",
        "@forgeax/engine-rhi-debug"
      ],
      "risks": ["baseline", "dynamic", "live", "fault", "recovery", "behavioral", "visual", "cleanup"],
      "phaseInputs": ["baseline", "dynamic", "live", "fault", "recovery", "cleanup"],
      "evidence": {
        "frontDoors": ["dawn-node", "render-graph-cycle", "browser-webgpu", "browser-live", "rhi-debug"],
        "legs": ["semantic", "live", "gpu", "behavioral", "recovery"]
      },
      "oracle": {
        "stdoutIncludes": [
          "[smoke] M24 cycle/recovery: PASS",
          "[m24] browser cycle/recovery: PASS",
          "[m24] browser live cycle/recovery: PASS"
        ]
      }
    },
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle (dist/assets) shape is downstream of @forgeax/engine-runtime size already tracked at the package level"
      },
      "fps": {
        "enabled": false,
        "reason": "OOS-11 fps anchor stays on hello-triangle; per-app fps drift is not gated for learn-render examples"
      },
      "bench": {
        "enabled": false,
        "reason": "pixel-parity bench drives parity-forgeax vs parity-threejs; learn-render entries land as bench:pixel-parity placeholders only"
      },
      "gate": {
        "enabled": false,
        "reason": "placeholder smoke script; visual verification via dawn-node pixel-readback"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; LearnOpenGL section-4.5 framebuffers tutorial example"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/engine-render-graph": "workspace:*",
    "@forgeax/engine-rhi-webgpu": "workspace:*",
    "@forgeax/engine-rhi-wgpu": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-render": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "pngjs": "^7.0.0",
    "playwright": "^1.50.0",
    "vite": "8.0.16"
  }
}
