{
  "name": "@forgeax/app-learn-render-6-pbr-3-ibl-specular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "learn-render LearnOpenGL section 6.pbr 3.ibl-specular -- IBL diffuse + specular split-sum sphere matrix via @forgeax/engine-app + Skylight component.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "smokeInvocation": "pnpm --filter @forgeax/app-learn-render-6-pbr-3-ibl-specular smoke",
    "rhiDebug": {
      "riskFamilies": [
        "materials-textures"
      ]
    },
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle (dist/assets) shape is downstream of @forgeax/engine-runtime size already tracked at the package level"
      },
      "fps": {
        "enabled": false,
        "reason": "OOS-11 fps anchor stays on hello-triangle; per-app fps drift is not gated for learn-render examples"
      },
      "bench": {
        "enabled": false,
        "reason": "pixel-parity bench drives parity-forgeax vs parity-threejs; learn-render entries land as bench:pixel-parity placeholders only"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/app-learn-render-6-pbr-3-ibl-specular smoke"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; LearnOpenGL section-6.2 IBL specular demo"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-input": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/engine-rhi": "workspace:*",
    "@forgeax/engine-rhi-webgpu": "workspace:*",
    "@forgeax/engine-rhi-wgpu": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-render": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@forgeax/engine-image": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.50.0",
    "upng-js": "^2.1.0",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
