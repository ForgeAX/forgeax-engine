{
  "name": "@forgeax/app-learn-render-6-pbr-4-render-target-reflection",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "learn-render 6.pbr CubeCamera cube RenderTarget source, texture_cube material consumer, and receipt-bound readback.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-dawn.mjs",
    "smoke:ssr-fallback": "VITE_REFLECTION_PROBE_EVIDENCE=1 node scripts/smoke-dawn.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "rhiDebug": {
      "riskFamilies": [
        "materials-textures",
        "render-targets"
      ]
    },
    "smokeInvocation": "pnpm --filter @forgeax/app-learn-render-6-pbr-4-render-target-reflection smoke:ssr-fallback",
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "vite app bundle size is downstream of @forgeax/engine-runtime size already tracked at the package level"
      },
      "fps": {
        "enabled": false,
        "reason": "OOS-11 fps anchor stays on hello-triangle; this consumer is a target lifecycle fixture"
      },
      "bench": {
        "enabled": false,
        "reason": "pixel-parity bench is owned by parity-forgeax and parity-threejs"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/app-learn-render-6-pbr-4-render-target-reflection smoke:ssr-fallback"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike app; this is the M1 target lifecycle consumer"
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-rhi": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.50.0",
    "vite": "8.0.16",
    "@forgeax/engine-dawn-node": "workspace:*"
  }
}
