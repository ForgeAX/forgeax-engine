{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@webgpu/types"]
  },
  "include": ["assets/**/*.ts", "scripts/**/*.ts", "__tests__/**/*.ts", "mech-gt/assets/**/*.ts", "mech-gt/scripts/**/*.mts", "mech-gt-car/assets/**/*.ts", "maid-whale/assets/**/*.ts", "gallery/assets/**/*.ts", "scifi-mech/assets/**/*.ts"]
}
