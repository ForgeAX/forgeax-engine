{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeaX Native Ray Query Triangle",
  "version": "0.0.0",
  "identifier": "com.forgeax.native-ray-query-triangle",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ForgeaX Native Ray Query",
        "width": 640,
        "height": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
