{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeax.dev/schema/color-lighting/visual-evidence.schema.json",
  "title": "Color lighting parity visual evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "width", "height", "background", "framing", "artifacts"],
  "allOf": [
    {
      "if": { "properties": { "evidenceKind": { "const": "vertex-color" } } },
      "then": {
        "required": ["evidenceKind", "colorDomain", "frameCount", "epsilon", "sourceFixtureHash", "producers"],
        "properties": {
          "colorDomain": { "enum": ["linearHdr", "displayEncoded"] },
          "frameCount": { "const": 60 },
          "epsilon": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rgb", "alpha"],
            "properties": {
              "rgb": { "type": "number", "minimum": 0, "maximum": 0.05 },
              "alpha": { "type": "number", "minimum": 0, "maximum": 0.05 }
            }
          },
          "sourceFixtureHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "producers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["forgeax", "three"],
            "properties": {
              "forgeax": { "allOf": [{ "$ref": "#/$defs/producer" }, { "properties": { "implementation": { "const": "forgeax" } } }] },
              "three": { "allOf": [{ "$ref": "#/$defs/producer" }, { "properties": { "implementation": { "const": "three" }, "version": { "const": "r184" } } }] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "evidenceKind": { "const": "rect-area-ltc" } } },
      "then": {
        "required": ["evidenceKind", "colorDomain", "frameCount", "epsilon", "sourceFixtureHash", "producers", "falsifier"],
        "properties": {
          "colorDomain": { "const": "linearHdr" },
          "frameCount": { "const": 60 },
          "epsilon": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rgb"],
            "properties": { "rgb": { "type": "number", "minimum": 0, "maximum": 0.05 } }
          },
          "sourceFixtureHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "producers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["browser", "dawn"],
            "properties": {
              "browser": { "$ref": "#/$defs/rectAreaProducer" },
              "dawn": { "$ref": "#/$defs/rectAreaProducer" }
            }
          },
          "falsifier": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reverseFront", "zeroLtc"],
            "properties": {
              "reverseFront": { "$ref": "#/$defs/rectAreaFalsifier" },
              "zeroLtc": { "$ref": "#/$defs/rectAreaFalsifier" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "evidenceKind": { "const": "extended-lighting" } } },
      "then": {
        "required": ["evidenceKind", "colorDomain", "frameCount", "epsilon", "sourceFixtureHash", "producers", "falsifier"],
        "properties": {
          "colorDomain": { "const": "linearHdr" },
          "frameCount": { "const": 60 },
          "epsilon": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rgb"],
            "properties": { "rgb": { "type": "number", "minimum": 0, "maximum": 0.05 } }
          },
          "sourceFixtureHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "producers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["browser", "dawn"],
            "properties": {
              "browser": { "$ref": "#/$defs/extendedLightingProducer" },
              "dawn": { "$ref": "#/$defs/extendedLightingProducer" }
            }
          },
          "falsifier": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/extendedLightingFalsifier" }
          }
        }
      }
    }
  ],
  "properties": {
    "evidenceKind": { "enum": ["vertex-color", "rect-area-ltc", "extended-lighting"] },
    "caseId": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "background": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "items": false
    },
    "framing": { "type": "string", "minLength": 1 },
    "colorDomain": { "enum": ["linearHdr", "displayEncoded"] },
    "frameCount": { "type": "integer", "minimum": 0 },
    "epsilon": { "type": "object" },
    "sourceFixtureHash": { "type": "string" },
    "producers": { "type": "object" },
    "falsifier": { "oneOf": [{ "type": "object" }, { "type": "array" }] },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "renderer", "adapterId", "pinnedCommit", "buildIdentity"],
      "properties": {
        "implementation": { "enum": ["forgeax", "three"] },
        "version": { "type": "string", "minLength": 1 },
        "renderer": { "const": "webgpu" },
        "adapterId": { "type": "string", "minLength": 1 },
        "pinnedCommit": { "type": "string", "minLength": 1 },
        "buildIdentity": { "type": "string", "minLength": 1 }
      }
    },
    "rectAreaProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed", "verdict", "confidence"],
      "properties": {
        "status": { "enum": ["not-run", "unavailable", "complete", "failed"] },
        "observed": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["notRun", "failed", "passed"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "bytes": { "type": ["array", "null"], "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "rawHash": { "type": ["string", "null"], "pattern": "^[0-9a-f-]{8,}$" },
        "pixels": { "type": ["array", "null"], "items": { "type": "number" } },
        "validation": { "type": "string", "minLength": 1 }
      }
    },
    "rectAreaFalsifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed", "verdict", "confidence"],
      "properties": {
        "status": { "enum": ["not-run", "unavailable", "complete", "failed"] },
        "observed": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["notRun", "failed", "passed"] },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "extendedLightingReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "byteLength"],
      "properties": {
        "status": { "enum": ["not-run", "ready", "recovered"] },
        "byteLength": { "const": 160 }
      }
    },
    "extendedLightingResourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "topology", "resourceCount", "uploadBytes"],
      "properties": {
        "status": { "enum": ["not-run", "candidate", "accepted", "lkg", "recovered"] },
        "topology": { "const": "extendedLighting" },
        "resourceCount": { "type": "integer", "minimum": 0 },
        "uploadBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "extendedLightingProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed", "verdict", "confidence", "identity", "numericRoi", "recordReceipt", "resourceReceipt"],
      "properties": {
        "status": { "enum": ["not-run", "unavailable", "complete", "failed"] },
        "observed": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["notRun", "failed", "passed"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "identity": { "type": "string", "minLength": 1 },
        "numericRoi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["analyticMax", "roiMax", "epsilon", "colorDomain"],
          "properties": {
            "analyticMax": { "type": "number", "minimum": 0 },
            "roiMax": { "type": "number", "minimum": 0 },
            "epsilon": { "type": "number", "minimum": 0 },
            "colorDomain": { "const": "linearHdr" }
          }
        },
        "recordReceipt": { "$ref": "#/$defs/extendedLightingReceipt" },
        "resourceReceipt": { "$ref": "#/$defs/extendedLightingResourceReceipt" }
      }
    },
    "extendedLightingFalsifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "observed", "verdict", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["not-run", "unavailable", "complete", "failed"] },
        "observed": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["notRun", "failed", "passed"] },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "caseId", "width", "height", "background", "frameId", "rawHash", "observed", "verdict", "confidence"],
      "properties": {
        "kind": { "enum": ["forgeax-final", "three-primary-final", "diff-roi"] },
        "url": { "type": "string", "minLength": 1 },
        "caseId": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ],
          "items": false
        },
        "frameId": { "type": "integer", "minimum": 0 },
        "rawHash": { "type": "string", "pattern": "^[0-9a-f]{8,}$" },
        "observed": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["pass", "fail", "unknown"] },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    }
  }
}
