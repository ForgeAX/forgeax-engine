{
  "name": "@forgeax/showcase-canvas-texture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Draw on a canvas and see it update on a 3D sign, with live departures and telemetry presets.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "Engine packages own bundle budgets."
      },
      "fps": {
        "enabled": false,
        "reason": "Interactive showcase; performance gates belong to the renderer."
      },
      "bench": {
        "enabled": false,
        "reason": "Correctness is checked by browser interactions."
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/showcase-canvas-texture smoke:browser"
      },
      "spike-report": {
        "enabled": false,
        "reason": "Production CanvasTexture demonstration, not a spike."
      }
    }
  },
  "dependencies": {
    "@forgeax/engine": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "vite": "8.0.16"
  }
}
