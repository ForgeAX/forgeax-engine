{
  "name": "@forgeax/water-body-geometry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine": "workspace:*",
    "@forgeax/engine-water": "workspace:*",
    "@forgeax/engine-physics": "workspace:*",
    "@forgeax/engine-physics-rapier3d": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-pack": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "@forgeax/engine-shader-compiler": "workspace:*"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "Informational app size has no regression threshold; app input builds and native runtime acceptance remain independently gated."
      },
      "fps": {
        "enabled": true
      },
      "bench": {
        "enabled": false,
        "reason": "Interactive geometry acceptance is measured by the maintained frame smoke, rather than a microbenchmark."
      },
      "gate": {
        "enabled": true,
        "command": "node scripts/smoke.mjs",
        "cwd": "."
      },
      "spike-report": {
        "enabled": false,
        "reason": "This maintained Water demo has no spike report."
      }
    },
    "gallery": {
      "visible": false
    }
  },
  "description": "R1 \u00b7 Body geometry and TerrainProvider observatory"
}
