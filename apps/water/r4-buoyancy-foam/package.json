{
  "name": "@forgeax/water-r4-buoyancy-foam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node ../../../scripts/vite-app.mjs dev --host 127.0.0.1",
    "build": "node ../../../scripts/vite-app.mjs build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-devkit": "workspace:*",
    "@forgeax/engine-image": "workspace:*",
    "@forgeax/engine-shader-compiler": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "The generic FPS reporter samples requestAnimationFrame rather than completed Engine frames; no dedicated completed-frame FPS metric is declared for this app."
      },
      "bench": {
        "enabled": false,
        "reason": "Exported buoyancy and particle traces are diagnostics, with no registered benchmark report protocol."
      },
      "gate": {
        "enabled": false,
        "reason": "The README requires independent numerical traces and Browser/RHI evidence; this app provides no standalone acceptance script."
      },
      "spike-report": {
        "enabled": false,
        "reason": "This maintained Water demo has no spike report."
      }
    }
  },
  "description": "R4 \u00b7 Buoyancy harbor"
}
