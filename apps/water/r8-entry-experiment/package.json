{
  "name": "@forgeax/water-r8-entry-experiment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node ../../../scripts/vite-app.mjs dev --host 127.0.0.1",
    "build": "node ../../../scripts/vite-app.mjs build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-devkit": "workspace:*",
    "@forgeax/engine-image": "workspace:*",
    "@forgeax/engine-shader-compiler": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "description": "R8 · Native water entry, splash and wave feedback experiment",
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "Demo uses shared Engine chunks; no independent bundle-size budget"
      },
      "fps": {
        "enabled": true,
        "sampleCount": 4,
        "frameCount": 60
      },
      "bench": {
        "enabled": false,
        "reason": "Owner regressions and completed-frame telemetry cover this interactive demo"
      },
      "gate": {
        "enabled": false,
        "reason": "Acceptance runs through the Engine browser, Dawn and core smoke owners"
      },
      "spike-report": {
        "enabled": false,
        "reason": "Runtime demonstration; raw evidence is retained outside the checkout"
      }
    }
  }
}
