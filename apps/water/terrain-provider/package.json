{
  "name": "@forgeax/water-terrain-provider",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine": "workspace:*",
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-terrain": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-water": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-shader-compiler": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "The generic FPS reporter samples requestAnimationFrame rather than completed Engine frames; no dedicated completed-frame FPS metric is declared for this app."
      },
      "bench": {
        "enabled": false,
        "reason": "Terrain provider switching, Pack mesh draws and pixels are checked by the browser smoke, with no dedicated benchmark suite."
      },
      "gate": {
        "enabled": true,
        "command": "node scripts/smoke.mjs --output ../../../../.tmp/forgeax-water-metrics/terrain-provider",
        "cwd": "apps/water/terrain-provider"
      },
      "spike-report": {
        "enabled": false,
        "reason": "This maintained Water demo has no spike report."
      }
    }
  }
}
