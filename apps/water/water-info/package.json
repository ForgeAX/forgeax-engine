{
  "name": "@forgeax/water-info-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node ../../../scripts/vite-app.mjs dev --host 127.0.0.1",
    "build": "node ../../../scripts/vite-app.mjs build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgeax/apps-shared": "workspace:*",
    "@forgeax/engine": "workspace:*",
    "@forgeax/engine-water": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/engine-terrain": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-shader-compiler": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@forgeax/engine-vite-plugin-rhi-debug": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "The generic FPS reporter samples requestAnimationFrame rather than completed Engine frames; no dedicated completed-frame FPS metric is declared for this app."
      },
      "bench": {
        "enabled": false,
        "reason": "WaterInfo render targets and geometry are checked by the shared visual smoke, with no dedicated benchmark suite."
      },
      "gate": {
        "enabled": true,
        "command": "node ../water-mesh/scripts/visual-smoke.mjs --app info --output ../../../../.tmp/forgeax-water-metrics/water-info",
        "cwd": "apps/water/water-info"
      },
      "spike-report": {
        "enabled": false,
        "reason": "This maintained Water demo has no spike report."
      }
    }
  }
}
