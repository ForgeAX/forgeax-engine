{
  "name": "forgeax-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript game engine monorepo (math + core + engine, dual pnpm/bun pipeline).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.15.0",
  "overrides": {
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "zod": "^4.6.7"
  },
  "patchedDependencies": {
    "@deepseek-ai/cordis@4.0.4": "patches/@deepseek-ai__cordis@4.0.4.patch"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/showcase/*",
    "apps/hello/*",
    "apps/perf/*",
    "apps/bevy/*",
    "apps/shadertoy/*",
    "apps/parity/*",
    "apps/learn-render/*/*",
    "apps/learn-render/*/*/*",
    "templates/empty",
    "templates/game-3d",
    "tools/view",
    "tools/forgeax-mcp",
    "tools/view/packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:clean": "node scripts/build.mjs --clean",
    "build:engine": "node scripts/build.mjs --engine",
    "build:seed": "node scripts/seed-build-outputs.mjs",
    "build:packages": "node scripts/build.mjs --packages-only",
    "build:app": "node scripts/build-apps.mjs",
    "build:apps": "node scripts/build-apps.mjs",
    "build:shared": "node scripts/build-shared-inputs.mjs",
    "stage:desktop-runtime": "node scripts/stage-desktop-runtime.mjs",
    "skills:check": "node scripts/forgeax/check-engine-skills.mjs",
    "skills:api-index": "node scripts/forgeax/sdk-api-index.mjs",
    "test:sdk:contracts": "node --test scripts/__tests__/sdk-source-contract.test.mjs packages/wgpu-wasm/scripts/__tests__/source-key.test.mjs scripts/forgeax/__tests__/sdk-carrier.test.mjs scripts/forgeax/__tests__/sdk-source.test.mjs scripts/forgeax/__tests__/engine-bundle.test.mjs scripts/forgeax/__tests__/release-policy.test.mjs scripts/forgeax/__tests__/release-promotion.test.mjs scripts/forgeax/__tests__/sdk-view.test.mjs scripts/forgeax/__tests__/pnpm-version.test.mjs scripts/forgeax/__tests__/verify-sdk-process.test.mjs scripts/forgeax/__tests__/sdk-gpu-admission.test.mjs scripts/forgeax/__tests__/sdk-live-progress.test.mjs scripts/forgeax/__tests__/sdk-api-index.test.mjs scripts/forgeax/__tests__/sdk-project-identity.test.mjs scripts/forgeax/__tests__/sdk-template-cache.test.mjs && vitest run --config scripts/forgeax/vitest.config.mjs",
    "sdk:build": "node scripts/forgeax/build-sdk.mjs",
    "sdk:check:npm": "node scripts/forgeax/check-sdk-npm-consumer.mjs",
    "sdk:verify": "corepack pnpm exec node scripts/forgeax/verify-sdk.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -b && node node_modules/typescript/bin/tsc -p scripts/tsconfig.json && node scripts/typecheck-apps.mjs",
    "fx": "bun scripts/fx.ts",
    "test:fx": "vitest run --config scripts/vitest.fx.config.ts scripts/__tests__/fx.test.ts scripts/__tests__/worktree.test.ts scripts/__tests__/link-template-agents.test.ts",
    "check:code-file-lines": "node scripts/check-code-file-lines.mjs",
    "check:function-complexity": "node scripts/check-function-complexity.mjs",
    "check:dependency-vulnerabilities": "node scripts/ci/check-dependency-vulnerabilities.mjs",
    "test:layout": "node scripts/check-test-layout.mjs",
    "check:package-runtime-dependencies": "node scripts/forgeax/check-package-runtime-dependencies.mjs",
    "test:package-runtime-dependencies": "node --test scripts/forgeax/__tests__/check-package-runtime-dependencies.test.mjs scripts/forgeax/__tests__/workspace-dependency-names.test.mjs",
    "check:package-directory-names": "node scripts/check-package-directory-names.mjs",
    "test": "node scripts/ci/run-vitest-unit.mjs",
    "test:unit": "node scripts/ci/run-vitest-unit.mjs",
    "test:m6:extended-lighting-zero-feature": "pnpm --filter @forgeax/engine-render exec vitest run src/__tests__/extended-lighting-zero-feature.integration.test.ts --maxWorkers=1",
    "test:browser": "node scripts/ci/run-test-suite.mjs browser",
    "test:browser:watch": "vitest --project=browser",
    "test:browser:wgpu-wasm": "vitest run --project=browser packages/engine/__tests__/renderer-wgpu-wasm.browser.test.ts",
    "test:dawn": "node scripts/ci/run-test-suite.mjs dawn",
    "test:browser-no-webgpu": "vitest run --project=browser-no-webgpu",
    "test:perf": "vitest run --project=ecs-perf --project=render-perf",
    "test:portability": "vitest run --project='@forgeax/engine-math' --project='@forgeax/engine-ecs'",
    "test:all": "pnpm test:unit && pnpm test:browser && pnpm test:dawn",
    "test:watch": "vitest",
    "test:type": "node scripts/ci/run-split-vitest-coverage.mjs --non-coverage --typecheck --group-size=2 --max-workers=1 --testTimeout=90000 --hookTimeout=90000",
    "r12-lint": "node packages/rhi/scripts/r12-lint.mjs",
    "lint:grep": "node scripts/lint/grep-r12-lint.mjs && node scripts/lint/grep-error-hints.mjs && node scripts/lint/grep-pbr-ibl-callsite.mjs && node scripts/lint/grep-console-errors.mjs && node scripts/lint/grep-runtime-catalog-routing.mjs && node scripts/lint/grep-pass-kind.mjs && node scripts/lint/grep-image-kind-convergence.mjs && node scripts/grep/check-pack-schema-dist-fresh.mjs && node scripts/grep/check-csm-unique-shadow-path.mjs && node scripts/grep/check-shader-manifest-ssot.mjs && node scripts/grep/check-game-default-self-contained.mjs && node scripts/forgeax/check-render-animation-boundary.mjs && node scripts/check-public-import-examples.mjs && node scripts/check-material-contract-inventory.mjs && node scripts/forgeax/check-render-extract-single-query.mjs && node scripts/check-smoke-renderer-attachment-order.mjs && node scripts/check-test-layout.mjs",
    "check:material-contract-inventory": "node scripts/check-material-contract-inventory.mjs",
    "check:public-import-examples": "node scripts/check-public-import-examples.mjs",
    "grep:r12-lint": "node scripts/lint/grep-r12-lint.mjs",
    "grep:error-hints": "node scripts/lint/grep-error-hints.mjs",
    "grep:pbr-ibl-callsite": "node scripts/lint/grep-pbr-ibl-callsite.mjs",
    "grep:console-errors": "node scripts/lint/grep-console-errors.mjs",
    "grep:pass-kind": "node scripts/lint/grep-pass-kind.mjs",
    "grep:pack-schema-fresh": "node scripts/grep/check-pack-schema-dist-fresh.mjs",
    "lint:internal": "node scripts/lint-internal.mjs",
    "check-engine-no-console-dep": "node packages/remote/scripts/check-engine-no-console-dep.mjs",
    "check-console-not-in-engine-bundle": "node packages/remote/scripts/check-console-not-in-engine-bundle.mjs",
    "grep:single-exit": "node packages/ecs/scripts/check-single-exit.mjs",
    "grep:ecs-query-surface": "node scripts/forgeax/check-ecs-query-surface.mjs",
    "grep:asset-registry-instanced-removed": "node scripts/grep/check-asset-registry-instanced-removed.mjs",
    "grep:no-entity-array-literal": "node scripts/grep/check-no-entity-array-literal.mjs",
    "grep:readme-array-vocab-mentioned": "node scripts/grep/check-readme-array-vocab-mentioned.mjs",
    "grep:readme-string-vocab-mentioned": "node scripts/grep/check-readme-string-vocab-mentioned.mjs",
    "grep:no-managed-array-view-import": "node scripts/grep/check-no-managed-array-view-import.mjs",
    "grep:no-array-stride-option": "node scripts/grep/check-no-array-stride-option.mjs",
    "grep:no-buffer-colon-keyword": "node scripts/grep/check-no-buffer-colon-keyword.mjs",
    "grep:no-managed-array-error-code": "node scripts/grep/check-no-managed-array-error-code.mjs",
    "grep:no-result-reproject-cast": "node scripts/grep/check-no-result-reproject-cast.mjs",
    "grep:no-string-view-import": "node packages/ecs/scripts/grep-no-string-view-import.mjs",
    "grep:no-set-managed-ref-store": "node packages/ecs/scripts/grep-no-set-managed-ref-store.mjs",
    "grep:no-binary-assets": "node scripts/grep/check-no-binary-assets.mjs",
    "grep:no-shader-manifest-url-literal": "node scripts/grep/check-no-shader-manifest-url-literal.mjs",
    "grep:cluster-forward-variant-gate": "node scripts/grep/check-cluster-forward-variant-gate.mjs",
    "grep:csm-unique-shadow-path": "node scripts/grep/check-csm-unique-shadow-path.mjs",
    "lint": "node scripts/lint-biome-strict.mjs",
    "format": "biome check --write .",
    "bench:pixel-parity": "node scripts/bench/pixel-parity.mjs",
    "gpu-pass-timing:bench": "bun scripts/bench/gpu-pass-timing.mjs",
    "gpu-pass-timing:bench:browser": "FORGEAX_GPU_PASS_TIMING_HOST_MODULE=./packages/render/bench/gpu-pass-timing/browser-host.mjs bun scripts/bench/gpu-pass-timing.mjs",
    "gpu-pass-timing:auto-exposure": "node apps/hello/taa/scripts/auto-exposure-gpu-pass-timing-host.mjs",
    "gpu-pass-timing:oit": "node packages/render/bench/oit/gpu-pass-timing-host.mjs",
    "bench:color-lighting-parity": "node scripts/bench/color-lighting-parity.mjs",
    "bench:nineslice": "node scripts/bench/bench-nineslice-100panel.mjs",
    "ci:focus": "node scripts/ci/run-ci-focus.mjs",
    "ci:graphics": "node scripts/ci/local-graphics.mjs",
    "ci:channel-align": "node scripts/check-ci-channel-alignment.mjs",
    "ci:paths-sync": "node scripts/ci/sync-paths.mjs",
    "ci:paths-check": "node scripts/ci/sync-paths.mjs --check",
    "profiler:phase-catalog": "node scripts/bench/check-profiler-phase-catalog.mjs",
    "dependabot:dryrun": "node scripts/dependabot/dryrun.mjs",
    "dependabot:check-doc-anchor": "node scripts/dependabot/check-doc-anchor.mjs",
    "dup-check": "node scripts/dup-check.mjs",
    "bevy-coverage": "node scripts/bevy-coverage-audit.mjs",
    "bevy:new-demo": "node scripts/bevy-demo.mjs new",
    "bevy:validate": "node scripts/bevy-demo.mjs validate",
    "bevy:smokes": "node scripts/check-bevy-smoke-dependencies.mjs && node scripts/bevy-demo.mjs smokes",
    "gauntlet": "node scripts/gauntlet.mjs",
    "metrics:check": "node scripts/check-metrics-declared.mjs",
    "check:asset-authority-audit": "node scripts/forgeax/check-asset-authority-audit.mjs",
    "pack:authoring-audit": "node scripts/forgeax/migrate-pack-authoring.mjs --audit",
    "runtime:cutover": "node scripts/check-runtime-cutover.mjs",
    "runtime:compat": "node scripts/check-runtime-compat.mjs",
    "runtime:governance": "pnpm runtime:cutover && pnpm runtime:compat && pnpm metrics:check",
    "metrics:report": "node scripts/metrics/render-sticky.mjs",
    "metrics:run": "node scripts/metrics/run-all.mjs",
    "metrics:run-fps": "node scripts/metrics/run-fps.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/check-workspaces-equivalence.mjs",
    "build:tools": "node tools/view-plugins/integration/build.mjs",
    "test:view": "node scripts/ci/run-view-integration.mjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "@biomejs/biome": "2.4.14",
    "@fast-check/vitest": "0.3.0",
    "@forgeax/engine": "workspace:*",
    "@forgeax/engine-app": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-audio": "workspace:*",
    "@forgeax/engine-audio-webaudio": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-fbx": "workspace:*",
    "@forgeax/engine-font": "workspace:*",
    "@forgeax/engine-gltf": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-image": "workspace:*",
    "@forgeax/engine-import": "workspace:*",
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/engine-profiler": "workspace:*",
    "@forgeax/engine-rhi-null": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-shader": "workspace:*",
    "@forgeax/engine-vfx-compiler": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^20.14.0",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "^8.17.1",
    "fast-check": "4.7.0",
    "jiti": "1.21.7",
    "jscodeshift": "^17.4.0",
    "jscpd": "^4.1.1",
    "pixelmatch": "^7.0.0",
    "playwright": "^1.56.1",
    "simple-git-hooks": "2.13.1",
    "ts-morph": "^28.0.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "upng-js": "^2.1.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wait-on": "^9.5.1",
    "@forgeax/engine-dawn-node": "workspace:*",
    "ws": "^8.22.0"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-workspaces-equivalence.mjs && node scripts/check-staged-lockfiles.mjs"
  },
  "forgeax": {
    "metrics": {
      "gate": {
        "enabled": true,
        "command": "pnpm dup-check",
        "cwd": "."
      }
    }
  },
  "dependencies": {
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-scene": "workspace:*"
  }
}
