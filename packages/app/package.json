{
  "name": "@forgeax/engine-app",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Host assembly and execution tiers for ForgeaX: frame credit, input, Engine Worker, shared Kernels, reports, and rebuild.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@forgeax/engine-animation": "workspace:*",
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-audio": "workspace:*",
    "@forgeax/engine-audio-webaudio": "workspace:*",
    "@forgeax/engine-debug-draw": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-import": "workspace:*",
    "@forgeax/engine-input": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/engine-physics": "workspace:*",
    "@forgeax/engine-physics-rapier2d": "workspace:*",
    "@forgeax/engine-physics-rapier3d": "workspace:*",
    "@forgeax/engine-picking": "workspace:*",
    "@forgeax/engine-platform": "workspace:*",
    "@forgeax/engine-platform-browser": "workspace:*",
    "@forgeax/engine-plugin": "workspace:*",
    "@forgeax/engine-profiler": "workspace:*",
    "@forgeax/engine-remote": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-rhi": "workspace:*",
    "@forgeax/engine-rhi-debug": "workspace:*",
    "@forgeax/engine-rhi-webgpu": "workspace:*",
    "@forgeax/engine-rhi-wgpu": "workspace:*",
    "@forgeax/engine-runtime": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-state": "workspace:*",
    "@forgeax/engine-tool-runtime": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-rhi-null": "workspace:*",
    "@forgeax/engine-skinning": "workspace:*",
    "@webgpu/types": "^0.1.74",
    "@types/ws": "^8.5.10",
    "ws": "^8.20.0",
    "@forgeax/engine-graphics-extras": "workspace:*"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "MVP shell package; bundle-size lock deferred until API stabilises and meaningful threshold can be locked"
      },
      "fps": {
        "enabled": false,
        "reason": "library helper without bundled canvas; fps reported by hello-app and other host apps that consume createApp"
      },
      "bench": {
        "enabled": false,
        "reason": "rAF main loop is a thin orchestration layer; not a perf-critical surface for the MVP"
      },
      "gate": {
        "enabled": false,
        "reason": "no package-level binary gate; AC surface coverage runs as part of pnpm test:unit + tsc -b"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package; this is a production MVP per plan-strategy D-5 (double SSOT entry + thin wrapper)"
      }
    }
  }
}
