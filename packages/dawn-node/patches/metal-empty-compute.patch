+
+ResultOrError<id<MTLComputePipelineState>> Device::GetEmptyTimestampComputePipeline() {
+    if (mEmptyTimestampComputePipeline == nullptr) {
+        NSError* error = nullptr;
+        NSPRef<id<MTLLibrary>> library = AcquireNSPRef([GetMTLDevice()
+            newLibraryWithSource:@"kernel void dawn_empty_timestamp_compute() {}"
+                         options:nil
+                           error:&error]);
+        if (library == nullptr) {
+            return DAWN_FORMAT_INTERNAL_ERROR("Error creating empty timestamp library: %s",
+                                       error == nullptr ? "unknown" :
+                                           [error.localizedDescription UTF8String]);
+        }
+        NSPRef<id<MTLFunction>> function =
+            AcquireNSPRef([*library newFunctionWithName:@"dawn_empty_timestamp_compute"]);
+        if (function == nullptr) {
+            return DAWN_INTERNAL_ERROR("Empty timestamp compute function is unavailable");
+        }
+        mEmptyTimestampComputePipeline.Acquire(
+            [GetMTLDevice() newComputePipelineStateWithFunction:*function error:&error]);
+        if (mEmptyTimestampComputePipeline == nullptr) {
+            return DAWN_FORMAT_INTERNAL_ERROR("Error creating empty timestamp pipeline: %s",
+                                       error == nullptr ? "unknown" :
+                                           [error.localizedDescription UTF8String]);
+        }
+    }
+    return mEmptyTimestampComputePipeline.Get();
 }
 
