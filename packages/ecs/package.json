{
  "name": "@forgeax/engine-ecs",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Archetype ECS with SoA queries, shared numeric storage, QuerySpan Kernels, schedules, World health, and remote inspection.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./externalization": {
      "types": "./dist/externalization/index.d.ts",
      "import": "./dist/externalization/index.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.mjs"
    },
    "./projection": {
      "types": "./dist/projection/index.d.ts",
      "import": "./dist/projection/index.mjs"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.mjs"
    },
    "./world-read": {
      "types": "./dist/world-read.d.ts",
      "import": "./dist/world-read.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-plugin": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/index.mjs",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "library package, no runtime canvas; fps reported by apps"
      },
      "bench": {
        "enabled": false,
        "reason": "no perf-critical hot path bench in this package; bench focus stays on @forgeax/engine-math"
      },
      "gate": {
        "enabled": false,
        "reason": "no package-level binary gate; smoke gate covered by hello-triangle / hello-cube apps"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package"
      }
    }
  }
}
