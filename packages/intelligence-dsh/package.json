{
  "name": "@forgeax/engine-intelligence-dsh",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Host-side DeepSeek Harness provider for ForgeaX intelligence Activities.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.6",
    "@forgeax/engine-intelligence": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-intelligence-fake": "workspace:*",
    "@types/node": "^20.14.0"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/index.mjs",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "Host-side subprocess adapter never runs in the frame loop"
      },
      "bench": {
        "enabled": false,
        "reason": "provider latency is external and frame polling remains in engine-intelligence"
      },
      "gate": {
        "enabled": false,
        "reason": "adapter lifecycle is gated by package integration tests"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package"
      }
    }
  }
}
