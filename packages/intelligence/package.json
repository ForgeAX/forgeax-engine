{
  "name": "@forgeax/engine-intelligence",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Provider-neutral asynchronous Activity boundary for ForgeaX Engine.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@forgeax/engine-plugin": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/index.mjs",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "provider-neutral library without a canvas frame loop"
      },
      "bench": {
        "enabled": false,
        "reason": "hot-path behavior is bounded and covered by deterministic unit tests"
      },
      "gate": {
        "enabled": false,
        "reason": "contract correctness is gated by pnpm test:unit"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package"
      }
    }
  }
}
