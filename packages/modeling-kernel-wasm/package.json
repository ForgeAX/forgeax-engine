{
  "name": "@forgeax/modeling-kernel-wasm",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Zero-copy C-ABI WASM carrier for the engine-agnostic ForgeaX modeling kernel.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./wasm": "./dist/modeling_kernel.wasm",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "pkg/modeling_kernel.wasm",
    "pkg/provenance.json",
    "scripts",
    "Cargo.toml",
    "Cargo.lock",
    "build.sh",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "bash ./build.sh",
    "build": "tsup && node scripts/ensure-dist-wasm.mjs"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^6.0.0"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/modeling_kernel.wasm",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "WASM carrier library with no runtime canvas."
      },
      "bench": {
        "enabled": false,
        "reason": "WASM carrier performance is measured via end-to-end modeling kernel benchmarks."
      },
      "gate": {
        "enabled": false,
        "reason": "Verified through @forgeax/modeling-kernel unit and parity suites."
      },
      "spike-report": {
        "enabled": false,
        "reason": "Maintained WASM carrier package, not a spike report."
      }
    }
  }
}
