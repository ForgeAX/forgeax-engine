  "gaps": [
    {
      "id": "G1",
      "owner": "trimface",
      "summary": "A bore coaxial with a boss unioned on a plate: the plate cap, now a face with an outer circle and the boss circle, classifies out of its own trim.",
      "repro": "booleanSolids(booleanSolids(cylinder({ radius: 60, height: 8 }), cylinder r16 z-6..20, \"union\"), cylinder r7 z-10..30, \"difference\")",
      "outcome": "builds"
    },
    {
      "id": "G2",
      "owner": "e1 boolean",
      "summary": "Union only: a planar tool face crossing a cylinder cap plate now splits the cap along the straight section line (G2 section cap, single-loop case). Difference, intersect and multi-loop caps still fail closed (model-partial). Rib, gusset and side-port unions on a round plate build through this path.",
      "repro": "booleanSolids(cylinder({ radius: 60, height: 8 }), move(box({ size: [20, 4, 10] }), [26, 0, 5]), \"union\")",
      "outcome": "builds"
    },
    {
      "id": "G3",
      "owner": "e1 boolean",
      "summary": "A hollow ring (annulus cap) unioned over a plate: one of its circles lies neither wholly in nor out of the plate face.",
      "repro": "booleanSolids(cylinder({ radius: 60, height: 8 }), revolve({ profile: [[48,0],[60,0],[60,10],[48,10],[48,0]] }) moved to z0, \"union\")",
      "outcome": "fail-close",
      "failure": {
        "code": "model-partial",
        "expected": "a circle that is neither wholly in nor out of the planar face",
        "detail": {
          "brep": "brep-ssi-unsupported"
        }
      }
    },
    {
      "id": "G4",
      "owner": "sweep",
      "summary": "A swept (NURBS) tube has no plane/NURBS intersection in the boolean, so a stub cannot be unioned onto a plate or flange.",
      "repro": "booleanSolids(cylinder({ radius: 60, height: 8 }), sweep({ profile: polygon(6), path: quarter circle r19 at z4 }), \"union\")",
      "outcome": "fail-close",
      "failure": {
        "code": "model-partial",
        "expected": "plane or cylinder faces",
        "detail": {
          "brep": "brep-ssi-unsupported",
          "kinds": "cylinder/nurbs"
        }
      }
    },
    {
      "id": "G5",
      "owner": "trimface",
      "summary": "A boss unioned on a flange that already carries a bore: the flange cap again classifies out of its trim.",
      "repro": "booleanSolids(booleanSolids(cylinder({ radius: 50, height: 10 }), cylinder r26 bore, \"difference\"), cylinder r5 at y34 z-22..-4, \"union\")",
      "outcome": "builds"
    },
    {
      "id": "G6",
      "owner": "e1 boolean",
      "summary": "Lofted (NURBS) and swept (NURBS) faces have no NURBS/plane or NURBS/NURBS surface intersection, so flange and pipe cannot be unioned to the transition.",
      "repro": "booleanSolids(loft({ sections: [square z0, circle r22 z40], mode: \"ruled\" }), cylinder({ radius: 50, height: 10 }) at z-5, \"union\")",
      "outcome": "fail-close",
      "failure": {
        "code": "model-partial",
        "expected": "plane or cylinder faces",
        "detail": {
          "brep": "brep-ssi-unsupported",
          "kinds": "nurbs/cylinder"
        }
      }
    }
  ]
