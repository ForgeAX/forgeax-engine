  "phases": [
    {"name":"unlatch","u":[0,0.05],"joints":[],"root":false,"note":"body locks release; fenders pop out and the tail corners spread on short slides, so no panel swings along a shared seam"},
    {"name":"doors-out","u":[0.05,0.1],"joints":[],"root":false,"note":"the doors pop out once the fenders have risen clear of their hinges"},
    {"name":"open","u":[0.1,0.25],"joints":[],"root":false,"note":"doors, engine cover halves and the rear wing open clear of the body"},
    {"name":"legs","u":[0.25,0.42],"joints":["hip-l","hip-r","knee-l","knee-r","ankle-l","ankle-r","toe-l","toe-r"],"root":false,"note":"the tail splits into two legs on the cradle rails, the thighs and shins slide open and untwist; the tail corners slide back under the heels as heel plates"},
    {"name":"stand","u":[0.42,0.55],"joints":[],"root":true,"note":"the root turns from the car-form root (x 90) to upright about the hip line; rear wheels and toes carry the load"},
    {"name":"pack-a","u":[0.55,0.58],"joints":[],"root":false,"note":"the engine cover halves slide out and back, clear of the roof and the hips"},
    {"name":"pack-b","u":[0.58,0.61],"joints":[],"root":false,"note":"the engine covers flip up behind the shoulders into back fins; the pelvis beam, gearbox and rear motor flip back under the hips"},
    {"name":"pack-c","u":[0.61,0.64],"joints":[],"root":false,"note":"the pelvis group rises into the backpack; the V12 flips back under the hips into the backpack below it, clearing the leg zone; the hood halves slide back off the front trunk"},
    {"name":"head","u":[0.64,0.68],"joints":["neck","head"],"root":false,"note":"the head rises out of the front trunk, under the closed nose"},
    {"name":"wheels","u":[0.68,0.73],"joints":[],"root":false,"note":"each front wheel with its wishbones, damper and halfshaft swings 180 degrees outward on a swing arm of the forearm, from the shoulder end of the arm to the outer side of the forearm, so the elbows unfold with the wheel close in"},
    {"name":"arms-open","u":[0.73,0.77],"joints":[],"root":false,"note":"the fenders flip up over the shoulders into pauldrons about a front-back pivot at their front end, and the halfshafts release"},
    {"name":"chest","u":[0.77,0.83],"joints":[],"root":false,"note":"the bumper assembly folds 180 degrees forward and down onto the upper chest, opening the nose for the head, which stays the top of the figure; the roof front folds. The hood stays on the mech back, the car underside is the chest front"},
    {"name":"arms-out","u":[0.83,0.87],"joints":["shoulder-l","shoulder-r"],"root":false,"note":"the shoulders abduct, before the elbows unfold"},
    {"name":"arms","u":[0.87,0.95],"joints":["elbow-l","elbow-r","wrist-l","wrist-r"],"root":false,"note":"elbows and wrists unfold, carrying the front wheels on the forearms"},
    {"name":"armor","u":[0.95,1],"joints":[],"root":false,"note":"deployable armor plates of the mech form open on their own hinges and rails (S6b rig extension keys)"}
  ]
}
