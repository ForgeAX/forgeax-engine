{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ForgeAX/forgeax-engine/packages/pack/schema/pack.schema.json",
  "title": "RuntimePackV2",
  "description": "Schema for internal Runtime Pack v2 transport.",
  "$comment": "The ordinary durable consumer matrix is SCRIPTABLE_PACK_ASSET_KINDS in @forgeax/engine-pack/source. Pack kind fields remain open for registered producer extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "internal-text-package"
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable producer-owned package identity. It survives package moves; path is only a locator."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "packageId"
        ],
        "properties": {
          "packageId": {}
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/assetV2"
                },
                {
                  "type": "object",
                  "properties": {
                    "execution": {}
                  },
                  "required": [
                    "execution"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "guid36": {
      "type": "string",
      "format": "uuid"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guid",
        "kind",
        "payload",
        "refs"
      ],
      "properties": {
        "guid": {
          "$ref": "#/$defs/guid36",
          "description": "Unique GUID for this asset entry."
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Asset kind identifier, e.g. 'MaterialAsset'."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Optional display name for this asset. Add-only field for backward compatibility with old pack files that lack it."
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1,
          "description": "Producer-owned stable key used to match imported output topology."
        },
        "sourceIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Producer-declared output position; not an identity key when sourceKey is present."
        },
        "execution": {
          "type": "string",
          "enum": [
            "direct",
            "cooked"
          ],
          "description": "Explicit authoring execution mode; never inferred from package path."
        },
        "payload": {
          "type": "object",
          "description": "Serialized asset payload. Free-form object."
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guid36"
          }
        },
        "artifacts": {
          "$ref": "#/$defs/artifacts"
        }
      }
    },
    "assetV2": {
      "allOf": [
        {
          "$ref": "#/$defs/asset"
        },
        {
          "type": "object",
          "required": [
            "artifacts"
          ],
          "properties": {
            "artifacts": {
              "$ref": "#/$defs/artifacts"
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._/-]*$": {
          "$ref": "#/$defs/artifactDescriptor"
        }
      }
    },
    "artifactDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "assetCodec": {
          "$ref": "#/$defs/assetCodec"
        },
        "contentEncoding": {
          "enum": [
            "identity",
            "zstd"
          ]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        },
        "delivery": {
          "const": "stream"
        },
        "byteRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offset",
            "length",
            "bundleDigest"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "bundleDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "containerEncoding": {
              "const": "zstd"
            }
          }
        },
        "decodedRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offset",
            "length"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "byteRange"
            ],
            "properties": {
              "byteRange": {}
            }
          },
          "then": {
            "required": [
              "integrity"
            ],
            "properties": {
              "delivery": false,
              "integrity": {}
            }
          }
        },
        {
          "if": {
            "required": [
              "decodedRange"
            ],
            "properties": {
              "decodedRange": {}
            }
          },
          "then": {
            "required": [
              "contentEncoding",
              "byteRange",
              "byteLength",
              "integrity"
            ],
            "properties": {
              "contentEncoding": {
                "const": "zstd"
              },
              "delivery": false,
              "byteRange": {},
              "byteLength": {},
              "integrity": {}
            }
          }
        }
      ]
    },
    "assetCodec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "version"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "observedAt",
        "rootId"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "number"
        },
        "rootId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocking"
          ]
        },
        "message": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "enum": [
            "producer",
            "pack",
            "catalog"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "recoveryIntents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "asset",
            "package",
            "resource"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type",
        "provenance"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/subject"
        },
        "to": {
          "$ref": "#/$defs/subject"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
