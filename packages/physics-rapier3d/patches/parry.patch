+
+// A point moves at most min(angle, 2) times its COM radius under rotation.
+// Include translation over the entire interval, the narrow-phase tolerance,
+// and roundoff at the actual coordinate scale. Invalid bounds never cull.
+#[cfg(feature = "dim3")]
+fn swept_aabb(shape: &dyn Shape, motion: &NonlinearRigidMotion, start: Real, end: Real) -> Option<Aabb> {
+    let at = shape.compute_aabb(&motion.position_at_time(start));
+    let sphere = shape.compute_local_bounding_sphere();
+    let radius = sphere.radius() + (sphere.center - motion.local_center).length();
+    let dt = end - start;
+    let displacement = motion.linvel * dt;
+    let arc = (motion.angvel.length() * dt).min(2.0) * radius;
+    if dt < 0.0 || !dt.is_finite() || !radius.is_finite() || !arc.is_finite()
+        || !at.mins.is_finite() || !at.maxs.is_finite() || !displacement.is_finite() {
+        return None;
+    }
+    let scale = at.mins.abs().max(at.maxs.abs()).max(displacement.abs())
+        .max(Vector::splat(radius)).max_element().max(1.0);
+    let padding = Vector::splat(arc + crate::query::gjk::eps_tol() + scale * Real::EPSILON * 32.0);
+    let mins = at.mins + displacement.min(Vector::ZERO) - padding;
+    let maxs = at.maxs + displacement.max(Vector::ZERO) + padding;
+    if mins.is_finite() && maxs.is_finite() && mins.cmple(maxs).all() {
+        Some(Aabb::new(mins, maxs))
+    } else { None }
+}
