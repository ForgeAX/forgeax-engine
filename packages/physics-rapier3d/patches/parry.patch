+#[cfg(feature = "dim3")]
+fn is_cartesian_box(shape: &dyn Shape) -> bool {
+    let Some(hull) = shape.as_convex_polyhedron() else {
+        return false;
+    };
+    let points = hull.points();
+    if points.len() != 8 || points.iter().any(|p| !p.is_finite()) {
+        return false;
+    }
+    let mut min = points[0];
+    let mut max = points[0];
+    for p in points {
+        min = min.min(*p);
+        max = max.max(*p);
+    }
+    if min.cmplt(max).bitmask() != 7 {
+        return false;
+    }
+    let mut mask = 0u32;
+    for p in points {
+        let mut corner = 0;
+        for axis in 0..3 {
+            if p[axis] == max[axis] {
+                corner |= 1 << axis;
+            } else if p[axis] != min[axis] {
+                return false;
+            }
+        }
+        mask |= 1 << corner;
+    }
+    mask == 255
