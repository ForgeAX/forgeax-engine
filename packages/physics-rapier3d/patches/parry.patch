@@ -0,0 +1,103 @@
+#[cfg(not(feature = "std"))]
+use crate::math::ComplexField;
+use crate::math::{Pose, Real, Vector, DIM};
+use crate::query::{details, Contact};
+use crate::shape::{Capsule, Cuboid};
+
+/// Contact between a cuboid and a capsule, using segment-to-box distance.
+///
+/// For a segment point q(t), squared distance to the box is the sum of
+/// (q_i(t) - clamp(q_i(t), -h_i, h_i))^2. Between box-face crossings this is
+/// quadratic. Minimize each interval and select the global minimum. Wider
+/// intermediates preserve the active feature and its normal at small gaps.
+pub fn contact_cuboid_capsule(
+    pos12: &Pose,
+    cuboid: &Cuboid,
+    capsule: &Capsule,
+    prediction: Real,
+) -> Option<Contact> {
+    let a = pos12 * capsule.segment.a;
+    let b = pos12 * capsule.segment.b;
+    let a: [f64; DIM] = core::array::from_fn(|i| a[i] as f64);
+    let d: [f64; DIM] = core::array::from_fn(|i| b[i] as f64 - a[i]);
+    let h: [f64; DIM] = core::array::from_fn(|i| cuboid.half_extents[i] as f64);
+    let mut breaks = [0.0; 2 * DIM + 2];
+    breaks[1] = 1.0;
+    let mut count = 2;
+    for i in 0..DIM {
+        if d[i] != 0.0 {
+            for face in [-h[i], h[i]] {
+                let t = (face - a[i]) / d[i];
+                if t > 0.0 && t < 1.0 {
+                    breaks[count] = t;
+                    count += 1;
+                }
+            }
+        }
+    }
+    breaks[..count].sort_unstable_by(f64::total_cmp);
+    let point = |t: f64| -> [f64; DIM] { core::array::from_fn(|i| a[i] + d[i] * t) };
+    let clamp = |p: [f64; DIM]| -> [f64; DIM] { core::array::from_fn(|i| p[i].clamp(-h[i], h[i])) };
+    let mut best_distance = f64::INFINITY;
+    let mut best_axis = a;
+    let mut best_box = clamp(a);
+    for interval in breaks[..count].windows(2) {
+        let (lo, hi) = (interval[0], interval[1]);
+        let middle = point((lo + hi) * 0.5);
+        let mut numerator = 0.0;
+        let mut denominator = 0.0;
+        for i in 0..DIM {
+            if middle[i] < -h[i] || middle[i] > h[i] {
+                let face = middle[i].clamp(-h[i], h[i]);
+                numerator += d[i] * (a[i] - face);
+                denominator += d[i] * d[i];
+            }
+        }
+        let t = if denominator != 0.0 {
+            (-numerator / denominator).clamp(lo, hi)
+        } else {
+            lo
+        };
+        let axis_point = point(t);
+        let box_point = clamp(axis_point);
+        let distance: f64 = (0..DIM)
+            .map(|i| (axis_point[i] - box_point[i]).powi(2))
+            .sum();
+        if distance < best_distance {
+            best_distance = distance;
+            best_axis = axis_point;
+            best_box = box_point;
+        }
+    }
+    if best_distance == 0.0 {
+        // When the axis intersects the box, closest points cannot determine a
+        // penetration normal; keep the existing GJK/EPA penetration solver.
+        return details::contact_support_map_support_map(pos12, cuboid, capsule, prediction);
+    }
+    let distance = best_distance.sqrt();
+    let dist = distance as Real - capsule.radius;
+    if dist > prediction {
+        return None;
+    }
+    let mut normal1 = Vector::ZERO;
+    let mut point1 = Vector::ZERO;
+    let mut axis_point = Vector::ZERO;
+    for i in 0..DIM {
+        normal1[i] = ((best_axis[i] - best_box[i]) / distance) as Real;
+        point1[i] = best_box[i] as Real;
+        axis_point[i] = best_axis[i] as Real;
+    }
+    let point2 = pos12.inverse_transform_point(axis_point - normal1 * capsule.radius);
+    let normal2 = pos12.rotation.inverse() * -normal1;
+    Some(Contact::new(point1, point2, normal1, normal2, dist))
+}
+
+/// Symmetric capsule-cuboid contact, expressed in the original shape frames.
+pub fn contact_capsule_cuboid(
+    pos12: &Pose,
+    capsule: &Capsule,
+    cuboid: &Cuboid,
+    prediction: Real,
+) -> Option<Contact> {
+    contact_cuboid_capsule(&pos12.inverse(), cuboid, capsule, prediction).map(Contact::flipped)
+}
