+use parry3d::math::{Pose, Vector};
+use parry3d::query::{self, ShapeCastOptions};
+use parry3d::shape::{Capsule, Cuboid};
+
+#[test]
+fn downward_capsule_cast_respects_ground_clearance_near_target_margin() {
+    let ground = Cuboid::new(Vector::new(12.0, 0.5, 12.0));
+    let capsule = Capsule::new_y(0.55, 0.38);
+    let capsule_pose = Pose::translation(-4.8253173828125, 1.4600999355316162, -4.826419830322266);
+    for target_distance in [0.0, 0.015, 0.029999, 0.03, 0.030001] {
+        let hit = query::cast_shapes(
+            &Pose::IDENTITY,
+            Vector::ZERO,
+            &ground,
+            &capsule_pose,
+            -Vector::Y,
+            &capsule,
+            ShapeCastOptions {
+                target_distance,
+                max_time_of_impact: 0.24,
+                stop_at_penetration: false,
+                compute_impact_geometry_on_penetration: true,
+            },
+        )
+        .unwrap()
+        .expect("a downward cast over the cuboid should hit its top face");
+        let expected = 1.4600999355316162_f32 - (0.5 + 0.55 + 0.38) - target_distance;
+        println!(
+            "target={target_distance} toi={} normal={:?}",
+            hit.time_of_impact, hit.normal1
+        );
+        assert!(
+            (hit.time_of_impact - expected).abs() < 0.001,
+            "target {target_distance}: got {}, expected {expected}",
+            hit.time_of_impact
+        );
+        assert!(hit.normal1.y > 0.99, "ground top face normal is upward");
+    }
+}
+
+#[test]
+fn margin_cast_accuracy_scales_with_geometry_and_velocity() {
+    for scale in [0.1, 1.0, 10.0] {
+        let ground = Cuboid::new(Vector::new(12.0, 0.5, 12.0) * scale);
+        let capsule = Capsule::new_y(0.55 * scale, 0.38 * scale);
+        for lateral_shift in [-0.001, 0.0, 0.001] {
+            let pose = Pose::translation(
+                (-4.8253174 + lateral_shift) * scale,
+                1.4600999 * scale,
+                -4.82642 * scale,
+            );
+            for speed in [0.01, 1.0, 100.0] {
+                for margin in [0.015, 0.029999, 0.03, 0.030001] {
+                    let hit = query::cast_shapes(
+                        &Pose::IDENTITY,
+                        Vector::ZERO,
+                        &ground,
+                        &pose,
+                        -Vector::Y * speed * scale,
+                        &capsule,
+                        ShapeCastOptions {
+                            target_distance: margin * scale,
+                            max_time_of_impact: 0.24 / speed,
+                            stop_at_penetration: false,
+                            compute_impact_geometry_on_penetration: true,
+                        },
+                    )
+                    .unwrap()
+                    .unwrap();
+                    let expected = 1.4600999 - (0.5 + 0.55 + 0.38) - margin;
+                    assert!(
+                        (hit.time_of_impact * speed - expected).abs() < 0.001,
+                        "scale={scale} speed={speed} margin={margin}: {hit:?}"
+                    );
+                }
+            }
+        }
+    }
+}
