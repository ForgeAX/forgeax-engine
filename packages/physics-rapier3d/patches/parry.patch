new file mode 100644
index 0000000..53c4013
--- /dev/null
+++ b/src/shape/heightfield_samples.rs
@@ -0,0 +1,192 @@
+use crate::math::Real;
+use crate::utils::Array2;
+use alloc::{boxed::Box, sync::Arc, vec::Vec};
+
+const EDGE: usize = 32;
+const BLOCK: usize = EDGE * EDGE;
+const FANOUT: usize = 32;
+
+#[cfg_attr(feature = "serde", derive(Serialize, Deserialize))]
+#[derive(Debug, Clone)]
+enum Node {
+    Leaf(Box<[Real]>),
+    Branch(Box<[Arc<Node>]>),
+}
+
+/// Immutable spatial sample tree with column-major public indices. Clones and scales retain its root;
+/// regional writes copy only touched sample blocks and their ancestor paths.
+#[cfg_attr(feature = "serde", derive(Serialize, Deserialize))]
+#[derive(Debug, Clone)]
+pub struct HeightFieldSamples {
+    nrows: usize,
+    ncols: usize,
+    capacity: usize,
+    root: Arc<Node>,
+}
+
+impl HeightFieldSamples {
+    pub(crate) fn new(array: Array2<Real>) -> Self {
+        fn build(array: &Array2<Real>, first: usize, capacity: usize, count: usize) -> Arc<Node> {
+            if capacity == BLOCK {
+                let tile_rows = array.nrows().div_ceil(EDGE);
+                let row = first % tile_rows * EDGE;
+                let column = first / tile_rows * EDGE;
+                let rows = EDGE.min(array.nrows() - row);
+                let columns = EDGE.min(array.ncols() - column);
+                let mut block = alloc::vec![0.0; rows * columns];
+                for j in 0..columns {
+                    for i in 0..rows {
+                        block[i + j * rows] = array[(row + i, column + j)];
+                    }
+                }
+                return Arc::new(Node::Leaf(block.into()));
+            }
+            let child_blocks = capacity / FANOUT / BLOCK;
+            Arc::new(Node::Branch(
+                (0..count.div_ceil(child_blocks))
+                    .map(|child| {
+                        build(
+                            array,
+                            first + child * child_blocks,
+                            capacity / FANOUT,
+                            child_blocks.min(count - child * child_blocks),
+                        )
+                    })
+                    .collect(),
+            ))
+        }
+        let count = array.nrows().div_ceil(EDGE) * array.ncols().div_ceil(EDGE);
+        let mut capacity = BLOCK;
+        while capacity < count * BLOCK {
+            capacity *= FANOUT;
+        }
+        Self {
+            nrows: array.nrows(),
+            ncols: array.ncols(),
+            capacity,
+            root: build(&array, 0, capacity, count),
+        }
+    }
+
+    /// Row count of the original column-major sample matrix.
+    pub fn nrows(&self) -> usize {
+        self.nrows
+    }
+    /// Column count of the original column-major sample matrix.
+    pub fn ncols(&self) -> usize {
+        self.ncols
+    }
+
+    pub(crate) fn heap_bytes(&self) -> usize {
+        let len = self.nrows.div_ceil(EDGE) * self.ncols.div_ceil(EDGE) * BLOCK;
+        let mut bytes = self.nrows * self.ncols * size_of::<Real>();
+        let mut capacity = BLOCK;
+        loop {
+            let count = len.div_ceil(capacity);
+            bytes += count * (size_of::<Node>() + 2 * size_of::<usize>());
+            if capacity == self.capacity {
+                break;
+            }
+            bytes += count * size_of::<Arc<Node>>();
+            capacity *= FANOUT;
+        }
+        bytes
+    }
+
+    #[inline]
+    fn block(&self, index: usize) -> &[Real] {
+        let mut node = self.root.as_ref();
+        let mut shift = self.capacity.trailing_zeros();
+        loop {
+            match node {
+                Node::Leaf(data) => return data,
+                Node::Branch(children) => {
+                    shift -= FANOUT.trailing_zeros();
+                    node = &children[(index >> shift) & (FANOUT - 1)];
+                }
+            }
+        }
+    }
+
+    #[inline]
+    fn address(&self, row: usize, column: usize) -> usize {
+        let block = row / EDGE + (column / EDGE) * self.nrows.div_ceil(EDGE);
+        block * BLOCK + row % EDGE + (column % EDGE) * EDGE.min(self.nrows - row / EDGE * EDGE)
+    }
+
+    /// Four cell samples share one spatial block in 94% of interior cells.
+    #[inline]
+    pub(crate) fn cell(&self, row: usize, column: usize) -> [Real; 4] {
+        if row % EDGE != EDGE - 1 && column % EDGE != EDGE - 1 {
+            let address = self.address(row, column);
+            let block = self.block(address);
+            let offset = address % BLOCK;
+            let stride = EDGE.min(self.nrows - row / EDGE * EDGE);
+            return [
+                block[offset],
+                block[offset + 1],
+                block[offset + stride],
+                block[offset + stride + 1],
+            ];
+        }
+        [
+            self[(row, column)],
+            self[(row + 1, column)],
+            self[(row, column + 1)],
+            self[(row + 1, column + 1)],
+        ]
+    }
+
+    /// Explicit column-major export, never used by contact or regional update paths.
+    pub fn to_vec(&self) -> Vec<Real> {
+        (0..self.ncols)
+            .flat_map(|column| (0..self.nrows).map(move |row| self[(row, column)]))
+            .collect()
+    }
+
+    pub(crate) fn write(&mut self, indices: &[u32], values: &[Real]) -> bool {
+        if indices.len() != values.len()
+            || indices
+                .iter()
+                .any(|i| *i as usize >= self.nrows * self.ncols)
+            || values.iter().any(|value| !value.is_finite())
+        {
+            return false;
+        }
+        fn set(node: &mut Arc<Node>, shift: u32, index: usize, value: Real) {
+            match Arc::make_mut(node) {
+                Node::Leaf(data) => data[index & (BLOCK - 1)] = value,
+                Node::Branch(children) => {
+                    let shift = shift - FANOUT.trailing_zeros();
+                    set(
+                        &mut children[(index >> shift) & (FANOUT - 1)],
+                        shift,
+                        index,
+                        value,
+                    );
+                }
+            }
+        }
+        for (&index, &value) in indices.iter().zip(values) {
+            let index = index as usize;
+            let address = self.address(index % self.nrows, index / self.nrows);
+            set(
+                &mut self.root,
+                self.capacity.trailing_zeros(),
+                address,
+                value,
+            );
+        }
+        true
+    }
+}
+
+impl core::ops::Index<(usize, usize)> for HeightFieldSamples {
+    type Output = Real;
+    #[inline]
+    fn index(&self, (row, column): (usize, usize)) -> &Real {
+        assert!(row < self.nrows && column < self.ncols);
+        let address = self.address(row, column);
+        &self.block(address)[address % BLOCK]
+    }
+}
