+use parry3d::math::Vector;
+use parry3d::query::{PointQuery, PointQueryWithLocation};
+use parry3d::shape::{Segment, Triangle};
+
+#[test]
+fn face_projection_on_a_thin_triangle_is_no_farther_than_its_edges() {
+    let triangle = Triangle::new(
+        Vector::new(-7.1746826, -0.00009995699, -7.17358),
+        Vector::new(16.830624, -0.00013744831, 16.82804),
+        Vector::new(16.828835, -0.00011879206, 16.828178),
+    );
+    let point = Vector::ZERO;
+    let projection = triangle
+        .project_local_point_and_get_location(point, true)
+        .0
+        .point;
+    for (a, b) in [
+        (triangle.a, triangle.b),
+        (triangle.b, triangle.c),
+        (triangle.c, triangle.a),
+    ] {
+        let edge_projection = Segment::new(a, b).project_local_point(point, true).point;
+        assert!(
+            projection.length() <= edge_projection.length() + 1.0e-6,
+            "triangle projection {projection:?} is farther away than edge projection {edge_projection:?}"
+        );
+    }
+}
