+    capsule: &crate::shape::Capsule,
+    cuboid: &crate::shape::Cuboid,
+    options: ShapeCastOptions,
+) -> Option<ShapeCastHit> {
+    let Some(contact) = details::contact_capsule_cuboid(pos12, capsule, cuboid, Real::MAX) else {
+        return cast_shapes_support_map_support_map(pos12, vel12, capsule, cuboid, options);
