+++ b/crates/parry3d/tests/affine_bvh.rs
@@ -0,0 +1,167 @@
+use parry3d::{
+    bounding_volume::{Aabb, BoundingVolume},
+    math::Vector,
+    partitioning::{AffineBvh, AffineTransform},
+};
+
+fn transform(x: f32) -> AffineTransform {
+    AffineTransform {
+        rows: [Vector::X, Vector::Y, Vector::Z],
+        translation: Vector::new(x, 0.0, 0.0),
+    }
+}
+
+#[test]
+fn geometry_growth_changes_queries_without_updating_instances() {
+    let before = Aabb::new(Vector::splat(-0.5), Vector::splat(0.5));
+    let after = Aabb::new(Vector::splat(-2.0), Vector::splat(2.0));
+    let mut tree = AffineBvh::new();
+    for id in 0..32768 {
+        tree.insert(id, transform(id as f32 * 10.0), &before);
+    }
+    let query = Aabb::new(Vector::new(1.0, -0.1, -0.1), Vector::new(1.5, 0.1, 0.1));
+    assert_eq!(
+        tree.query(before, |bounds| bounds.intersects(&query))
+            .count(),
+        0
+    );
+    let mut hits = tree.query(after, |bounds| bounds.intersects(&query));
+    assert_eq!(hits.by_ref().collect::<Vec<_>>(), vec![0]);
+    assert!(
+        hits.visited_nodes() < 80,
+        "visited {} nodes",
+        hits.visited_nodes()
+    );
+    let far = Aabb::new(Vector::splat(-1000.0), Vector::splat(-900.0));
+    let mut miss = tree.query(after, |bounds| bounds.intersects(&far));
+    assert_eq!(miss.next(), None);
+    assert_eq!(miss.visited_nodes(), 1);
+    assert_eq!(tree.len(), 32768);
+    assert!(
+        tree.bounds(&after)
+            .unwrap()
+            .contains(&tree.bounds(&before).unwrap())
+    );
+}
+
+#[test]
+fn arbitrary_affine_bounds_keep_every_transformed_corner_after_edits() {
+    let mut seed = 0x91743821_u32;
+    let mut random = || {
+        seed ^= seed << 13;
+        seed ^= seed >> 17;
+        seed ^= seed << 5;
+        (seed as f64 / u32::MAX as f64 * 20.0 - 10.0) as f32
+    };
+    let mut tree = AffineBvh::new();
+    let initial = Aabb::new(Vector::splat(-1.0), Vector::splat(1.0));
+    let mut instances = Vec::new();
+    for id in 0..2048 {
+        let affine = AffineTransform {
+            rows: core::array::from_fn(|_| Vector::new(random(), random(), random())),
+            translation: Vector::new(random() * 100.0, random() * 100.0, random() * 100.0),
+        };
+        tree.insert(id, affine, &initial);
+        instances.push(affine);
+    }
+    for edit in 0..12 {
+        let low = Vector::new(random(), random(), random());
+        let high = Vector::new(random(), random(), random());
+        let local = Aabb::new(low.min(high), low.max(high));
+        let root = tree.bounds(&local).unwrap();
+        for (id, instance) in instances.iter().enumerate() {
+            if id % 7 == 0 && edit > 0 {
+                continue;
+            }
+            for corner in 0..8 {
+                let point = Vector::new(
+                    if corner & 1 == 0 {
+                        local.mins.x
+                    } else {
+                        local.maxs.x
+                    },
+                    if corner & 2 == 0 {
+                        local.mins.y
+                    } else {
+                        local.maxs.y
+                    },
+                    if corner & 4 == 0 {
+                        local.mins.z
+                    } else {
+                        local.maxs.z
+                    },
+                );
+                let transformed = Vector::new(
+                    instance.rows[0].dot(point),
+                    instance.rows[1].dot(point),
+                    instance.rows[2].dot(point),
+                ) + instance.translation;
+                let point_bounds = Aabb::new(transformed, transformed);
+                assert!(root.contains(&point_bounds));
+                assert!(
+                    tree.query(local, |aabb| aabb.intersects(&point_bounds))
+                        .any(|hit| hit as usize == id)
+                );
+            }
+        }
+        if edit == 0 {
+            for id in (0..2048).step_by(7) {
+                assert!(tree.remove(id));
+            }
+        }
+    }
+}
+
+#[test]
+fn nearest_leaf_prunes_far_instances_and_pair_queries_omit_self_pairs() {
+    use parry3d::query::PointQuery;
+    use std::cell::Cell;
+    let local = Aabb::new(Vector::splat(-0.5), Vector::splat(0.5));
+    let mut left = AffineBvh::new();
+    let mut right = AffineBvh::new();
+    for id in 0..4096 {
+        left.insert(id, transform(id as f32 * 10.0), &local);
+        right.insert(id + 4096, transform(id as f32 * 10.0 + 2.0), &local);
+    }
+    let visits = Cell::new(0);
+    let best = left.find_best(
+        &local,
+        f32::MAX,
+        |bounds, _| {
+            visits.set(visits.get() + 1);
+            bounds.distance_to_local_point(Vector::new(1.0, 0.0, 0.0), true)
+        },
+        |id, _| Some(((id as f32 * 10.0 - 1.0).abs() - 0.5, id)),
+    );
+    assert_eq!(best, Some((0, (0.5, 0))));
+    assert!(visits.get() < 80, "{} bound visits", visits.get());
+    assert_eq!(left.intersections(local, &left, local).count(), 0);
+    assert_eq!(left.intersections(local, &right, local).count(), 0);
+    let grown = Aabb::new(Vector::splat(-2.0), Vector::splat(2.0));
+    let mut pairs = left.intersections(grown, &right, local).collect::<Vec<_>>();
+    pairs.sort_unstable();
+    assert_eq!(
+        pairs,
+        (0..4096).map(|id| (id, id + 4096)).collect::<Vec<_>>()
+    );
+    assert!(left.remove(17));
+    assert!(!left.query(grown, |_| true).any(|id| id == 17));
+}
+
+#[test]
+fn native_role_selection_prunes_unselected_instance_subtrees() {
+    let local = Aabb::new(Vector::splat(-0.5), Vector::splat(0.5));
+    let mut tree = AffineBvh::new();
+    for id in 0..32768 {
+        let affine = transform(id as f32 * 10.0);
+        tree.insert_motion_with_mask(id, affine, affine, 0.0, &local, u32::from(id == 1234));
+    }
+    let mut selected = tree.matching_leaves(1);
+    assert_eq!(selected.by_ref().collect::<Vec<_>>(), vec![1234]);
+    assert!(selected.visited_nodes() < 80, "{} role nodes visited", selected.visited_nodes());
+    let affine = transform(12340.0);
+    tree.insert_motion_with_mask(1234, affine, affine, 0.0, &local, 0);
+    let mut none = tree.matching_leaves(1);
+    assert_eq!(none.next(), None);
+    assert_eq!(none.visited_nodes(), 1);
+}
