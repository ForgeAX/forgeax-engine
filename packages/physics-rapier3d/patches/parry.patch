@@ -0,0 +1,95 @@
+use parry3d::math::{Pose, Vector};
+use parry3d::query::{self, ShapeCastOptions};
+use parry3d::shape::{Capsule, Cuboid};
+
+#[test]
+fn a_cast_parallel_to_a_face_does_not_report_a_zero_time_obstruction() {
+    for (wall_y, half_height, pose) in [
+        (1.25, 0.75, Vector::new(-1.2755274, 2.46, 1.9099997)),
+        (1.5, 1.0, Vector::new(-0.505131, 2.9598898, 0.90999997)),
+    ] {
+        let wall = Cuboid::new(Vector::new(1.5, half_height, 0.5));
+        let wall_pose = Pose::translation(-1.0, wall_y, if wall_y == 1.25 { 1.0 } else { 0.0 });
+        let capsule = Capsule::new_y(0.55, 0.38);
+        let capsule_pose = Pose::from_translation(pose);
+        for speed in [0.01, 1.0, 100.0] {
+            let options = ShapeCastOptions {
+                target_distance: 0.03,
+                max_time_of_impact: 0.53 / speed,
+                stop_at_penetration: false,
+                compute_impact_geometry_on_penetration: true,
+            };
+            let parallel = query::cast_shapes(
+                &wall_pose,
+                Vector::ZERO,
+                &wall,
+                &capsule_pose,
+                Vector::Y * speed,
+                &capsule,
+                options,
+            )
+            .unwrap();
+            assert!(
+                parallel.is_none(),
+                "parallel speed={speed} produced {parallel:?}"
+            );
+            let approaching = query::cast_shapes(
+                &wall_pose,
+                Vector::ZERO,
+                &wall,
+                &capsule_pose,
+                (Vector::Y - Vector::Z * 0.01) * speed,
+                &capsule,
+                options,
+            )
+            .unwrap();
+            assert!(
+                approaching.is_some(),
+                "a direction approaching the face must remain blocked"
+            );
+        }
+    }
+}
+
+#[test]
+fn every_face_tangent_preserves_small_real_approaches() {
+    let cuboid = Cuboid::new(Vector::new(1.5, 0.75, 0.5));
+    let capsule = Capsule::new_y(0.55, 0.38);
+    let wall = Pose::translation(-1.0, 1.25, 1.0);
+    let pose = Pose::translation(-1.2755274, 2.46, 1.9099997);
+    for tangent in [
+        Vector::X,
+        -Vector::X,
+        Vector::Y,
+        -Vector::Y,
+        Vector::X + Vector::Y,
+    ] {
+        for speed in [0.01, 1.0, 100.0] {
+            for approach in [0.0, 0.00001, 0.0001, 0.001, 0.01] {
+                let vel = (tangent - Vector::Z * approach) * speed;
+                let options = ShapeCastOptions {
+                    target_distance: 0.03,
+                    max_time_of_impact: 0.53 / speed,
+                    stop_at_penetration: false,
+                    compute_impact_geometry_on_penetration: true,
+                };
+                let forward =
+                    query::cast_shapes(&wall, Vector::ZERO, &cuboid, &pose, vel, &capsule, options)
+                        .unwrap();
+                let reverse =
+                    query::cast_shapes(&pose, vel, &capsule, &wall, Vector::ZERO, &cuboid, options)
+                        .unwrap();
+                assert_eq!(
+                    forward.is_some(),
+                    approach > 0.0,
+                    "tangent={tangent:?} speed={speed} approach={approach} hit={forward:?}"
+                );
+                assert_eq!(
+                    reverse.is_some(),
+                    forward.is_some(),
+                    "shape-order symmetry failed"
+                );
+            }
+        }
+    }
+}
diff --git a/crates/parry3d/tests/manifold_transfer.rs b/crates/parry3d/tests/manifold_transfer.rs
new file mode 100644
index 0000000..f149723
--- /dev/null
+++ b/crates/parry3d/tests/manifold_transfer.rs
@@ -0,0 +1,145 @@
+use parry3d::math::{IVector, Pose, Vector};
+use parry3d::query::{ContactManifold, DefaultQueryDispatcher, PersistentQueryDispatcher};
+use parry3d::shape::{Capsule, Compound, HeightField, Shape, SharedShape, Voxels};
+use parry3d::utils::Array2;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+static CLONES: AtomicUsize = AtomicUsize::new(0);
+#[derive(Default)]
+struct Payload(Vec<u32>);
+impl Clone for Payload {
+    fn clone(&self) -> Self {
+        CLONES.fetch_add(1, Ordering::Relaxed);
+        Self(self.0.clone())
+    }
+}
+
+fn exercise(a: &dyn Shape, b: &dyn Shape, pose: Pose) {
+    let mut manifolds: Vec<ContactManifold<Payload, u32>> = Vec::new();
+    let mut workspace = None;
+    DefaultQueryDispatcher
+        .contact_manifolds(&pose, a, b, 0.1, &mut manifolds, &mut workspace)
+        .unwrap();
+    assert!(
+        manifolds.iter().any(|m| !m.points.is_empty()),
+        "must exercise real contacts"
+    );
+    for (i, manifold) in manifolds.iter_mut().enumerate() {
+        manifold.data.0 = vec![i as u32 + 1; 32];
+        for p in &mut manifold.points {
+            p.data = 77;
+        }
+    }
+    let original: Vec<_> = manifolds
+        .iter()
+        .map(|m| {
+            (
+                m.subshape1,
+                m.subshape2,
+                m.data.0.clone(),
+                m.subshape_poses.as_ref().map(|p| &**p as *const _),
+            )
+        })
+        .collect();
+    let before = CLONES.load(Ordering::Relaxed);
+    DefaultQueryDispatcher
+        .contact_manifolds(&pose, a, b, 0.1, &mut manifolds, &mut workspace)
+        .unwrap();
+    assert_eq!(
+        CLONES.load(Ordering::Relaxed),
+        before,
+        "reusing an owned manifold must not clone its payload"
+    );
+    assert_eq!(manifolds.len(), original.len());
+    for (manifold, (s1, s2, payload, allocation)) in manifolds.iter().zip(original) {
+        assert_eq!((manifold.subshape1, manifold.subshape2), (s1, s2));
+        assert_eq!(manifold.data.0, payload);
+        assert_eq!(
+            manifold.subshape_poses.as_ref().map(|p| &**p as *const _),
+            allocation
+        );
+        assert!(manifold.points.iter().all(|p| p.data == 77));
+    }
+    DefaultQueryDispatcher
+        .contact_manifolds(
+            &Pose::translation(100.0, 100.0, 100.0),
+            a,
+            b,
+            0.1,
+            &mut manifolds,
+            &mut workspace,
+        )
+        .unwrap();
+    assert!(manifolds.is_empty());
+    DefaultQueryDispatcher
+        .contact_manifolds(&pose, a, b, 0.1, &mut manifolds, &mut workspace)
+        .unwrap();
+    assert!(manifolds.iter().any(|m| !m.points.is_empty()));
+    assert!(
+        manifolds.iter().all(|m| m.data.0.is_empty()),
+        "retired contacts must not retain custom data"
+    );
+}
+
+#[test]
+fn transfers_contact_ownership_without_payload_or_pose_copies() {
+    let coords: Vec<_> = (0..8)
+        .flat_map(|x| (0..8).map(move |z| IVector::new(x, 0, z)))
+        .collect();
+    let floor = Voxels::new(Vector::ONE, &coords);
+    let capsule = Capsule::new_y(0.3, 0.2);
+    let compound = Compound::new(vec![
+        (
+            Pose::translation(-0.4, 0.0, 0.0),
+            SharedShape::cuboid(0.3, 0.4, 0.3),
+        ),
+        (
+            Pose::translation(0.4, 0.0, 0.0),
+            SharedShape::cuboid(0.3, 0.4, 0.3),
+        ),
+    ]);
+    let other_voxels = Voxels::new(
+        Vector::splat(0.5),
+        &[IVector::new(0, 0, 0), IVector::new(1, 0, 0)],
+    );
+    for flipped in [false, true] {
+        for (shape, y) in [
+            (&capsule as &dyn Shape, 1.45),
+            (&compound, 1.3),
+            (&other_voxels, 0.9),
+        ] {
+            let pose = Pose::translation(3.0, y, 3.0);
+            if flipped {
+                exercise(shape, &floor, pose.inverse());
+            } else {
+                exercise(&floor, shape, pose);
+            }
+        }
+    }
+    let terrain = Compound::new(vec![
+        (
+            Pose::translation(-2.0, 0.0, 0.0),
+            SharedShape::cuboid(2.0, 0.5, 4.0),
+        ),
+        (
+            Pose::translation(2.0, 0.0, 0.0),
+            SharedShape::cuboid(2.0, 0.5, 4.0),
+        ),
+    ]);
+    let heightfield = HeightField::new(
+        Array2::new(3, 3, vec![0.0; 9]),
+        Vector::new(10.0, 1.0, 10.0),
+    );
+    for flipped in [false, true] {
+        for (floor, top) in [(&terrain as &dyn Shape, 0.5), (&heightfield, 0.0)] {
+            for (shape, height) in [(&capsule as &dyn Shape, 0.5), (&compound, 0.4)] {
+                let pose = Pose::translation(0.0, top + height - 0.05, 0.0);
+                if flipped {
+                    exercise(shape, floor, pose.inverse());
+                } else {
+                    exercise(floor, shape, pose);
+                }
+            }
+        }
+    }
+}
diff --git a/crates/parry3d/tests/temporal_voxel_rotation.rs b/crates/parry3d/tests/temporal_voxel_rotation.rs
