+use parry3d::math::{IVector, Pose, Rotation, Vector};
+use parry3d::query::{cast_shapes_nonlinear, NonlinearRigidMotion};
+use parry3d::shape::{Cuboid, Shape, Voxels};
+
+fn compare_exhaustive(grid_motion: NonlinearRigidMotion, motion: NonlinearRigidMotion, shape: &dyn Shape, start: f32, end: f32) -> bool {
+    let voxels=Voxels::from_regions(Vector::splat(0.1), &[[IVector::new(-8,-2,0),IVector::new(9,3,1)]]);
+    let cube=Cuboid::new(Vector::splat(0.05));
+    let mut earliest=None::<f32>;
+    for voxel in voxels.voxels().filter(|voxel|!voxel.state.is_empty()) {
+        let center=voxels.voxel_center(voxel.grid_coords);
+        if let Some(hit)=cast_shapes_nonlinear(&grid_motion.prepend_translation(center),&cube,&motion,shape,start,end,true).unwrap() {
+            if hit.time_of_impact<earliest.unwrap_or(end) {earliest=Some(hit.time_of_impact);}
+        }
+    }
+    let actual=cast_shapes_nonlinear(&grid_motion,&voxels,&motion,shape,start,end,true).unwrap().map(|hit|hit.time_of_impact);
+    assert_eq!(actual.is_some(),earliest.is_some(),"actual={actual:?} reference={earliest:?} start={start} end={end} motion={motion:?}");
+    if let (Some(actual),Some(expected))=(actual,earliest) {assert!((actual-expected).abs()<=0.00003,"actual={actual} expected={expected}");}
+    actual.is_some()
+}
+
+#[test]
+fn temporal_voxel_bounds_match_all_occupied_cells_with_eccentric_motion() {
+    let shape=Cuboid::new(Vector::new(0.04,0.6,0.03));
+    let mut hits=0;let mut misses=0;
+    for grid_angle in [0.0,0.37] {for speed in [0.000001,-2.0,20.0,-20.0] {for start in [0.0,0.002,0.125] {for eccentric in [0.0,3.0] {
+        let rotation=Rotation::from_rotation_y(grid_angle);
+        let grid=NonlinearRigidMotion::constant_position(Pose::from_parts(Vector::new(-2.0,1.0,3.0),rotation));
+        let initial=Pose::from_parts(Vector::new(-2.0,1.0,3.0)+rotation*Vector::new(0.0,0.0,-0.3),rotation);
+        let motion=NonlinearRigidMotion::new(initial,Vector::new(eccentric,0.0,0.0),rotation*Vector::new(0.0,0.0,20.0),Vector::Y*speed);
+        if compare_exhaustive(grid,motion,&shape,start,start+1.0/60.0){hits+=1}else{misses+=1}
+    }}}}
+    assert!(hits>0&&misses>0,"test must include both actual hits and separated trajectories");
+}
