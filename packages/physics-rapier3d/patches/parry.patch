@@ -0,0 +1,191 @@
+use parry3d::math::{IVector, Pose, Real, Rotation, Vector};
+use parry3d::query::{
+    details::cast_shapes_nonlinear_voxels_shape, ClosestPoints, Contact, DefaultQueryDispatcher,
+    NonlinearRigidMotion, QueryDispatcher, ShapeCastHit, ShapeCastOptions, Unsupported,
+};
+use parry3d::shape::{Ball, Cuboid, Shape, Voxels};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+#[derive(Default)]
+struct Counting(AtomicUsize);
+impl QueryDispatcher for Counting {
+    fn intersection_test(
+        &self,
+        p: &Pose,
+        a: &dyn Shape,
+        b: &dyn Shape,
+    ) -> Result<bool, Unsupported> {
+        DefaultQueryDispatcher.intersection_test(p, a, b)
+    }
+    fn distance(&self, p: &Pose, a: &dyn Shape, b: &dyn Shape) -> Result<Real, Unsupported> {
+        DefaultQueryDispatcher.distance(p, a, b)
+    }
+    fn contact(
+        &self,
+        p: &Pose,
+        a: &dyn Shape,
+        b: &dyn Shape,
+        d: Real,
+    ) -> Result<Option<Contact>, Unsupported> {
+        DefaultQueryDispatcher.contact(p, a, b, d)
+    }
+    fn closest_points(
+        &self,
+        p: &Pose,
+        a: &dyn Shape,
+        b: &dyn Shape,
+        d: Real,
+    ) -> Result<ClosestPoints, Unsupported> {
+        DefaultQueryDispatcher.closest_points(p, a, b, d)
+    }
+    fn cast_shapes(
+        &self,
+        p: &Pose,
+        v: Vector,
+        a: &dyn Shape,
+        b: &dyn Shape,
+        o: ShapeCastOptions,
+    ) -> Result<Option<ShapeCastHit>, Unsupported> {
+        DefaultQueryDispatcher.cast_shapes(p, v, a, b, o)
+    }
+    fn cast_shapes_nonlinear(
+        &self,
+        m: &NonlinearRigidMotion,
+        a: &dyn Shape,
+        n: &NonlinearRigidMotion,
+        b: &dyn Shape,
+        s: Real,
+        e: Real,
+        stop: bool,
+    ) -> Result<Option<ShapeCastHit>, Unsupported> {
+        self.0.fetch_add(1, Ordering::Relaxed);
+        DefaultQueryDispatcher.cast_shapes_nonlinear(m, a, n, b, s, e, stop)
+    }
+}
+
+#[test]
+fn a_separated_rotating_grid_does_not_dispatch_each_occupied_cell() {
+    let voxels = Voxels::from_regions(Vector::splat(0.1), &[[IVector::ZERO, IVector::splat(8)]]);
+    let grid =
+        NonlinearRigidMotion::new(Pose::IDENTITY, Vector::splat(0.4), Vector::ZERO, Vector::Y);
+    let other = NonlinearRigidMotion::constant_position(Pose::translation(4.0, 0.0, 0.0));
+    let count = Counting::default();
+    assert!(cast_shapes_nonlinear_voxels_shape(
+        &count,
+        &grid,
+        &voxels,
+        &other,
+        &Cuboid::new(Vector::splat(0.1)),
+        0.0,
+        0.05,
+        false
+    )
+    .is_none());
+    assert_eq!(count.0.load(Ordering::Relaxed), 0);
+}
+
+// Independent exhaustive occupied-cell reference retains the original motion,
+// iteration order, narrowing horizon and witness transform.
+fn unpruned(
+    v: &Voxels,
+    m: &NonlinearRigidMotion,
+    s: &dyn Shape,
+    n: &NonlinearRigidMotion,
+    start: Real,
+    end: Real,
+    stop: bool,
+) -> Option<ShapeCastHit> {
+    let cube = Cuboid::new(v.voxel_size() / 2.0);
+    let mut result = None;
+    let mut earliest = end;
+    for cell in v.voxels().filter(|x| !x.state.is_empty()) {
+        let center = v.voxel_center(cell.grid_coords);
+        if let Some(mut h) = DefaultQueryDispatcher
+            .cast_shapes_nonlinear(
+                &m.prepend_translation(center),
+                &cube,
+                n,
+                s,
+                start,
+                earliest,
+                stop,
+            )
+            .unwrap()
+        {
+            h.witness1 += center;
+            earliest = h.time_of_impact;
+            result = Some(h);
+        }
+    }
+    result
+}
+
+#[test]
+fn pruning_preserves_rotating_grid_hits_holes_and_nonzero_substeps() {
+    let cells: Vec<_> = (0..4)
+        .flat_map(|x| {
+            (0..3).flat_map(move |y| {
+                (0..4)
+                    .filter(move |&z| (x + y + z) % 3 != 0)
+                    .map(move |z| IVector::new(x, y, z))
+            })
+        })
+        .collect();
+    let grid = Voxels::new(Vector::new(0.1, 0.2, 0.15), &cells);
+    let cube = Cuboid::new(Vector::new(0.08, 0.15, 0.12));
+    let ball = Ball::new(0.13);
+    let mut cases = 0;
+    let mut hits = 0;
+    for shift in [Vector::ZERO, Vector::new(90.0, 14.0, 35.0)] {
+        for angular in [
+            Vector::Y * 0.2,
+            Vector::new(1.0, -3.0, 2.0),
+            Vector::Y * 80.0,
+        ] {
+            let m = NonlinearRigidMotion::new(
+                Pose::from_parts(shift, Rotation::from_rotation_x(0.31)),
+                Vector::new(0.19, 0.4, -0.1),
+                Vector::new(0.5, -0.1, 0.2),
+                angular,
+            );
+            for x in [-0.3, 0.0, 0.2, 0.55, 1.1] {
+                for velocity in [Vector::ZERO, Vector::new(-8.0, 0.4, 0.2)] {
+                    for target_angular in [Vector::ZERO, Vector::new(3.0, 1.0, -2.0)] {
+                        let n = NonlinearRigidMotion::new(
+                            Pose::from_parts(
+                                shift + Vector::new(x, 0.3, 0.3),
+                                Rotation::from_rotation_y(0.4),
+                            ),
+                            Vector::new(0.07, -0.02, 0.01),
+                            velocity,
+                            target_angular,
+                        );
+                        for s in [&cube as &dyn Shape, &ball as &dyn Shape] {
+                            for start in [0.0, 0.03] {
+                                for stop in [false, true] {
+                                    let expected =
+                                        unpruned(&grid, &m, s, &n, start, start + 0.05, stop);
+                                    let actual = cast_shapes_nonlinear_voxels_shape(
+                                        &DefaultQueryDispatcher,
+                                        &m,
+                                        &grid,
+                                        &n,
+                                        s,
+                                        start,
+                                        start + 0.05,
+                                        stop,
+                                    );
+                                    assert_eq!(format!("{actual:?}"),format!("{expected:?}"),"case {cases} shift={shift:?} angular={angular:?} x={x} velocity={velocity:?} targetAngular={target_angular:?} start={start} stop={stop}");
+                                    hits += actual.is_some() as usize;
+                                    cases += 1;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    assert_eq!(cases, 960);
+    assert!(hits > 100 && hits < cases);
+}
