@@ -0,0 +1,24 @@
+use parry3d::math::{IVector, Vector};
+use parry3d::shape::Voxels;
+#[test]
+fn removes_a_complete_chunk_from_a_cloned_grid() {
+    let original=Voxels::from_regions(Vector::ONE, &[[IVector::new(-2,0,-1),IVector::new(-1,1,0)],[IVector::new(1,0,-1),IVector::new(2,1,0)]]);
+    let mut copy=original.clone();
+    copy.set_voxel(IVector::new(-2,0,-1),false);
+    assert!(original.voxel_state(IVector::new(-2,0,-1)).unwrap().is_empty()==false);
+    assert!(copy.voxel_state(IVector::new(-2,0,-1)).map_or(true, |s|s.is_empty()));
+    copy.set_voxel(IVector::new(-2,0,-1),true);
+    assert!(!copy.voxel_state(IVector::new(-2,0,-1)).unwrap().is_empty());
+}
+
+#[test]
+fn tiny_bvhs_keep_external_leaf_ids_in_any_input_order() {
+    use parry3d::bounding_volume::Aabb;
+    use parry3d::partitioning::{Bvh, BvhBuildStrategy};
+    for ids in [vec![7], vec![1,0], vec![9,3]] {
+        let mut tree=Bvh::from_iter(BvhBuildStrategy::Ploc, ids.iter().map(|id|(*id,Aabb::new(Vector::splat(*id as f32),Vector::splat(*id as f32+1.0)))));
+        for id in &ids { assert_eq!(tree.leaf_node(*id as u32).unwrap().leaf_data(),Some(*id as u32)); }
+        for id in ids { tree.remove(id as u32); assert!(tree.leaf_node(id as u32).is_none()); }
+        assert!(tree.is_empty());
+    }
+}
