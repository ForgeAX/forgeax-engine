+use parry3d::{
+    math::{Pose, Vector},
+    query::{self, ShapeCastOptions, ShapeCastStatus},
+    shape::{Capsule, Cuboid},
+};
+#[test]
+fn initial_contact_obeys_cast_options_and_shape_order() {
+    let cuboid = Cuboid::new(Vector::ONE);
+    let capsule = Capsule::new_y(0.2, 0.5);
+    for z in [0.0, 1.25, 1.5, 1.625] {
+        let pose = Pose::translation(0.0, 0.0, z);
+        for margin in [0.0, 0.125] {
+            for stop in [false, true] {
+                for geometry in [false, true] {
+                    for velocity in [-Vector::Z, Vector::ZERO, Vector::Z] {
+                        let options = ShapeCastOptions {
+                            target_distance: margin,
+                            max_time_of_impact: 0.0,
+                            stop_at_penetration: stop,
+                            compute_impact_geometry_on_penetration: geometry,
+                        };
+                        let contact =
+                            query::contact(&Pose::IDENTITY, &cuboid, &pose, &capsule, f32::MAX)
+                                .unwrap()
+                                .unwrap();
+                        let expected =
+                            contact.dist <= margin && (stop || contact.normal1.dot(velocity) < 0.0);
+                        let a = query::cast_shapes(
+                            &Pose::IDENTITY,
+                            Vector::ZERO,
+                            &cuboid,
+                            &pose,
+                            velocity,
+                            &capsule,
+                            options,
+                        )
+                        .unwrap();
+                        let b = query::cast_shapes(
+                            &pose,
+                            velocity,
+                            &capsule,
+                            &Pose::IDENTITY,
+                            Vector::ZERO,
+                            &cuboid,
+                            options,
+                        )
+                        .unwrap();
+                        assert_eq!(
+                            a.is_some(),
+                            expected,
+                            "z={z} margin={margin} stop={stop} velocity={velocity:?}"
+                        );
+                        assert_eq!(b.is_some(), a.is_some());
+                        if let Some(hit) = a {
+                            assert_eq!(hit.time_of_impact, 0.0);
+                            assert_eq!(
+                                hit.status,
+                                if contact.dist < margin {
+                                    ShapeCastStatus::PenetratingOrWithinTargetDist
+                                } else {
+                                    ShapeCastStatus::Converged
+                                }
+                            );
+                        }
+                        let negative = ShapeCastOptions {
+                            max_time_of_impact: -1.0,
+                            ..options
+                        };
+                        assert!(query::cast_shapes(
+                            &Pose::IDENTITY,
+                            Vector::ZERO,
+                            &cuboid,
+                            &pose,
+                            velocity,
+                            &capsule,
+                            negative
+                        )
+                        .unwrap()
+                        .is_none());
+                    }
+                }
+            }
+        }
+    }
+}
+#[test]
+fn contact_is_covariant_under_rigid_motion_and_shape_exchange() {
+    let cuboid = Cuboid::new(Vector::new(1.5, 0.75, 0.5));
+    let capsule = Capsule::new(
+        Vector::new(-0.6, -0.3, 0.4),
+        Vector::new(0.6, 0.3, -0.4),
+        0.38,
+    );
+    for position in [
+        Vector::new(0.1, 1.5, 0.1),
+        Vector::new(3.0, 2.0, 0.1),
+        Vector::new(-3.0, 2.0, 2.0),
+    ] {
+        let pose = Pose::from_translation(position);
+        let original = query::contact(&Pose::IDENTITY, &cuboid, &pose, &capsule, 100.0)
+            .unwrap()
+            .unwrap();
+        for axis in [
+            Vector::X,
+            Vector::Y,
+            Vector::Z,
+            Vector::new(1.0, 2.0, 3.0).normalize(),
+        ] {
+            let frame = Pose::from_parts(
+                Vector::new(0.25, -0.5, 0.125),
+                parry3d::glamx::Quat::from_axis_angle(axis, 0.7),
+            );
+            let transformed = query::contact(&frame, &cuboid, &(frame * pose), &capsule, 100.0)
+                .unwrap()
+                .unwrap();
+            let reverse = query::contact(&(frame * pose), &capsule, &frame, &cuboid, 100.0)
+                .unwrap()
+                .unwrap();
+            assert!((transformed.point1 - frame * original.point1).length() < 2.0e-5);
+            assert!((transformed.point2 - frame * original.point2).length() < 2.0e-5);
+            assert!((transformed.normal1 - frame.rotation * original.normal1).length() < 2.0e-5);
+            assert!((transformed.dist - original.dist).abs() < 2.0e-5);
+            assert!((reverse.point1 - transformed.point2).length() < 2.0e-5);
+            assert!((reverse.point2 - transformed.point1).length() < 2.0e-5);
+            assert!((reverse.normal1 + transformed.normal1).length() < 2.0e-5);
+        }
+    }
+}
