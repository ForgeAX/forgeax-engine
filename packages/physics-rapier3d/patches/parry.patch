+// Ill-conditioned f32 triangles need wider intermediates for both the Voronoi
+// region and its coordinates. The ordinary projection keeps its f32 path.
+#[cfg(all(feature = "dim3", feature = "f32"))]
+fn project_thin_triangle(
+    triangle: &Triangle,
+    pt: Vector,
+) -> (PointProjection, TrianglePointLocation) {
+    let widen = |v: Vector| [v.x as f64, v.y as f64, v.z as f64];
+    let sub = |a: [f64; 3], b: [f64; 3]| [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
+    let cross = |a: [f64; 3], b: [f64; 3]| {
+        [
+            a[1] * b[2] - a[2] * b[1],
+            a[2] * b[0] - a[0] * b[2],
+            a[0] * b[1] - a[1] * b[0],
+        ]
+    };
+    let dot = |a: [f64; 3], b: [f64; 3]| a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+    let vertices = [widen(triangle.a), widen(triangle.b), widen(triangle.c)];
+    let point = widen(pt);
+    let ab = sub(vertices[1], vertices[0]);
+    let ac = sub(vertices[2], vertices[0]);
+    let ap = sub(point, vertices[0]);
+    let normal = cross(ab, ac);
+    let area_squared = dot(normal, normal);
+    if area_squared > 0.0 {
+        let v = dot(normal, cross(ap, ac)) / area_squared;
+        let w = dot(normal, cross(ab, ap)) / area_squared;
+        if v >= 0.0 && w >= 0.0 && v + w <= 1.0 {
+            let projection = Vector::from_array(core::array::from_fn(|i| {
+                (vertices[0][i] + ab[i] * v + ac[i] * w) as Real
+            }));
+            let side = if dot(normal, ap) >= 0.0 { 0 } else { 1 };
+            return (
+                compute_result(pt, projection),
+                TrianglePointLocation::OnFace(side, [(1.0 - v - w) as Real, v as Real, w as Real]),
+            );
+        }
+    }
+    let mut best_distance = f64::INFINITY;
+    let mut best = (
+        compute_result(pt, triangle.a),
+        TrianglePointLocation::OnVertex(0),
+    );
+    for (edge, (i, j)) in [(0, 1), (1, 2), (0, 2)].into_iter().enumerate() {
+        let direction = sub(vertices[j], vertices[i]);
+        let length_squared = dot(direction, direction);
+        let t = if length_squared > 0.0 {
+            (dot(sub(point, vertices[i]), direction) / length_squared).clamp(0.0, 1.0)
+        } else {
+            0.0
+        };
+        let projection: [f64; 3] = core::array::from_fn(|k| vertices[i][k] + direction[k] * t);
+        let delta = sub(projection, point);
+        let distance = dot(delta, delta);
+        if distance < best_distance {
+            best_distance = distance;
+            let location = if t == 0.0 {
+                TrianglePointLocation::OnVertex(i as u32)
+            } else if t == 1.0 {
+                TrianglePointLocation::OnVertex(j as u32)
+            } else {
+                TrianglePointLocation::OnEdge(edge as u32, [(1.0 - t) as Real, t as Real])
+            };
+            best = (
+                compute_result(pt, Vector::from_array(projection.map(|x| x as Real))),
+                location,
+            );
+        }
+    }
+    best
+}
