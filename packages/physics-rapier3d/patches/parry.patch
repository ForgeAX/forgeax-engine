+    ] {
+        for local in [
+            Vector::new(0.05, 14.0, 0.05),
+            Vector::new(0.15, 14.05, 0.15),
+            Vector::new(0.4, 14.05, -0.1),
+        ] {
+            let world = pose.transform_point(local);
+            let actual_local = pose.inverse_transform_point(world);
+            let expected = voxels.voxels().any(|v| {
+                voxels
+                    .voxel_aabb(v.grid_coords)
+                    .contains_local_point(actual_local)
+            });
+            assert_eq!(voxels.contains_point(&pose, world), expected);
+            assert_eq!(voxels.project_point(&pose, world, true).is_inside, expected);
+        }
+    }
+}
+
+#[test]
+fn chunk_boundaries_and_nonsolid_projection_match_existing_voxel_aabbs() {
+    let cells = [
+        IVector::new(31, 139, 0),
+        IVector::new(32, 140, 0),
+        IVector::new(-33, -140, 0),
+        IVector::new(-32, -141, 0),
+    ];
+    let voxels = Voxels::new(Vector::splat(0.1), &cells);
+    for voxel in voxels.voxels() {
+        let bounds = voxels.voxel_aabb(voxel.grid_coords);
+        for point in [
+            bounds.mins,
+            bounds.maxs,
+            bounds.center(),
+            bounds.mins - Vector::splat(0.001),
+            bounds.maxs + Vector::splat(0.001),
+        ] {
+            assert_reference(&voxels, point);
+            let expected = voxels
+                .voxels()
+                .map(|v| {
+                    voxels
+                        .voxel_aabb(v.grid_coords)
+                        .project_local_point(point, false)
+                        .point
+                        .distance(point)
+                })
+                .fold(f32::MAX, f32::min);
+            let projected = voxels.project_local_point(point, false);
+            let featured = voxels.project_local_point_and_get_feature(point).0;
+            for result in [projected, featured] {
+                assert!(
+                    (result.point.distance(point) - expected).abs()
+                        <= 4.0 * f32::EPSILON * (1.0 + expected)
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn rounded_zero_distance_outside_does_not_hide_an_inside_chunk() {
+    let voxels = Voxels::new(
+        Vector::splat(0.1),
+        &[
+            IVector::new(-1, -1, -1),
+            IVector::new(0, -1, -1),
+            IVector::new(-1, 0, -1),
+            IVector::new(-1, -1, 0),
+        ],
+    );
+    for axis in 0..3 {
+        for near_zero in [-f32::from_bits(1), -1.0e-30, -1.0e-24] {
+            let mut point = Vector::splat(-0.05);
+            point[axis] = near_zero;
+            assert_reference(&voxels, point);
+            assert!(voxels.contains_local_point(point));
+            assert!(voxels.project_local_point(point, false).is_inside);
+            assert!(
+                voxels
+                    .project_local_point_and_get_feature(point)
+                    .0
+                    .is_inside
+            );
+        }
+    }
+}
