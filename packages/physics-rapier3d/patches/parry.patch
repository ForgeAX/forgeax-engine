+    g2: &dyn Shape,
+    start_time: Real,
+    end_time: Real,
+    thickness: Real,
+) -> bool {
+    if start_time != 0.0
+        || !(end_time > 0.0 && end_time.is_finite())
+        || !(thickness > 0.0 && thickness.is_finite())
+    {
+        return false;
+    }
+    let mut speed = 0.0;
+    for (motion, shape) in [(motion1, g1), (motion2, g2)] {
+        if !motion.start.translation.is_finite()
+            || !motion.local_center.is_finite()
+            || !motion.linvel.is_finite()
+            || !motion.angvel.is_finite()
+        {
