+++ b/crates/parry3d/tests/voxel_nonlinear_cast.rs
@@ -0,0 +1,41 @@
+use parry3d::math::{IVector, Pose, Rotation, Vector};
+use parry3d::query::{cast_shapes_nonlinear, NonlinearRigidMotion};
+use parry3d::shape::{Ball, Cuboid, Shape, Voxels};
+
+fn compare(grid_motion: NonlinearRigidMotion, other_motion: NonlinearRigidMotion, other: &dyn Shape, start: f32, end: f32) {
+    let voxels = Voxels::from_regions(Vector::splat(0.1), &[[IVector::new(-10,-1,0), IVector::new(10,1,1)]]);
+    let solid = Cuboid::new(Vector::new(1.0,0.1,0.05));
+    let reference = cast_shapes_nonlinear(&grid_motion.prepend_translation(Vector::new(0.0,0.0,0.05)), &solid, &other_motion, other, start, end, true).unwrap().expect("reference collision");
+    let actual = cast_shapes_nonlinear(&grid_motion, &voxels, &other_motion, other, start, end, true).unwrap().expect("voxel collision");
+    assert!((actual.time_of_impact-reference.time_of_impact).abs()<0.00003,"reference={reference:?} actual={actual:?}");
+    let point = grid_motion.position_at_time(actual.time_of_impact) * actual.witness1;
+    let other_point = other_motion.position_at_time(actual.time_of_impact) * actual.witness2;
+    assert!((point-other_point).length()<0.003,"witnesses disagree: {point:?} != {other_point:?}");
+}
+
+#[test]
+fn translated_and_rotated_grid_uses_local_velocity_at_nonzero_substeps() {
+    let ball=Ball::new(0.05);
