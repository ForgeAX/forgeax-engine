+use parry3d::math::{IVector, Pose, Rotation, Vector};
+use parry3d::query::PointQuery;
+use parry3d::shape::Voxels;
+
+fn assert_reference(voxels: &Voxels, point: Vector) {
+    let expected_inside = voxels
+        .voxels()
+        .any(|v| voxels.voxel_aabb(v.grid_coords).contains_local_point(point));
+    let result = voxels.project_local_point(point, true);
+    assert_eq!(
+        result.is_inside, expected_inside,
+        "point={point:?}, result={result:?}"
+    );
+    assert_eq!(voxels.contains_local_point(point), expected_inside);
+    if expected_inside {
+        assert_eq!(result.point, point);
+    } else {
+        let distance = voxels
+            .voxels()
+            .map(|v| {
+                voxels
+                    .voxel_aabb(v.grid_coords)
+                    .distance_to_local_point(point, true)
+            })
+            .fold(f32::MAX, f32::min);
+        assert!(
+            (result.point.distance(point) - distance).abs()
+                <= 4.0 * f32::EPSILON * (1.0 + distance)
+        );
+    }
+}
+
+#[test]
+fn adjacent_tenth_cells_include_shared_faces_edges_and_corners() {
+    for base in [IVector::new(139, 139, 139), IVector::new(-141, -141, -141)] {
+        let cells: Vec<_> = (0..2)
+            .flat_map(|x| {
+                (0..2).flat_map(move |y| (0..2).map(move |z| base + IVector::new(x, y, z)))
+            })
+            .collect();
+        let voxels = Voxels::new(Vector::splat(0.1), &cells);
+        let center: f32 = if base.x > 0 { 14.0 } else { -14.0 };
+        for x in [center.next_down(), center, center.next_up()] {
+            for y in [center.next_down(), center, center.next_up()] {
+                for z in [center.next_down(), center, center.next_up()] {
+                    assert_reference(&voxels, Vector::new(x, y, z));
+                    assert!(voxels.contains_local_point(Vector::new(x, y, z)));
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn isolated_exterior_faces_and_empty_holes_use_existing_voxel_bounds() {
+    let cells = [
+        IVector::new(0, 139, 0),
+        IVector::new(0, 141, 0),
+        IVector::new(-33, -1, -33),
+    ];
+    let voxels = Voxels::new(Vector::new(0.1, 0.1, 0.2), &cells);
+    for v in voxels.voxels() {
+        let bounds = voxels.voxel_aabb(v.grid_coords);
+        for x in [
+            bounds.mins.x.next_down(),
+            bounds.mins.x,
+            bounds.maxs.x,
+            bounds.maxs.x.next_up(),
+        ] {
+            for y in [
+                bounds.mins.y.next_down(),
+                bounds.mins.y,
+                bounds.maxs.y,
+                bounds.maxs.y.next_up(),
+            ] {
+                for z in [
+                    bounds.mins.z.next_down(),
+                    bounds.mins.z,
+                    bounds.maxs.z,
+                    bounds.maxs.z.next_up(),
+                ] {
+                    assert_reference(&voxels, Vector::new(x, y, z));
+                }
+            }
+        }
+    }
+    assert!(!voxels.contains_local_point(Vector::new(0.05, 14.05, 0.1)));
+}
+
+#[test]
+fn transformed_queries_compare_after_the_actual_inverse_pose() {
+    let voxels = Voxels::from_regions(
+        Vector::splat(0.1),
+        &[[IVector::new(0, 139, 0), IVector::new(2, 141, 2)]],
+    );
+    for pose in [
+        Pose::translation(96.0, -6.063216e-8, 64.0),
+        Pose::from_parts(
+            Vector::new(-5.0, 3.0, -7.0),
+            Rotation::from_rotation_y(0.37),
+        ),
+    ] {
+        for local in [
+            Vector::new(0.05, 14.0, 0.05),
+            Vector::new(0.15, 14.05, 0.15),
+            Vector::new(0.4, 14.05, -0.1),
+        ] {
+            let world = pose.transform_point(local);
+            let actual_local = pose.inverse_transform_point(world);
+            let expected = voxels.voxels().any(|v| {
+                voxels
+                    .voxel_aabb(v.grid_coords)
+                    .contains_local_point(actual_local)
+            });
+            assert_eq!(voxels.contains_point(&pose, world), expected);
+            assert_eq!(voxels.project_point(&pose, world, true).is_inside, expected);
+        }
+    }
+}
+
+#[test]
+fn chunk_boundaries_and_nonsolid_projection_match_existing_voxel_aabbs() {
+    let cells = [
+        IVector::new(31, 139, 0),
+        IVector::new(32, 140, 0),
+        IVector::new(-33, -140, 0),
+        IVector::new(-32, -141, 0),
+    ];
+    let voxels = Voxels::new(Vector::splat(0.1), &cells);
+    for voxel in voxels.voxels() {
+        let bounds = voxels.voxel_aabb(voxel.grid_coords);
+        for point in [
+            bounds.mins,
+            bounds.maxs,
+            bounds.center(),
+            bounds.mins - Vector::splat(0.001),
+            bounds.maxs + Vector::splat(0.001),
+        ] {
+            assert_reference(&voxels, point);
+            let expected = voxels
+                .voxels()
+                .map(|v| {
+                    voxels
+                        .voxel_aabb(v.grid_coords)
+                        .project_local_point(point, false)
+                        .point
+                        .distance(point)
+                })
+                .fold(f32::MAX, f32::min);
+            let projected = voxels.project_local_point(point, false);
+            let featured = voxels.project_local_point_and_get_feature(point).0;
+            for result in [projected, featured] {
+                assert!(
+                    (result.point.distance(point) - expected).abs()
+                        <= 4.0 * f32::EPSILON * (1.0 + expected)
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn rounded_zero_distance_outside_does_not_hide_an_inside_chunk() {
+    let voxels = Voxels::new(
+        Vector::splat(0.1),
+        &[
+            IVector::new(-1, -1, -1),
+            IVector::new(0, -1, -1),
+            IVector::new(-1, 0, -1),
+            IVector::new(-1, -1, 0),
+        ],
+    );
+    for axis in 0..3 {
+        for near_zero in [-f32::from_bits(1), -1.0e-30, -1.0e-24] {
+            let mut point = Vector::splat(-0.05);
+            point[axis] = near_zero;
+            assert_reference(&voxels, point);
+            assert!(voxels.contains_local_point(point));
+            assert!(voxels.project_local_point(point, false).is_inside);
+            assert!(
+                voxels
+                    .project_local_point_and_get_feature(point)
+                    .0
+                    .is_inside
+            );
+        }
+    }
+}
