diff --git a/src/partitioning/affine_bvh.rs b/src/partitioning/affine_bvh.rs
new file mode 100644
index 0000000..60c2aff
--- /dev/null
+++ b/src/partitioning/affine_bvh.rs
@@ -0,0 +1,470 @@
+//! Instance transforms indexed independently of their shared geometry bounds.
+//!
+//! A node encloses affine coefficients, not a previously transformed shape.
+//! Replacing a geometry's local bounds therefore changes no instance or node.
+//! Queries evaluate bounds only for the nodes they actually visit.
+
+use crate::bounding_volume::Aabb;
+use crate::math::{DIM, Real, Vector};
+use crate::partitioning::BvhLeafCost;
+use crate::utils::hashmap::HashMap;
+use alloc::vec::Vec;
+
+/// An affine map, including non-uniform scale. Each vector is one matrix row.
+#[derive(Clone, Copy, Debug)]
+#[cfg_attr(feature = "serde-serialize", derive(Serialize, Deserialize))]
+pub struct AffineTransform {
+    /// Rows of the complete linear map (rotation, scale and optional shear).
+    pub rows: [Vector; DIM],
+    /// Translation added after the linear map.
+    pub translation: Vector,
+}
+
+#[derive(Clone, Copy, Debug)]
+#[cfg_attr(feature = "serde-serialize", derive(Serialize, Deserialize))]
+struct Interval {
+    low: AffineTransform,
+    high: AffineTransform,
+}
+
+impl Interval {
+    fn leaf(transform: AffineTransform) -> Self {
+        Self {
+            low: transform,
+            high: transform,
+        }
+    }
+
+    fn merge(self, rhs: Self) -> Self {
+        let mut result = self;
+        for row in 0..DIM {
+            result.low.rows[row] = self.low.rows[row].min(rhs.low.rows[row]);
+            result.high.rows[row] = self.high.rows[row].max(rhs.high.rows[row]);
+        }
+        result.low.translation = self.low.translation.min(rhs.low.translation);
+        result.high.translation = self.high.translation.max(rhs.high.translation);
+        result
+    }
+
+    fn bounds(self, local: &Aabb) -> Aabb {
+        let mut mins = self.low.translation;
+        let mut maxs = self.high.translation;
+        for row in 0..DIM {
+            for column in 0..DIM {
+                let a = self.low.rows[row][column];
+                let b = self.high.rows[row][column];
+                let x = local.mins[column];
+                let y = local.maxs[column];
+                let products = [a * x, a * y, b * x, b * y];
+                let low = products.iter().copied().fold(Real::INFINITY, Real::min);
+                let high = products.iter().copied().fold(Real::NEG_INFINITY, Real::max);
+                // Products and sums round outwards, including cancellation.
+                mins[row] = (mins[row] + low.next_down()).next_down();
+                maxs[row] = (maxs[row] + high.next_up()).next_up();
+            }
+        }
+        Aabb::new(mins, maxs)
+    }
+}
+
+#[derive(Clone, Debug)]
+#[cfg_attr(feature = "serde-serialize", derive(Serialize, Deserialize))]
+struct Node {
+    parent: Option<usize>,
+    children: Option<[usize; 2]>,
+    leaf: u32,
+    height: u32,
+    interval: Interval,
+    mask: u32,
+}
+
+/// A height-balanced spatial tree for instances of one shared geometry.
+///
+/// Instance insertion, removal and pose changes update only their tree paths.
+/// Geometry adoption supplies new local bounds to `bounds`/`query`; it never
+/// enumerates leaves or modifies this tree. Internal coefficient intervals may
+/// overestimate bounds, while leaves retain the exact authored affine map.
+#[derive(Default, Clone, Debug)]
+#[cfg_attr(feature = "serde-serialize", derive(Serialize, Deserialize))]
+pub struct AffineBvh {
+    nodes: Vec<Option<Node>>,
+    free: Vec<usize>,
+    leaves: HashMap<u32, usize>,
+    root: Option<usize>,
+}
+
+impl AffineBvh {
+    /// Create an empty instance tree.
+    pub fn new() -> Self {
+        Self::default()
+    }
+    /// Number of retained instance leaves.
+    pub fn len(&self) -> usize {
+        self.leaves.len()
+    }
+    /// Whether the tree contains no instances.
+    pub fn is_empty(&self) -> bool {
+        self.root.is_none()
+    }
+
+    fn node(&self, index: usize) -> &Node {
+        self.nodes[index].as_ref().unwrap()
+    }
+    fn node_mut(&mut self, index: usize) -> &mut Node {
+        self.nodes[index].as_mut().unwrap()
+    }
+    fn allocate(&mut self, node: Node) -> usize {
+        if let Some(index) = self.free.pop() {
+            self.nodes[index] = Some(node);
+            index
+        } else {
+            self.nodes.push(Some(node));
+            self.nodes.len() - 1
+        }
+    }
+    fn release(&mut self, index: usize) {
+        self.nodes[index] = None;
+        self.free.push(index);
+    }
+    fn refit(&mut self, index: usize) {
+        let Some([left, right]) = self.node(index).children else {
+            return;
+        };
+        let interval = self.node(left).interval.merge(self.node(right).interval);
+        let height = 1 + self.node(left).height.max(self.node(right).height);
+        let mask = self.node(left).mask | self.node(right).mask;
+        let node = self.node_mut(index);
+        node.interval = interval;
+        node.height = height;
+        node.mask = mask;
+    }
+    fn replace_child(&mut self, parent: Option<usize>, old: usize, new: usize) {
+        if let Some(parent) = parent {
+            let children = self.node_mut(parent).children.as_mut().unwrap();
+            let side = usize::from(children[1] == old);
+            debug_assert_eq!(children[side], old);
+            children[side] = new;
+        } else {
+            self.root = Some(new);
+        }
+        self.node_mut(new).parent = parent;
+    }
+
+    // Rotate the taller branch up; both rotated nodes retain spatial children.
+    fn balance(&mut self, index: usize) -> usize {
+        let Some(children) = self.node(index).children else {
+            return index;
+        };
+        let heights = [self.node(children[0]).height, self.node(children[1]).height];
+        let tall = usize::from(heights[1] > heights[0]);
+        if heights[tall] <= heights[1 - tall] + 1 {
+            return index;
+        }
+        let upper = children[tall];
+        let grandchildren = self.node(upper).children.unwrap();
+        let keep =
+            usize::from(self.node(grandchildren[1]).height > self.node(grandchildren[0]).height);
+        let moved = grandchildren[1 - keep];
+        let parent = self.node(index).parent;
+        self.replace_child(parent, index, upper);
+        self.node_mut(upper).children = Some([index, grandchildren[keep]]);
+        self.node_mut(index).parent = Some(upper);
+        self.node_mut(index).children.as_mut().unwrap()[tall] = moved;
+        self.node_mut(moved).parent = Some(index);
+        self.refit(index);
+        self.refit(upper);
+        upper
+    }
+    fn refit_path(&mut self, mut current: Option<usize>) {
+        while let Some(index) = current {
+            self.refit(index);
+            let balanced = self.balance(index);
+            current = self.node(balanced).parent;
+        }
+    }
+
+    /// Insert or replace one instance transform. `local` guides spatial topology only.
+    pub fn insert(&mut self, leaf: u32, transform: AffineTransform, local: &Aabb) {
+        self.insert_motion(leaf, transform, transform, 0.0, local);
+    }
+
+    /// Insert the conservative affine interval of one actual instance motion.
+    /// `margin` expands world-space translation intervals, independently of geometry.
+    pub fn insert_motion(
+        &mut self,
+        leaf: u32,
+        from: AffineTransform,
+        to: AffineTransform,
+        margin: Real,
+        local: &Aabb,
+    ) {
+        self.insert_motion_with_mask(leaf, from, to, margin, local, 0);
+    }
+
+    /// Insert one native instance and its caller-owned role bits. Parent role
+    /// masks are derived along the same spatial paths as affine intervals.
+    pub fn insert_motion_with_mask(&mut self, leaf: u32, from: AffineTransform, to: AffineTransform, margin: Real, local: &Aabb, mask: u32) {
+        let _ = self.remove(leaf);
+        let mut interval = Interval::leaf(from).merge(Interval::leaf(to));
+        interval.low.translation -= Vector::splat(margin);
+        interval.high.translation += Vector::splat(margin);
+        let index = self.allocate(Node {
+            parent: None,
+            children: None,
+            leaf,
+            height: 0,
+            interval,
+            mask,
+        });
+        let _ = self.leaves.insert(leaf, index);
+        let Some(mut sibling) = self.root else {
+            self.root = Some(index);
+            return;
+        };
+        while let Some(children) = self.node(sibling).children {
+            let cost = |child| {
+                let old = self.node(child).interval.bounds(local).extents();
+                let new = self
+                    .node(child)
+                    .interval
+                    .merge(interval)
+                    .bounds(local)
+                    .extents();
+                new.element_sum() - old.element_sum()
+            };
+            sibling = children[usize::from(cost(children[1]) < cost(children[0]))];
+        }
+        let parent = self.node(sibling).parent;
+        let branch = self.allocate(Node {
+            parent,
+            children: Some([sibling, index]),
+            leaf: 0,
+            height: 1,
+            interval: interval.merge(self.node(sibling).interval),
+            mask: mask | self.node(sibling).mask,
+        });
+        self.replace_child(parent, sibling, branch);
+        self.node_mut(sibling).parent = Some(branch);
+        self.node_mut(index).parent = Some(branch);
+        self.refit_path(Some(branch));
+    }
+
+    /// Remove one instance, returning whether it existed.
+    pub fn remove(&mut self, leaf: u32) -> bool {
+        let Some(index) = self.leaves.remove(&leaf) else {
+            return false;
+        };
+        if let Some(parent) = self.node(index).parent {
+            let children = self.node(parent).children.unwrap();
+            let sibling = children[usize::from(children[0] == index)];
+            let grandparent = self.node(parent).parent;
+            self.replace_child(grandparent, parent, sibling);
+            self.release(parent);
+            self.refit_path(grandparent);
+        } else {
+            self.root = None;
+        }
+        self.release(index);
+        true
+    }
+
+    /// The group's new root bounds, computed without visiting any instance.
+    pub fn bounds(&self, local: &Aabb) -> Option<Aabb> {
+        self.root.map(|root| self.node(root).interval.bounds(local))
+    }
+
+    /// Bounds of one actual instance, without traversing unrelated leaves.
+    pub fn leaf_bounds(&self, leaf: u32, local: &Aabb) -> Option<Aabb> {
+        self.leaves
+            .get(&leaf)
+            .map(|index| self.node(*index).interval.bounds(local))
+    }
+
+    /// Select an actual native execution cohort through aggregate role masks.
+    /// This is a role traversal, not a spatial query or change propagation.
+    pub fn matching_leaves(&self, mask: u32) -> AffineBvhMatchingLeaves<'_> {
+        AffineBvhMatchingLeaves { tree: self, mask, stack: self.root.into_iter().collect(), visited: 0 }
+    }
+
+    /// Traverse two geometry-dependent trees for actual overlapping instance pairs.
+    /// Self traversal emits each distinct pair once and omits diagonal leaves.
+    pub fn intersections<'a>(
+        &'a self,
+        local: Aabb,
+        other: &'a Self,
+        other_local: Aabb,
+    ) -> AffineBvhIntersections<'a> {
+        AffineBvhIntersections {
+            left: self,
+            right: other,
+            local,
+            other_local,
+            same: core::ptr::eq(self, other),
+            stack: self.root.zip(other.root).into_iter().collect(),
+            visited: 0,
+        }
+    }
+
+    /// Find the least-cost actual leaf, pruning against bounds from this geometry version.
+    pub fn find_best<L: BvhLeafCost>(
+        &self,
+        local: &Aabb,
+        max_cost: Real,
+        aabb_cost: impl Fn(&Aabb, Real) -> Real,
+        leaf_cost: impl Fn(u32, Real) -> Option<L>,
+    ) -> Option<(u32, L)> {
+        let root = self.root?;
+        let mut best = None;
+        let mut best_cost = max_cost;
+        let root_cost = aabb_cost(&self.node(root).interval.bounds(local), best_cost);
+        let mut stack = alloc::vec![(root, root_cost)];
+        while let Some((index, cost)) = stack.pop() {
+            if cost >= best_cost {
+                continue;
+            }
+            let node = self.node(index);
+            if let Some(children) = node.children {
+                let left = aabb_cost(&self.node(children[0]).interval.bounds(local), best_cost);
+                let right = aabb_cost(&self.node(children[1]).interval.bounds(local), best_cost);
+                let near = usize::from(right < left);
+                let costs = [left, right];
+                if costs[1 - near] < best_cost {
+                    stack.push((children[1 - near], costs[1 - near]));
+                }
+                if costs[near] < best_cost {
+                    stack.push((children[near], costs[near]));
+                }
+            } else if let Some(value) = leaf_cost(node.leaf, best_cost) {
+                if value.cost() < best_cost {
+                    best_cost = value.cost();
+                    best = Some((node.leaf, value));
+                }
+            }
+        }
+        best
+    }
+
+    /// Traverse only nodes admitted by the query's conservative bounds predicate.
+    pub fn query<F: FnMut(&Aabb) -> bool>(
+        &self,
+        local: Aabb,
+        predicate: F,
+    ) -> AffineBvhQuery<'_, F> {
+        AffineBvhQuery {
+            tree: self,
+            local,
+            predicate,
+            stack: self.root.into_iter().collect(),
+            visited: 0,
+        }
+    }
+}
+
+/// Native role selection over the existing spatial hierarchy.
+pub struct AffineBvhMatchingLeaves<'a> {
+    tree: &'a AffineBvh,
+    mask: u32,
+    stack: Vec<usize>,
+    visited: usize,
+}
+impl AffineBvhMatchingLeaves<'_> {
+    /// Node visits made by the actual role selection.
+    pub fn visited_nodes(&self) -> usize { self.visited }
+}
+impl Iterator for AffineBvhMatchingLeaves<'_> {
+    type Item = u32;
+    fn next(&mut self) -> Option<Self::Item> {
+        while let Some(index) = self.stack.pop() {
+            self.visited += 1;
+            let node = self.tree.node(index);
+            if node.mask & self.mask == 0 { continue; }
+            if let Some(children) = node.children { self.stack.extend(children); }
+            else { return Some(node.leaf); }
+        }
+        None
+    }
+}
+
+/// A bounds-pruned BVTT query over immutable affine instance trees.
+pub struct AffineBvhIntersections<'a> {
+    left: &'a AffineBvh,
+    right: &'a AffineBvh,
+    local: Aabb,
+    other_local: Aabb,
+    same: bool,
+    stack: Vec<(usize, usize)>,
+    visited: usize,
+}
+impl AffineBvhIntersections<'_> {
+    /// Number of tested node pairs, including pruned pairs.
+    pub fn visited_nodes(&self) -> usize {
+        self.visited
+    }
+}
+impl Iterator for AffineBvhIntersections<'_> {
+    type Item = (u32, u32);
+    fn next(&mut self) -> Option<Self::Item> {
+        use crate::bounding_volume::BoundingVolume;
+        while let Some((left, right)) = self.stack.pop() {
+            self.visited += 1;
+            let a = self.left.node(left);
+            let b = self.right.node(right);
+            if !a
+                .interval
+                .bounds(&self.local)
+                .intersects(&b.interval.bounds(&self.other_local))
+            {
+                continue;
+            }
+            if self.same && left == right {
+                if let Some([x, y]) = a.children {
+                    self.stack.extend([(x, x), (x, y), (y, y)]);
+                }
+            } else if a.children.is_some() && (b.children.is_none() || a.height >= b.height) {
+                for child in a.children.unwrap() {
+                    self.stack.push((child, right));
+                }
+            } else if let Some(children) = b.children {
+                for child in children {
+                    self.stack.push((left, child));
+                }
+            } else {
+                return Some((a.leaf, b.leaf));
+            }
+        }
+        None
+    }
+}
+
+/// A bounds-pruned traversal of one immutable instance tree.
+pub struct AffineBvhQuery<'a, F> {
+    tree: &'a AffineBvh,
+    local: Aabb,
+    predicate: F,
+    stack: Vec<usize>,
+    visited: usize,
+}
+impl<F> AffineBvhQuery<'_, F> {
+    /// Nodes visited by this actual query; useful for bounded-query diagnostics.
+    pub fn visited_nodes(&self) -> usize {
+        self.visited
+    }
+}
+impl<F: FnMut(&Aabb) -> bool> Iterator for AffineBvhQuery<'_, F> {
+    type Item = u32;
+    fn next(&mut self) -> Option<u32> {
+        while let Some(index) = self.stack.pop() {
+            let node = self.tree.node(index);
+            self.visited += 1;
+            if !(self.predicate)(&node.interval.bounds(&self.local)) {
+                continue;
+            }
+            if let Some(children) = node.children {
+                self.stack.extend(children);
+            } else {
+                return Some(node.leaf);
+            }
+        }
+        None
+    }
+}
