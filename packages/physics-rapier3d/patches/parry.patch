+        let vertices = [
+            Vector::new(2.9, 0.9, 1.4),
+            Vector::new(3.0, 0.9, 1.4),
+            Vector::new(2.9, 1.0, 1.4),
+            Vector::new(3.0, 1.0, 1.4),
+            Vector::new(2.9, 0.9, 1.5),
+            Vector::new(3.0, 0.9, 1.5),
+            Vector::new(2.9, 1.0, 1.5),
+            Vector::new(3.0, 1.0, 1.5),
+        ];
+        let hull = ConvexPolyhedron::from_convex_hull(&vertices).unwrap();
+        let cuboid = Cuboid::new(Vector::new(0.20000004768371582, 3.5999999046325684, 5.25));
+        let relative =
+            Pose::from_translation(Vector::new(2.700000047683716, 4.599999904632568, -2.75));
+        (hull, cuboid, relative)
+    }
