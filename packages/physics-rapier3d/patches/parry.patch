diff --git a/crates/parry3d/tests/voxel_penetration_contacts.rs b/crates/parry3d/tests/voxel_penetration_contacts.rs
new file mode 100644
index 0000000..ec0962b
--- /dev/null
+++ b/crates/parry3d/tests/voxel_penetration_contacts.rs
@@ -0,0 +1,96 @@
+use parry3d::math::{IVector, Pose, Vector};
+use parry3d::query::{ContactManifold, DefaultQueryDispatcher, PersistentQueryDispatcher};
+use parry3d::shape::{SharedShape, Voxels};
+
+#[test]
+fn penetrating_box_faces_remain_exact_across_voxel_seams_and_shape_order() {
+    let mut cells = Vec::new();
+    for x in 0..8 {
+        for y in 0..2 {
+            for z in 0..8 {
+                cells.push(IVector::new(x, y, z));
+            }
+        }
+    }
+    let voxels = Voxels::new(Vector::ONE, &cells);
+    let mut corners = Vec::new();
+    for x in [-0.4, 0.4] {
+        for y in [-0.4, 0.4] {
+            for z in [-0.4, 0.4] {
+                corners.push(Vector::new(x, y, z));
+            }
+        }
+    }
+    let hull = SharedShape::convex_hull(&corners).unwrap();
+    let shapes = [
+        (SharedShape::cuboid(0.4, 0.4, 0.4), 4),
+        (hull.clone(), 4),
+        (
+            SharedShape::compound(vec![
+                (Pose::IDENTITY, hull.clone()),
+                (Pose::translation(1.5, 0.0, 0.0), hull),
+            ]),
+            8,
+        ),
+    ];
+    for (shape, expected_points) in shapes {
+        for flipped in [false, true] {
+            let mut manifolds: Vec<ContactManifold<(), ()>> = Vec::new();
+            let mut workspace = None;
+            for x in [2.5, 2.9, 3.1, 2.5] {
+                for (angle, height) in [0.0, 0.37, 1.1]
+                    .into_iter()
+                    .flat_map(|angle| [2.05, 2.2, 4.0, 2.35].map(|height| (angle, height)))
+                {
+                    let pose = Pose::from_parts(
+                        Vector::new(x, height, 2.5),
+                        parry3d::glamx::Quat::from_rotation_y(angle),
+                    );
+                    let (pose, first, second): (
+                        _,
+                        &dyn parry3d::shape::Shape,
+                        &dyn parry3d::shape::Shape,
+                    ) = if flipped {
+                        (pose.inverse(), &*shape, &voxels)
+                    } else {
+                        (pose, &voxels, &*shape)
+                    };
+                    DefaultQueryDispatcher
+                        .contact_manifolds(
+                            &pose,
+                            first,
+                            second,
+                            0.05,
+                            &mut manifolds,
+                            &mut workspace,
+                        )
+                        .unwrap();
+                    if height == 4.0 {
+                        assert!(manifolds.iter().all(|manifold| manifold.points.is_empty()));
+                        continue;
+                    }
+                    let mut count = 0;
+                    for manifold in &manifolds {
+                        for point in &manifold.points {
+                            let (normal, local, transform) = if flipped {
+                                (manifold.local_n2, point.local_p2, manifold.subshape_pos2())
+                            } else {
+                                (manifold.local_n1, point.local_p1, manifold.subshape_pos1())
+                            };
+                            let witness =
+                                transform.unwrap_or(&Pose::IDENTITY).transform_point(local);
+                            assert!((normal - Vector::Y).length() < 1.0e-5);
+                            assert!((witness.y - 2.0).abs() < 1.0e-5);
+                            assert!((point.dist - (height - 2.4)).abs() < 1.0e-5);
+                            count += 1;
+                        }
+                    }
+                    assert!(
+                        count >= expected_points,
+                        "x={x} height={height} flipped={flipped}"
+                    );
+                }
+            }
+        }
+    }
+}
diff --git a/crates/parry3d/tests/voxel_point_seams.rs b/crates/parry3d/tests/voxel_point_seams.rs
