+            &relative,
+            &hull,
+            &cuboid,
+            0.02,
+            &mut simplex,
+            None,
+        );
+        assert_eq!(
+            simplex.dimension(),
+            1,
+            "retain the captured line-simplex path"
+        );
+        let GJKResult::ClosestPoints(a, b, normal) = result else {
+            panic!("the touching pair must retain a contact: {result:?}");
+        };
+        assert!(normal.is_finite());
+        assert!((normal.length_squared() - 1.0).abs() < 1.0e-5, "{normal:?}");
+        assert!((b - a).dot(normal).abs() < 1.0e-5);
+        assert!(a.is_finite() && b.is_finite());
+    }
+
+    #[test]
+    fn touching_edge_directions_and_separation() {
+        let (hull, cuboid, relative) = shapes();
+        for direction in [
+            None,
+            Some(Vector::X),
+            Some(-Vector::X),
+            Some(Vector::Y),
+            Some(-Vector::Y),
+            Some(Vector::Z),
+            Some(-Vector::Z),
+        ] {
+            let result = contact_support_map_support_map_with_params(
