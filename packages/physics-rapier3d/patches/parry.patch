+            panic!("the touching pair must retain a contact: {result:?}");
+        };
+        assert!(normal.is_finite());
+        assert!((normal.length_squared() - 1.0).abs() < 1.0e-5, "{normal:?}");
+        assert!((b - a).dot(normal).abs() < 1.0e-5);
+        assert!(a.is_finite() && b.is_finite());
+    }
+
+    #[test]
