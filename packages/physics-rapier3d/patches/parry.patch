+fn cast_shapes_with_known_contact<G1: ?Sized + SupportMap, G2: ?Sized + SupportMap>(
+    pos12: &Pose,
+    vel12: Vector,
+    g1: &G1,
+    g2: &G2,
+    options: ShapeCastOptions,
+    contact: crate::query::Contact,
+) -> Option<ShapeCastHit> {
+    if options.max_time_of_impact < 0.0 {
+        return None;
+    }
+    if contact.dist <= options.target_distance {
+        if !options.stop_at_penetration && contact.normal1.dot(vel12) >= 0.0 {
+            return None;
