+++ b/crates/parry3d/tests/capsule_cuboid_closest_points.rs
@@ -0,0 +1,99 @@
+use parry3d::{
+    math::{Pose, Vector},
+    query,
+    shape::{Capsule, Cuboid},
+};
+fn axis_intersects(a: Vector, b: Vector, h: Vector) -> bool {
+    let mut lo = 0.0_f64;
+    let mut hi = 1.0_f64;
+    for i in 0..3 {
+        let ai = a[i] as f64;
+        let di = b[i] as f64 - ai;
+        let extent = h[i] as f64;
+        if di == 0.0 {
+            if ai < -extent || ai > extent {
+                return false;
+            }
+        } else {
+            let u = (-extent - ai) / di;
+            let v = (extent - ai) / di;
+            lo = lo.max(u.min(v));
+            hi = hi.min(u.max(v));
+        }
+    }
+    lo <= hi
+}
+#[test]
+fn segment_box_contacts_satisfy_closest_point_optimality() {
+    let mut checked = 0;
+    for scale in [0.01, 0.1, 1.0, 10.0, 100.0] {
+        let half = Vector::new(1.5, 0.75, 0.5) * scale;
+        let cuboid = Cuboid::new(half);
+        for endpoint in [
+            Vector::new(0.0, 0.55, 0.0),
+            Vector::new(0.6, 0.3, -0.4),
+            Vector::ZERO,
+        ] {
+            let capsule = Capsule::new(-endpoint * scale, endpoint * scale, 0.38 * scale);
+            for x in [-3.0, -1.4, -0.3, 0.1, 1.4, 3.0] {
+                for y in [-2.0, -0.7, -0.1, 0.3, 0.7, 2.0] {
+                    for z in [-2.0, -0.4, 0.1, 0.4, 2.0] {
+                        let pose = Pose::translation(x * scale, y * scale, z * scale);
+                        let a = pose * capsule.segment.a;
+                        let b = pose * capsule.segment.b;
+                        if axis_intersects(a, b, half) {
+                            continue;
+                        }
+                        let c = query::contact(&Pose::IDENTITY, &cuboid, &pose, &capsule, f32::MAX)
+                            .unwrap()
+                            .unwrap();
+                        let q = c.point2 + c.normal1 * capsule.radius;
+                        let d = b - a;
+                        let s = if d.length_squared() > 0.0 {
+                            (q - a).dot(d) / d.length_squared()
+                        } else {
+                            0.0
+                        };
+                        let tolerance = scale * 2.0e-5;
+                        assert!(
+                            s >= -2.0e-5 && s <= 1.00002,
+                            "axis parameter outside segment: s={s}, scale={scale} xyz={x},{y},{z}, endpoint={endpoint:?}, contact={c:?}, q={q:?}, a={a:?}, b={b:?}"
+                        );
+                        assert!(
+                            (q - (a + d * s)).length() <= tolerance,
+                            "axis error={} tolerance={tolerance} scale={scale} xyz={x},{y},{z} endpoint={endpoint:?} contact={c:?} a={a:?} b={b:?} q={q:?} s={s}", (q-(a+d*s)).length()
+                        );
+                        let closest = q.clamp(-half, half);
+                        assert!(
+                            (c.point1 - closest).length() <= tolerance,
+                            "box witness is not closest to axis witness"
+                        );
+                        let derivative = (q - c.point1).dot(d);
+                        let bound = scale * scale * 3.0e-5;
+                        if s > 2.0e-5 && s < 0.99998 {
+                            assert!(
+                                derivative.abs() <= bound,
+                                "interior optimum derivative {derivative}"
+                            );
+                        } else if s <= 2.0e-5 {
+                            assert!(
+                                derivative >= -bound,
+                                "start optimum derivative {derivative}"
+                            );
+                        } else {
+                            assert!(derivative <= bound, "end optimum derivative {derivative}");
+                        }
+                        let signed = (c.point2 - c.point1).dot(c.normal1);
+                        assert!(
+                            (signed - c.dist).abs() <= tolerance,
+                            "normal, distance and witnesses disagree"
+                        );
+                        assert!((c.normal1.length() - 1.0).abs() < 2.0e-6);
+                        checked += 1;
+                    }
+                }
+            }
+        }
+    }
+    println!("verified {checked} closest-point KKT certificates");
+}
