+use parry3d::math::Vector;
+use parry3d::query::{PointQuery, PointQueryWithLocation};
+use parry3d::shape::{Segment, Triangle};
+
+#[test]
+fn thin_triangle_projection_stays_inside_and_is_no_farther_than_edges() {
+    for length in [0.1, 1.0, 10.0, 100.0] {
+        for ratio in [1.0e-3, 1.0e-4, 1.0e-5, 1.0e-6] {
+            for skew in [0.0, 0.5, 1.0, 2.0] {
+                let a = Vector::new(-length, 0.0, -length);
+                let b = Vector::new(length, 0.0, length);
+                let c = Vector::new(length * skew, length * ratio, length * skew);
+                for t in 0..101 {
+                    for offset in [-2.0, -1.0, 0.0, 0.5, 1.0, 2.0] {
+                        let pt = a
+                            + (b - a) * (t as f32 / 100.0)
+                            + Vector::new(0.0, length * ratio * offset, length * ratio);
+                        let triangle = Triangle::new(a, b, c);
+                        let (proj, loc) = triangle.project_local_point_and_get_location(pt, true);
+                        let coords = loc.barycentric_coordinates().unwrap();
+                        assert!(
+                            coords
+                                .iter()
+                                .all(|v| v.is_finite() && *v >= -1.0e-5 && *v <= 1.00001),
+                            "invalid barycentric {coords:?}; {triangle:?}, {pt:?}"
+                        );
+                        for (u, v) in [(a, b), (b, c), (a, c)] {
+                            let edge = Segment::new(u, v).project_local_point(pt, true).point;
+                            assert!(
+                                (proj.point - pt).length()
+                                    <= (edge - pt).length() + length * 1.0e-6,
+                                "farther than edge; {triangle:?}, {pt:?}, {proj:?}"
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn oblique_thin_triangle_boundary_has_valid_barycentrics() {
+    let triangle = Triangle::new(
+        Vector::new(-7.1746826, -0.00009995699, -7.17358),
+        Vector::new(16.830624, -0.00013744831, 16.82804),
+        Vector::new(16.828835, -0.00011879206, 16.828178),
+    );
+    let ab = triangle.b - triangle.a;
+    let ac = triangle.c - triangle.a;
+    let normal = ab.cross(ac).normalize();
+    for t in -2..103 {
+        for u in [-0.001, 0.0, 0.001, 0.5, 0.999, 1.0, 1.001] {
+            for d in [-0.01, -0.0001, 0.0, 0.0001, 0.01] {
+                let pt = triangle.a + ab * (t as f32 / 100.0) + ac * u + normal * d;
+                let (proj, loc) = triangle.project_local_point_and_get_location(pt, true);
+                let coords = loc.barycentric_coordinates().unwrap();
+                assert!(
+                    coords
+                        .iter()
+                        .all(|v| v.is_finite() && *v >= -1.0e-5 && *v <= 1.00001),
+                    "invalid barycentric {coords:?} at {pt:?}; {proj:?}"
+                );
+                for (a, b) in [
+                    (triangle.a, triangle.b),
+                    (triangle.b, triangle.c),
+                    (triangle.a, triangle.c),
+                ] {
+                    let edge = Segment::new(a, b).project_local_point(pt, true).point;
+                    assert!(
+                        (proj.point - pt).length() <= (edge - pt).length() + 3.0e-6,
+                        "farther than edge at {pt:?}: {proj:?}"
+                    );
+                }
+            }
+        }
+    }
+}
