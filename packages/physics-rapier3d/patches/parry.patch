+// The arclength of any point about the COM bounds its displacement from the
+// start orientation. Linear translation remains covered by the existing DDA.
+#[cfg(feature = "dim3")]
+fn temporal_rotation_bound(
+    shape: &dyn Shape, motion: &NonlinearRigidMotion, start_pose: &crate::math::Pose,
+    start: Real, end: Real, radius: Real, sphere_bound: Aabb,
+) -> Aabb {
+    // Custom shape callbacks retain their original observations and failure path.
+    let builtin = shape.as_ball().is_some() || shape.as_cuboid().is_some()
+        || shape.as_capsule().is_some() || shape.as_segment().is_some()
+        || shape.as_triangle().is_some();
+    #[cfg(feature = "dim3")]
+    let builtin = builtin || shape.as_convex_polyhedron().is_some();
+    let angular_speed_squared = motion.angvel.length_squared();
+    let angular_speed = angular_speed_squared.sqrt();
+    let duration = end - start;
+    if !builtin || !start.is_finite() || !end.is_finite() || duration <= 0.0
+        // A subnormal squared norm has no useful relative error bound.
+        || !angular_speed_squared.is_normal() || !angular_speed.is_finite() || !radius.is_finite() || radius < 0.0
+        || !sphere_bound.mins.is_finite() || !sphere_bound.maxs.is_finite() {
+        return sphere_bound;
+    }
+    let angle = angular_speed * duration;
+    if !angle.is_finite() || angle >= 1.0 { return sphere_bound; }
+    let start_bound = shape.compute_aabb(start_pose);
+    if !start_bound.mins.is_finite() || !start_bound.maxs.is_finite() { return sphere_bound; }
+    let time_scale = start.abs() + end.abs();
+    let spatial_scale = start_bound.mins.abs().max_element().max(start_bound.maxs.abs().max_element())
+        + radius + motion.linvel.abs().max_element() * time_scale + 1.0;
+    let roundoff = 32.0 * Real::EPSILON * (spatial_scale + radius * angular_speed * time_scale);
+    let margin = radius * angle + roundoff;
+    if !margin.is_finite() { return sphere_bound; }
+    let local_bound = start_bound.loosened(margin);
+    let mins = local_bound.mins.max(sphere_bound.mins);
+    let maxs = local_bound.maxs.min(sphere_bound.maxs);
+    if mins.is_finite() && maxs.is_finite() && (mins.cmple(maxs)).all() {
+        Aabb::new(mins, maxs)
+    } else { sphere_bound }
 }
 
