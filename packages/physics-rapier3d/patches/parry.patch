+use parry3d::math::{IVector, Pose, Rotation, Vector};
+use parry3d::query::PointQuery;
+use parry3d::shape::Voxels;
+
+fn assert_reference(voxels: &Voxels, point: Vector) {
+    let expected_inside = voxels
+        .voxels()
+        .any(|v| voxels.voxel_aabb(v.grid_coords).contains_local_point(point));
+    let result = voxels.project_local_point(point, true);
+    assert_eq!(
+        result.is_inside, expected_inside,
+        "point={point:?}, result={result:?}"
+    );
+    assert_eq!(voxels.contains_local_point(point), expected_inside);
+    if expected_inside {
+        assert_eq!(result.point, point);
+    } else {
+        let distance = voxels
+            .voxels()
+            .map(|v| {
+                voxels
+                    .voxel_aabb(v.grid_coords)
+                    .distance_to_local_point(point, true)
+            })
+            .fold(f32::MAX, f32::min);
+        assert!(
+            (result.point.distance(point) - distance).abs()
+                <= 4.0 * f32::EPSILON * (1.0 + distance)
+        );
+    }
+}
