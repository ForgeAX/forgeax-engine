+use parry3d::math::{IVector, Pose, Rotation, Vector};
+use parry3d::query::{cast_shapes_nonlinear, NonlinearRigidMotion};
+use parry3d::shape::{Cuboid, Voxels};
+
+#[test]
+fn continuous_queries_match_the_occupied_solid() {
+    let voxels = Voxels::from_regions(Vector::splat(0.1), &[[IVector::ZERO, IVector::splat(8)]]);
+    let solid = Cuboid::new(Vector::splat(0.4));
+    let fast = Cuboid::new(Vector::new(0.09, 0.15, 0.05));
+    let mut cases = 0;
+    for shift in [Vector::ZERO, Vector::new(90.0, 14.0, 35.0)] {
+        let grid =
+            NonlinearRigidMotion::constant_position(Pose::from_parts(shift, Rotation::IDENTITY));
+        let whole = grid.prepend_translation(Vector::splat(0.4));
+        for origin_x in [-0.5, -0.06, 0.04, 0.4, 0.76, 0.86, 1.3] {
+            for velocity in [-20.0, -1.0, 1.0, 20.0] {
+                for angular in [0.0, 0.2, -2.0, 8.0] {
+                    for stop in [false, true] {
+                        let motion = NonlinearRigidMotion::new(
+                            Pose::from_parts(
+                                shift + Vector::new(origin_x, 0.4, 0.4),
+                                Rotation::from_rotation_y(0.37),
+                            ),
+                            Vector::new(0.01, -0.02, 0.0),
+                            Vector::X * velocity,
+                            Vector::Y * angular,
+                        );
+                        let query =
+                            |shape: &dyn parry3d::shape::Shape, grid: &NonlinearRigidMotion| {
+                                cast_shapes_nonlinear(grid, shape, &motion, &fast, 0.0, 0.1, stop)
+                                    .unwrap()
+                                    .map(|h| h.time_of_impact)
+                            };
+                        let expected = query(&solid, &whole);
+                        let actual = query(&voxels, &grid);
+                        assert_eq!(actual.is_some(), expected.is_some(), "shift={shift:?} x={origin_x} velocity={velocity} angular={angular} stop={stop} actual={actual:?} expected={expected:?}");
+                        if let (Some(a), Some(b)) = (actual, expected) {
+                            assert!((a-b).abs()<0.0001, "x={origin_x} velocity={velocity} angular={angular} stop={stop} actual={a} expected={b}");
+                        }
+                        cases += 1;
+                    }
+                }
+            }
+        }
+    }
+    assert_eq!(cases, 448);
+}
