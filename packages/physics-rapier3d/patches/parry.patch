+    fn shapes() -> (ConvexPolyhedron, Cuboid, Pose) {
+        // Captured Hull/Cuboid child pair at first native admission. The CSO
+        // reaches the origin on a Z edge, not on a full triangular facet.
+        let vertices = [
+            Vector::new(2.9, 0.9, 1.4),
+            Vector::new(3.0, 0.9, 1.4),
+            Vector::new(2.9, 1.0, 1.4),
