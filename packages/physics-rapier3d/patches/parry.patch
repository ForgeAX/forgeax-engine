+use parry3d::{
+    math::{Pose, Vector},
+    query::{self, ShapeCastOptions},
+    shape::{Capsule, Cuboid},
+};
+#[test]
+fn flat_face_normal_and_real_approach() {
+    let wall = Cuboid::new(Vector::new(1.5, 0.75, 0.5));
+    let wall_pose = Pose::translation(-1., 1.25, 1.);
+    let capsule = Capsule::new_y(0.55, 0.38);
+    let pose = Pose::translation(-1.2755274, 2.46, 1.9099997);
+    let c = query::contact(&wall_pose, &wall, &pose, &capsule, 1.)
+        .unwrap()
+        .unwrap();
+    println!("contact={c:?}");
+    for approach in [0., 0.00001, 0.0001, 0.0005, 0.001, 0.01] {
+        let hit = query::cast_shapes(
+            &wall_pose,
+            Vector::ZERO,
+            &wall,
+            &pose,
+            Vector::new(0., 1., -approach),
+            &capsule,
+            ShapeCastOptions {
+                target_distance: 0.03,
+                max_time_of_impact: 0.53,
+                stop_at_penetration: false,
+                compute_impact_geometry_on_penetration: true,
+            },
+        )
+        .unwrap();
+        println!("approach={approach} hit={hit:?}");
+        if approach > 0. {
+            assert!(hit.is_some());
+        }
+    }
+    assert_eq!(
+        c.normal1.y, 0.,
+        "closest contact is in the vertical face interior"
+    );
+}
