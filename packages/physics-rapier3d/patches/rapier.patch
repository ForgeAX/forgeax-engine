+fn query_fixture() -> (
+    RigidBodySet,
+    ColliderSet,
+    BroadPhaseBvh,
+    ColliderHandle,
+    ColliderHandle,
+    rapier3d::geometry::SharedGeometryHandle,
+) {
+    let bodies = RigidBodySet::new();
+    let mut colliders = ColliderSet::new();
+    let mut broad_phase = BroadPhaseBvh::new();
+    let shared =
+        colliders.insert(ColliderBuilder::ball(0.25).translation(Vector::new(5.0, 0.0, 0.0)));
+    let ordinary =
+        colliders.insert(ColliderBuilder::ball(0.5).translation(Vector::new(9.0, 0.0, 0.0)));
+    for handle in [shared, ordinary] {
+        broad_phase.set_aabb(
+            &IntegrationParameters::default(),
+            handle,
+            colliders
+                .resolved_shape(handle)
+                .unwrap()
+                .compute_aabb(colliders[handle].position()),
+        );
+    }
+    let geometry = colliders.shared_geometry.insert(SharedShape::ball(0.5));
+    assert!(colliders.bind_shared_geometry(shared, geometry, Vector::ONE));
+    (bodies, colliders, broad_phase, shared, ordinary, geometry)
+}
