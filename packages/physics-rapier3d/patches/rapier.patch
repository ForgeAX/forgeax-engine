+#[test]
+fn scale_cache_has_count_and_allocation_budgets_and_follows_version_lifetime() {
+    use rapier3d::parry::utils::Array2;
+    use std::sync::Arc;
+    let mut geometries = SharedGeometrySet::new();
+    let geometry = geometries.insert(SharedShape::heightfield(
+        Array2::repeat(512, 512, 0.0),
+        Vector::ONE,
+    ));
+    let version = geometries.capture(geometry).unwrap();
+    let scale = Vector::new(2.0, 3.0, 4.0);
+    let begin = std::time::Instant::now();
+    let first = version.scaled_shape(scale).unwrap();
+    let first_time = begin.elapsed();
+    let second = version.scaled_shape(scale).unwrap();
+    assert!(Arc::ptr_eq(&first.0, &second.0));
+    assert_eq!(
+        version.scale_cache_usage(),
+        (1, first.storage_bytes().unwrap())
+    );
+    let retained = Arc::downgrade(&first.0);
+    drop(first);
+    drop(second);
+    for x in 3..16 {
+        let _ = version
+            .scaled_shape(Vector::new(x as f32, 3.0, 4.0))
+            .unwrap();
+        let (count, bytes) = version.scale_cache_usage();
+        assert!(count <= 8);
+        assert!(bytes <= rapier3d::geometry::SharedGeometryVersion::SCALE_CACHE_BYTES);
+    }
+    assert!(
+        retained.upgrade().is_none(),
+        "eviction releases derived geometry"
+    );
+    let final_shape = version.scaled_shape(scale).unwrap();
+    let retired = Arc::downgrade(&final_shape.0);
+    drop(final_shape);
+    assert!(geometries.adopt(geometry, SharedShape::ball(1.0)));
+    assert_eq!(
+        geometries.get(geometry).unwrap().scale_cache_usage(),
+        (0, 0)
+    );
+    drop(geometries.take_changes());
+    assert!(
+        retired.upgrade().is_some(),
+        "the old fixed version retains its cache"
+    );
+    drop(version);
+    assert!(
+        retired.upgrade().is_none(),
+        "the last fixed version releases its cache"
+    );
+    eprintln!("first 512x512 scaled heightfield preparation: {first_time:?}");
+
+    let oversized = geometries.insert(SharedShape::heightfield(
+        Array2::repeat(2048, 2048, 0.0),
+        Vector::ONE,
+    ));
+    let version = geometries.get(oversized).unwrap();
+    let one_query = version.scaled_shape(scale).unwrap();
+    assert!(
+        one_query.storage_bytes().unwrap()
+            > rapier3d::geometry::SharedGeometryVersion::SCALE_CACHE_BYTES
+    );
+    assert_eq!(
+        version.scale_cache_usage(),
+        (0, 0),
+        "oversized variants are never retained"
+    );
+}
