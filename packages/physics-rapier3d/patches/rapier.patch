+            return Err(JsValue::from_str("Invalid voxel edit coordinates"));
+        }
+        self.map_mut(handle, |co| {
+            let vox = co.shape_mut().as_voxels_mut()
+                .ok_or_else(|| JsValue::from_str("Collider is not a voxel shape"))?;
+            let mut changed = 0;
+            for c in coords.chunks_exact(3) {
+                if vox.set_voxel(IVector::from_slice(c), filled).is_empty() == filled { changed += 1; }
+            }
+            Ok(changed)
+        })
+    }
