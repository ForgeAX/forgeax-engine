+    #[test]
+    fn flat_contact_keeps_horizontal_motion_with_rounded_normals() {
+        use super::EffectiveCharacterMovement;
+        use parry::query::ShapeCastStatus;
+
+        // A cast normal may differ from unit length by one floating-point ULP.
+        // When the surface normal is parallel to up, every horizontal direction
+        // belongs to the surface tangent plane, not a zero-dimensional tangent.
+        for up in [Vector::Y, -Vector::Y, Vector::X, -Vector::Z] {
+            let controller = KinematicCharacterController {
+                up,
+                ..Default::default()
+            };
+            let horizontal = if up.x.abs() == 1.0 {
+                Vector::Z * 0.09
+            } else {
+                Vector::X * 0.09
+            };
+            let desired = horizontal - up * 0.0046200668;
+            for normal_length in [
+                1.0,
+                f32::from_bits(1.0_f32.to_bits() - 1),
+                f32::from_bits(1.0_f32.to_bits() + 1),
+            ] {
+                let hit = controller.compute_hit_info(ShapeCastHit {
+                    time_of_impact: 0.0,
+                    normal1: up * normal_length,
+                    normal2: -up * normal_length,
+                    witness1: Vector::ZERO,
+                    witness2: Vector::ZERO,
+                    status: ShapeCastStatus::Converged,
+                });
+                let mut result = EffectiveCharacterMovement {
+                    translation: Vector::ZERO,
+                    grounded: true,
+                    is_sliding_down_slope: false,
+                };
+                let actual = controller.handle_slopes(&hit, desired, desired, 0.0, &mut result);
+                assert!(
+                    (actual.dot(horizontal.normalize()) - horizontal.length()).abs() < 1.0e-6,
+                    "up={up:?}, normal_length={normal_length}: lost horizontal motion {actual:?}"
+                );
+            }
+        }
+    }
