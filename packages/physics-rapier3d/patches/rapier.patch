+#[test]
+fn shape_adoption_is_shared_and_old_versions_remain_fixed() {
+    let mut geometries = SharedGeometrySet::new();
+    let geometry = geometries.insert(SharedShape::ball(0.5));
+    let old = geometries.capture(geometry).unwrap();
+    for collider in 0..32768 {
+        assert!(geometries.set_instance(
+            geometry,
+            collider,
+            AffineTransform {
+                rows: [Vector::X, Vector::Y, Vector::Z],
+                translation: Vector::new(collider as f32 * 10.0, 0.0, 0.0),
+            }
+        ));
+    }
+    let region = Aabb::new(Vector::new(1.0, -0.1, -0.1), Vector::new(1.5, 0.1, 0.1));
+    assert_eq!(geometries.intersect_aabb(&region).count(), 0);
+    assert!(geometries.adopt(geometry, SharedShape::ball(2.0)));
+    assert_eq!(
+        geometries.intersect_aabb(&region).collect::<Vec<_>>(),
+        vec![(geometry, 0)]
+    );
+    let current = geometries.get(geometry).unwrap();
+    let ray = Ray::new(Vector::new(1.0, 3.0, 0.0), -Vector::Y);
+    assert!(old
+        .shape
+        .cast_ray(&Pose::IDENTITY, &ray, 10.0, false)
+        .is_none());
+    assert!(current
+        .shape
+        .cast_ray(&Pose::IDENTITY, &ray, 10.0, false)
+        .is_some());
+    assert_eq!(old.shape.as_ball().unwrap().radius, 0.5);
+    assert_eq!(current.shape.as_ball().unwrap().radius, 2.0);
+    assert!(current.unit_mass.mass() > old.unit_mass.mass());
+    let changes = geometries.take_changes();
+    assert_eq!(changes.len(), 1);
+    assert_eq!(changes[0].previous.revision, 0);
+    assert_eq!(changes[0].current.revision, 1);
+    assert_eq!(geometries.take_changes().len(), 0);
+    assert!(!geometries.remove(geometry));
+}
