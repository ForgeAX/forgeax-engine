+#[test]
+fn heightfield_partial_tiles_preserve_column_major_edges_without_padding_skinny_fields() {
+    use rapier3d::parry::{shape::HeightField, utils::Array2};
+    for (rows, columns) in [(2, 1000), (1000, 2), (35, 37)] {
+        let samples = Array2::from_fn(rows, columns, |i, j| (i + j * rows) as f32);
+        let expected = samples.data().to_vec();
+        let mut field = HeightField::new(samples, Vector::ONE);
+        let fixed = field.clone();
+        let shape = SharedShape::new(field.clone());
+        assert!(shape.storage_bytes().unwrap() < expected.len() * 16 + 8192);
+        assert_eq!(field.heights().to_vec(), expected);
+        let indices = [
+            0,
+            (rows - 1) as u32,
+            (rows * (columns - 1)) as u32,
+            (rows * columns - 1) as u32,
+        ];
+        assert!(field.write_heights(&indices, &[-1.0, -2.0, -3.0, -4.0]));
+        assert_eq!(fixed.heights().to_vec(), expected);
+        let changed = field.heights().to_vec();
+        for (index, value) in indices.into_iter().zip([-1.0, -2.0, -3.0, -4.0]) {
+            assert_eq!(changed[index as usize], value);
+        }
+        assert!(field.triangles_at(rows - 2, columns - 2).0.is_some());
+    }
+}
