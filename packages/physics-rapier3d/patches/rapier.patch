+#[test]
+fn heightfield_query_and_region_costs_are_measured_on_real_triangles() {
+    use rapier3d::parry::utils::Array2;
+    use std::{hint::black_box, time::Instant};
+    for n in [128, 1024] {
+        let mut field =
+            rapier3d::parry::shape::HeightField::new(Array2::repeat(n, n, 1.0), Vector::ONE);
+        let flat = Array2::repeat(n, n, 1.0f32);
+        let count = 200_000;
+        let begin = Instant::now();
+        let mut sum = 0.0;
+        for i in 0..count {
+            let row = i % (n - 1);
+            let col = (i * 37) % (n - 1);
+            sum += black_box(flat[(row, col)])
+                + black_box(flat[(row + 1, col)])
+                + black_box(flat[(row, col + 1)])
+                + black_box(flat[(row + 1, col + 1)]);
+        }
+        black_box(sum);
+        let flat_time = begin.elapsed();
+        let begin = Instant::now();
+        for i in 0..count {
+            black_box(field.triangles_at(i % (n - 1), (i * 37) % (n - 1)));
+        }
+        let query_time = begin.elapsed();
+        let begin = Instant::now();
+        let (_, bytes) = allocations(|| {
+            for i in 0..1000 {
+                let old = field.clone();
+                assert!(field.write_heights(&[(i % (n * n)) as u32], &[2.0]));
+                black_box(old);
+            }
+        });
+        eprintln!("heightfield n={n}, samples baseline={flat_time:?}, actual 200k cell triangles={query_time:?}, 1000 retained regional writes={:?}, allocations={bytes}", begin.elapsed());
+        assert!(bytes < 1000 * 8192);
+    }
+}
