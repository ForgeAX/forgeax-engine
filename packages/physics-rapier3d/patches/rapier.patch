+#[derive(Default)]
+struct SolveFixture {
+    pipeline: PhysicsPipeline,
+    islands: IslandManager,
+    bodies: RigidBodySet,
+    colliders: ColliderSet,
+    broad: BroadPhaseBvh,
+    narrow: NarrowPhase,
+    joints: ImpulseJointSet,
+    multibodies: MultibodyJointSet,
+    ccd: CCDSolver,
+}
+
+impl SolveFixture {
+    fn step(&mut self, gravity: Vector, dt: f32) {
+        self.pipeline.step(
+            gravity,
+            &IntegrationParameters {
+                dt,
+                ..Default::default()
+            },
+            &mut self.islands,
+            &mut self.broad,
+            &mut self.narrow,
+            &mut self.bodies,
+            &mut self.colliders,
+            &mut self.joints,
+            &mut self.multibodies,
+            &mut self.ccd,
+            &(),
+            &(),
+        );
+    }
+
+    fn shared(
+        &mut self,
+        body: Option<RigidBodyHandle>,
+        shape: SharedShape,
+    ) -> (ColliderHandle, rapier3d::geometry::SharedGeometryHandle) {
+        let collider = match body {
+            Some(body) => self.colliders.insert_with_parent(
+                ColliderBuilder::ball(0.5),
+                body,
+                &mut self.bodies,
+            ),
+            None => self.colliders.insert(ColliderBuilder::ball(0.5)),
+        };
+        let geometry = self.colliders.shared_geometry.insert(shape);
+        assert!(self
+            .colliders
+            .bind_shared_geometry(collider, geometry, Vector::ONE));
+        (collider, geometry)
+    }
+}
