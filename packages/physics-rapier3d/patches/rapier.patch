+    assert_eq!(changes[0].current.revision, 2);
+    assert!(geometries.remove(first));
+    let second = geometries.insert(SharedShape::ball(1.0));
+    assert_ne!(first, second);
+    assert!(!geometries.adopt(first, SharedShape::ball(100.0)));
+    assert_eq!(
+        geometries
+            .get(second)
+            .unwrap()
+            .shape
+            .as_ball()
+            .unwrap()
+            .radius,
+        1.0
+    );
+}
