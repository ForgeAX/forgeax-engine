+use rapier3d::parry::{
+    query::{NonlinearRigidMotion, ShapeCastOptions},
+    shape::Ball,
+};
+use rapier3d::prelude::*;
+use rapier3d::{
+    geometry::{Aabb, SharedGeometrySet, SharedShape},
+    math::{Pose, Vector},
+    parry::{partitioning::AffineTransform, query::Ray},
+};
