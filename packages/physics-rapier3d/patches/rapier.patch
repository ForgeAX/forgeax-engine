+#[test]
+fn unchanged_bounds_still_publish_changed_geometry_and_recycled_handles_are_fenced() {
+    let mut geometries = SharedGeometrySet::new();
+    let first = geometries.insert(SharedShape::ball(1.0));
+    assert!(geometries.adopt(first, SharedShape::cuboid(1.0, 1.0, 1.0)));
+    assert!(geometries.adopt(first, SharedShape::ball(1.0)));
+    let changes = geometries.take_changes();
+    assert_eq!(changes.len(), 1);
