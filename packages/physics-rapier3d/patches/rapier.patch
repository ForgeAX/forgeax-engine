+#[test]
+fn two_regional_roots_query_each_others_unchanged_surface() {
+    for small_second_root in [false, true] {
+        let mut groups = SharedGeometrySet::new();
+        let a = groups.insert(terrain_shape(65));
+        let b = groups.insert(terrain_shape(if small_second_root { 2 } else { 65 }));
+        let transform = AffineTransform {
+            rows: [Vector::X, Vector::Y, Vector::Z],
+            translation: Vector::ZERO,
+        };
+        groups.set_instance(a, 1, transform);
+        groups.set_instance(
+            b,
+            2,
+            AffineTransform {
+                translation: if small_second_root {
+                    Vector::new(10.0, 0.0, 10.0)
+                } else {
+                    Vector::ZERO
+                },
+                ..transform
+            },
+        );
+        assert!(groups.write_heightfield(
+            a,
+            &[if small_second_root {
+                50 * 65 + 50
+            } else {
+                10 * 65 + 10
+            }],
+            &[2.0]
+        ));
+        assert!(groups.write_heightfield(
+            b,
+            &[if small_second_root { 0 } else { 50 * 65 + 50 }],
+            &[3.0]
+        ));
+        let changed = groups.take_changes();
+        assert!(groups.changed_pairs(&changed, &rapier3d::parry::partitioning::Bvh::new()).contains(&(1, 2)),
+            "a changed region must query the other root's whole shape, even when that root also changed elsewhere");
+    }
+}
