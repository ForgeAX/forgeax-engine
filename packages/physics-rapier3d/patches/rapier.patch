+    /// Copies occupied storage and applies a local edit without touching the source collider.
+    #[cfg(feature = "dim3")]
+    pub fn coCopyVoxels(&self, handle: FlatHandle, removed: &[i32], added: &[i32]) -> Result<RawShape, JsValue> {
+        for coords in [removed, added] {
+            if coords.len() % 3 != 0 || coords.iter().any(|v| *v < i32::MIN + 8 || *v > i32::MAX - 8) {
+                return Err(JsValue::from_str("Invalid voxel copy coordinates"));
+            }
+        }
+        let collider = self.0.get(utils::collider_handle(handle))
+            .ok_or_else(|| JsValue::from_str("Voxel source collider no longer exists"))?;
+        let mut voxels = collider.shape().as_voxels()
+            .ok_or_else(|| JsValue::from_str("Collider is not a voxel shape"))?.clone();
+        for c in removed.chunks_exact(3) { voxels.set_voxel(IVector::from_slice(c), false); }
+        for c in added.chunks_exact(3) { voxels.set_voxel(IVector::from_slice(c), true); }
+        Ok(RawShape(rapier::geometry::SharedShape::new(voxels)))
+    }
+
+    /// Applies one homogeneous edit batch, returning the number of changed cells.
