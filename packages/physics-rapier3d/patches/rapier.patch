+#[test]
+fn queries_resolve_latest_geometry_and_merge_both_hierarchy_levels() {
+    let (bodies, mut colliders, broad_phase, shared, ordinary, geometry) = query_fixture();
+    let narrow_phase = NarrowPhase::new();
+    let ray = Ray::new(Vector::ZERO, Vector::X);
+    let query = broad_phase.as_query_pipeline(
+        narrow_phase.query_dispatcher(),
+        &bodies,
+        &colliders,
+        QueryFilter::default(),
+    );
+    assert_eq!(query.cast_ray(&ray, 20.0, true), Some((shared, 4.5)));
+    assert_eq!(
+        query
+            .with_filter(QueryFilter::default().exclude_collider(shared))
+            .cast_ray(&ray, 20.0, true),
+        Some((ordinary, 8.5))
+    );
+    assert_eq!(
+        query
+            .project_point(Vector::new(8.0, 0.0, 0.0), 10.0, false)
+            .unwrap()
+            .0,
+        ordinary
+    );
+    assert!(query.project_point(Vector::ZERO, 1.0, true).is_none());
+    assert!(colliders
+        .shared_geometry
+        .adopt(geometry, SharedShape::ball(2.0)));
+    let query = broad_phase.as_query_pipeline(
+        narrow_phase.query_dispatcher(),
+        &bodies,
+        &colliders,
+        QueryFilter::default(),
+    );
+    let (handle, normal) = query.cast_ray_and_get_normal(&ray, 20.0, true).unwrap();
+    assert_eq!(handle, shared);
+    assert_eq!(normal.time_of_impact, 3.0);
+    assert_eq!(normal.normal, -Vector::X);
+    let mut hits = query
+        .intersect_ray(ray, 20.0, true)
+        .map(|(h, _, _)| h)
+        .collect::<Vec<_>>();
+    hits.sort_by_key(|h| h.into_raw_parts());
+    assert_eq!(
+        hits.len(),
+        2,
+        "the old ordinary shared-instance leaf must not duplicate hits"
+    );
+    assert_eq!(
+        query
+            .intersect_point(Vector::new(6.5, 0.0, 0.0))
+            .map(|(h, _)| h)
+            .collect::<Vec<_>>(),
+        vec![shared]
+    );
+    let region = Aabb::new(Vector::new(6.4, -0.1, -0.1), Vector::new(6.6, 0.1, 0.1));
+    assert_eq!(
+        query
+            .intersect_aabb_conservative(region)
+            .map(|(h, _)| h)
+            .collect::<Vec<_>>(),
+        vec![shared]
+    );
+    let (_, projection, _) = query
+        .project_point_and_get_feature(Vector::new(2.0, 0.0, 0.0), 10.0)
+        .unwrap();
+    assert_eq!(projection.point, Vector::new(3.0, 0.0, 0.0));
+    let ball = Ball::new(0.5);
+    assert_eq!(
+        query
+            .intersect_shape(Pose::translation(7.25, 0.0, 0.0), &ball)
+            .map(|(h, _)| h)
+            .collect::<Vec<_>>(),
+        vec![shared]
+    );
+    let (handle, linear) = query
+        .cast_shape(
+            &Pose::IDENTITY,
+            Vector::X,
+            &ball,
+            ShapeCastOptions {
+                max_time_of_impact: 20.0,
+                ..Default::default()
+            },
+        )
+        .unwrap();
+    assert_eq!(handle, shared);
+    assert!((linear.time_of_impact - 2.5).abs() < 1.0e-4);
+    assert!((linear.witness1 - Vector::new(3.0, 0.0, 0.0)).length() < 1.0e-4);
+    let motion = NonlinearRigidMotion::new(Pose::IDENTITY, Vector::ZERO, Vector::X, Vector::ZERO);
+    let (handle, nonlinear) = query
+        .cast_shape_nonlinear(&motion, &ball, 0.0, 20.0, true)
+        .unwrap();
+    assert_eq!(handle, shared);
+    assert!((nonlinear.time_of_impact - 2.5).abs() < 1.0e-3);
+    assert!((nonlinear.witness1 - linear.witness1).length() < 1.0e-3);
+}
