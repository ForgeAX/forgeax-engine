new file mode 100644
index 0000000..05dbd13
--- /dev/null
+++ b/src/geometry/shared_geometry.rs
@@ -0,0 +1,548 @@
+//! Shared geometry publication and its instance spatial index.
+//!
+//! A geometry edit replaces one immutable root and refits its one top-level
+//! leaf. Instance rows are touched only by their own lifecycle/pose changes or
+//! by an actual spatial query. The solver consumes changed geometry groups,
+//! not a fan-out list of collider dirty/wake commands.
+
+use crate::alloc_prelude::*;
+use crate::data::arena::{Arena, Index};
+use crate::geometry::{Aabb, BoundingVolume, SharedShape};
+use crate::math::{Real, Vector, DIM};
+use alloc::sync::Arc;
+use parry::mass_properties::MassProperties;
+use parry::partitioning::{AffineBvh, AffineTransform, Bvh, BvhLeafCost};
+#[cfg(feature = "dim3")]
+use parry::shape::Shape;
+use parry::utils::hashmap::HashMap;
+
+/// Generation-checked identity of one geometry in its native owner.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+#[cfg_attr(feature = "serde-serialize", derive(Serialize, Deserialize))]
+pub struct SharedGeometryHandle(pub Index);
+
+/// Immutable shape facts retained together across native submission boundaries.
+#[derive(Debug)]
+#[cfg_attr(feature = "serde-serialize", derive(Serialize, Deserialize))]
+pub struct SharedGeometryVersion {
+    /// Geometry contents shared by every instance.
+    pub shape: SharedShape,
+    /// Bounds from exactly these shape contents.
+    pub local_bounds: Aabb,
+    /// Unit-density mass facts, prepared once for this shape version.
+    pub unit_mass: MassProperties,
+    /// Monotonic identity within this geometry's lifetime.
+    pub revision: u64,
+    #[cfg(feature = "std")]
+    #[cfg_attr(feature = "serde-serialize", serde(skip))]
+    scaled: std::sync::Mutex<ScaleCache>,
+}
+
+#[cfg(feature = "std")]
+#[derive(Debug, Default)]
+struct ScaleCache {
+    values: std::collections::HashMap<[u64; DIM], (SharedShape, usize)>,
+    order: std::collections::VecDeque<[u64; DIM]>,
+    bytes: usize,
+}
+
+impl SharedGeometryVersion {
+    /// Maximum requested shape allocation bytes retained by one version's scale cache.
+    pub const SCALE_CACHE_BYTES: usize = 16 * 1024 * 1024;
+
+    /// Current retained scale count and requested geometry allocation bytes.
+    #[cfg(feature = "std")]
+    pub fn scale_cache_usage(&self) -> (usize, usize) {
+        let cache = self.scaled.lock().unwrap();
+        (cache.values.len(), cache.bytes)
+    }
+    fn new(shape: SharedShape, revision: u64) -> Self {
+        Self {
+            local_bounds: shape.compute_local_aabb(),
+            unit_mass: shape.mass_properties(1.0),
+            shape,
+            revision,
+            #[cfg(feature = "std")]
+            scaled: Default::default(),
+        }
+    }
+
+    /// Prepare only the scale requested by an actual native query or solve.
+    /// This version owns its bounded cache; adoption never enumerates caches.
+    pub fn scaled_shape(&self, scale: Vector) -> Option<SharedShape> {
+        if scale == Vector::ONE {
+            return Some(self.shape.clone());
+        }
+        if !scale.is_finite() || scale.min_element() <= 0.0 {
+            return None;
+        }
+        #[cfg(feature = "std")]
+        let key = core::array::from_fn(|axis| scale[axis].to_bits() as u64);
+        #[cfg(feature = "std")]
+        if let Some((shape, _)) = self.scaled.lock().unwrap().values.get(&key) {
+            return Some(shape.clone());
+        }
+        let shape = SharedShape(Arc::from(self.shape.scale_dyn(scale, 32)?));
+        #[cfg(feature = "std")]
+        {
+            let mut cache = self.scaled.lock().unwrap();
+            // Concurrent first queries may have prepared the same scale. The
+            // accepted immutable value wins; never double-account its storage.
+            if let Some((resident, _)) = cache.values.get(&key) {
+                return Some(resident.clone());
+            }
+            let Some(bytes) = shape.storage_bytes() else {
+                return Some(shape);
+            };
+            if bytes > Self::SCALE_CACHE_BYTES {
+                return Some(shape);
+            }
+            // Count bounds metadata; the byte budget bounds retained mesh/BVH
+            // allocations. Oversized or unknown shapes remain query-local.
+            while cache.values.len() >= 8 || cache.bytes + bytes > Self::SCALE_CACHE_BYTES {
+                let oldest = cache.order.pop_front().unwrap();
+                let (_, retired_bytes) = cache.values.remove(&oldest).unwrap();
+                cache.bytes -= retired_bytes;
+            }
+            cache.order.push_back(key);
+            cache.bytes += bytes;
+            let _ = cache.values.insert(key, (shape.clone(), bytes));
+        }
+        Some(shape)
+    }
+}
+
+#[derive(Clone)]
+#[cfg_attr(feature = "serde-serialize", derive(Serialize, Deserialize))]
+struct GeometryGroup {
+    current: Arc<SharedGeometryVersion>,
+    instances: AffineBvh,
+    previous: Option<Arc<SharedGeometryVersion>>,
+    changed_local: Option<Aabb>,
+}
+
+impl GeometryGroup {
+    fn pending_bounds(&self) -> Aabb {
+        self.previous
+            .as_ref()
+            .map_or(self.current.local_bounds, |previous| {
+                previous.local_bounds.merged(&self.current.local_bounds)
+            })
+    }
+}
+
+/// One changed native geometry and the spatial region its solver query must cover.
+pub struct SharedGeometryChange {
+    /// Geometry identity, never an instance list.
+    pub geometry: SharedGeometryHandle,
+    /// First version replaced since the preceding solver boundary.
+    pub previous: Arc<SharedGeometryVersion>,
+    /// Complete newly accepted geometry.
+    pub current: Arc<SharedGeometryVersion>,
+    /// Local cells or complete shape support that changed.
+    pub changed_local: Aabb,
+    /// Union of old and new group bounds, including support that disappeared.
+    pub affected_bounds: Option<Aabb>,
+}
+
+/// Native owner of shared geometry and its two-level instance spatial index.
+#[derive(Default, Clone)]
+#[cfg_attr(feature = "serde-serialize", derive(Serialize, Deserialize))]
+pub struct SharedGeometrySet {
+    groups: Arena<GeometryGroup>,
+    tree: Bvh,
+    changed: Vec<SharedGeometryHandle>,
+}
+
+impl core::fmt::Debug for SharedGeometrySet {
+    fn fmt(&self, formatter: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        formatter
+            .debug_struct("SharedGeometrySet")
+            .field("groups", &self.groups.len())
+            .field("changed", &self.changed.len())
+            .finish_non_exhaustive()
+    }
+}
+
+impl SharedGeometrySet {
+    /// Actual dynamic-collider input for solving a changed geometry boundary.
+    /// Role bits live in the existing affine hierarchy and change only with
+    /// native instance lifecycle/body type. Consumers must deduplicate parents
+    /// and solve the complete contact/joint/multibody closure, including isolates.
+    pub fn solve_colliders<'a>(
+        &'a self,
+        changes: &'a [SharedGeometryChange],
+    ) -> impl Iterator<Item = u32> + 'a {
+        changes.iter().flat_map(move |change| {
+            self.groups
+                .get(change.geometry.0)
+                .into_iter()
+                .flat_map(|group| group.instances.matching_leaves(1))
+        })
+    }
+    /// Bounds of one bound collider from current shared geometry.
+    pub fn instance_bounds(&self, geometry: SharedGeometryHandle, collider: u32) -> Option<Aabb> {
+        let group = self.groups.get(geometry.0)?;
+        group
+            .instances
+            .leaf_bounds(collider, &group.current.local_bounds)
+    }
+
+    /// Actual spatial pair work caused by changed roots, including lost support.
+    /// The ordinary tree is traversed spatially and shared groups use a BVTT
+    /// traversal; no geometry-to-instance fan-out list is constructed.
+    pub fn changed_pairs(
+        &self,
+        changes: &[SharedGeometryChange],
+        ordinary: &Bvh,
+    ) -> Vec<(u32, u32)> {
+        let target_bounds: HashMap<_, _> = changes
+            .iter()
+            .map(|change| {
+                (
+                    change.geometry,
+                    change
+                        .previous
+                        .local_bounds
+                        .merged(&change.current.local_bounds),
+                )
+            })
+            .collect();
+        let mut result = Vec::new();
+        for change in changes {
+            let Some(bounds) = change.affected_bounds else {
+                continue;
+            };
+            let Some(group) = self.groups.get(change.geometry.0) else {
+                continue;
+            };
+            let changed_local = change.changed_local;
+            for ordinary_index in ordinary.intersect_aabb(&bounds) {
+                let Some(target) = ordinary.leaf_node(ordinary_index) else {
+                    continue;
+                };
+                let bounds = target.aabb();
+                for shared in group
+                    .instances
+                    .query(changed_local, |candidate| candidate.intersects(&bounds))
+                {
+                    if shared != ordinary_index {
+                        result.push((shared, ordinary_index));
+                    }
+                }
+            }
+            for target_index in self.tree.intersect_aabb(&bounds) {
+                let Some((target, identity)) = self.groups.get_unknown_gen(target_index) else {
+                    continue;
+                };
+                let handle = SharedGeometryHandle(identity);
+                let target_local = target_bounds
+                    .get(&handle)
+                    .copied()
+                    .unwrap_or(target.current.local_bounds);
+                result.extend(group.instances.intersections(
+                    changed_local,
+                    &target.instances,
+                    target_local,
+                ));
+            }
+        }
+        for (a, b) in &mut result {
+            if *a > *b {
+                core::mem::swap(a, b);
+            }
+        }
+        result.sort_unstable();
+        result.dedup();
+        result
+    }
+
+    /// Retire old broad-phase coverage after the changed-root spatial work.
+    /// Only the changed top-level leaves are refitted.
+    pub fn finish_changes(&mut self, changes: &[SharedGeometryChange]) {
+        for change in changes {
+            let Some(group) = self.groups.get(change.geometry.0) else {
+                continue;
+            };
+            if let Some(bounds) = group.instances.bounds(&group.pending_bounds()) {
+                self.tree
+                    .insert(bounds, change.geometry.0.into_raw_parts().0);
+            }
+        }
+    }
+    /// Visit candidates through both hierarchy levels using an actual query predicate.
+    pub fn leaves<'a, F: Fn(&Aabb) -> bool + Copy + 'a>(
+        &'a self,
+        predicate: F,
+    ) -> impl Iterator<Item = (SharedGeometryHandle, u32)> + 'a {
+        self.tree
+            .leaves(move |node| predicate(&node.aabb()))
+            .flat_map(move |index| {
+                self.groups
+                    .get_unknown_gen(index)
+                    .into_iter()
+                    .flat_map(move |(group, identity)| {
+                        group
+                            .instances
+                            .query(group.current.local_bounds, predicate)
+                            .map(move |collider| (SharedGeometryHandle(identity), collider))
+                    })
+            })
+    }
+
+    /// Find the closest real instance without expanding unrelated geometry groups.
+    pub fn find_best<L: BvhLeafCost>(
+        &self,
+        max_cost: Real,
+        aabb_cost: impl Fn(&Aabb, Real) -> Real,
+        leaf_cost: impl Fn(SharedGeometryHandle, u32, Real) -> Option<L>,
+    ) -> Option<(SharedGeometryHandle, u32, L)> {
+        self.tree
+            .find_best(
+                max_cost,
+                |node, best| aabb_cost(&node.aabb(), best),
+                |index, best| {
+                    let (group, identity) = self.groups.get_unknown_gen(index)?;
+                    let (collider, value) = group.instances.find_best(
+                        &group.current.local_bounds,
+                        best,
+                        &aabb_cost,
+                        |collider, best| leaf_cost(SharedGeometryHandle(identity), collider, best),
+                    )?;
+                    Some((
+                        value.cost(),
+                        (SharedGeometryHandle(identity), collider, value),
+                    ))
+                },
+            )
+            .map(|(_, (_, result))| result)
+    }
+    /// Create an empty native geometry owner.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Admit one already-prepared shape. This creates no collider instances.
+    pub fn insert(&mut self, shape: SharedShape) -> SharedGeometryHandle {
+        SharedGeometryHandle(self.groups.insert(GeometryGroup {
+            current: Arc::new(SharedGeometryVersion::new(shape, 0)),
+            instances: AffineBvh::new(),
+            previous: None,
+            changed_local: None,
+        }))
+    }
+
+    /// Retain one exact shape version, including its derived bounds and mass facts.
+    pub fn capture(&self, geometry: SharedGeometryHandle) -> Option<Arc<SharedGeometryVersion>> {
+        self.groups
+            .get(geometry.0)
+            .map(|group| group.current.clone())
+    }
+
+    /// Borrow the current immutable geometry without creating a snapshot.
+    pub fn get(&self, geometry: SharedGeometryHandle) -> Option<&SharedGeometryVersion> {
+        self.groups
+            .get(geometry.0)
+            .map(|group| group.current.as_ref())
+    }
+
+    /// Replace one geometry root. No instance is visited, dirtied or awakened.
+    pub fn adopt(&mut self, geometry: SharedGeometryHandle, shape: SharedShape) -> bool {
+        let Some(previous) = self.get(geometry) else {
+            return false;
+        };
+        let bounds = previous.local_bounds.merged(&shape.compute_local_aabb());
+        self.adopt_region(geometry, shape, bounds)
+    }
+
+    fn adopt_region(
+        &mut self,
+        geometry: SharedGeometryHandle,
+        shape: SharedShape,
+        bounds: Aabb,
+    ) -> bool {
+        let Some(group) = self.groups.get_mut(geometry.0) else {
+            return false;
+        };
+        let next = Arc::new(SharedGeometryVersion::new(
+            shape,
+            group
+                .current
+                .revision
+                .checked_add(1)
+                .expect("geometry revision exhausted"),
+        ));
+        if group.previous.is_none() {
+            group.previous = Some(group.current.clone());
+            self.changed.push(geometry);
+        }
+        group.changed_local = Some(
+            group
+                .changed_local
+                .map_or(bounds, |prior| prior.merged(&bounds)),
+        );
+        group.current = next;
+        if let Some(bounds) = group.instances.bounds(&group.pending_bounds()) {
+            self.tree.insert(bounds, geometry.0.into_raw_parts().0);
+        }
+        true
+    }
+
+    /// Regionally replace the one heightfield child of a Terrain root.
+    #[cfg(feature = "dim3")]
+    pub fn write_heightfield(
+        &mut self,
+        geometry: SharedGeometryHandle,
+        indices: &[u32],
+        values: &[Real],
+    ) -> bool {
+        let Some(version) = self.get(geometry) else {
+            return false;
+        };
+        let Some(compound) = version.shape.as_compound() else {
+            return false;
+        };
+        let [(pose, shape)] = compound.shapes() else {
+            return false;
+        };
+        let Some(heightfield) = shape.as_heightfield() else {
+            return false;
+        };
+        let mut next = heightfield.clone();
+        if !next.write_heights(indices, values) {
+            return false;
+        }
+        if indices.is_empty() {
+            return true;
+        }
+        let mut bounds: Option<Aabb> = None;
+        for &index in indices {
+            let row = index as usize % heightfield.heights().nrows();
+            let column = index as usize / heightfield.heights().nrows();
+            for i in row.saturating_sub(1)..=row.min(heightfield.nrows() - 1) {
+                for j in column.saturating_sub(1)..=column.min(heightfield.ncols() - 1) {
+                    for field in [heightfield, &next] {
+                        let triangles = field.triangles_at(i, j);
+                        for triangle in [triangles.0, triangles.1].into_iter().flatten() {
+                            let cell = triangle.compute_local_aabb().transform_by(pose);
+                            bounds = Some(bounds.map_or(cell, |prior| prior.merged(&cell)));
+                        }
+                    }
+                }
+            }
+        }
+        let shape = SharedShape::compound(vec![(*pose, SharedShape::new(next))]);
+        // Removed cells can have no triangles; the conservative old/new root
+        // still preserves the actual geometry identity publication in that case.
+        let bounds = bounds.unwrap_or(version.local_bounds);
+        self.adopt_region(geometry, shape, bounds)
+    }
+
+    /// Add or move one real collider instance, refitting only its index paths.
+    pub fn set_instance(
+        &mut self,
+        geometry: SharedGeometryHandle,
+        collider: u32,
+        transform: AffineTransform,
+    ) -> bool {
+        self.set_instance_motion(geometry, collider, transform, transform, 0.0, false)
+    }
+
+    /// Update one instance's real motion envelope and contact margin.
+    pub fn set_instance_motion(
+        &mut self,
+        geometry: SharedGeometryHandle,
+        collider: u32,
+        from: AffineTransform,
+        to: AffineTransform,
+        margin: Real,
+        dynamic: bool,
+    ) -> bool {
+        let Some(group) = self.groups.get_mut(geometry.0) else {
+            return false;
+        };
+        group.instances.insert_motion_with_mask(
+            collider,
+            from,
+            to,
+            margin,
+            &group.current.local_bounds,
+            u32::from(dynamic),
+        );
+        self.tree.insert(
+            group.instances.bounds(&group.pending_bounds()).unwrap(),
+            geometry.0.into_raw_parts().0,
+        );
+        true
+    }
+
+    /// Retire one actual collider binding. It is not a geometry-change operation.
+    pub fn remove_instance(&mut self, geometry: SharedGeometryHandle, collider: u32) -> bool {
+        let Some(group) = self.groups.get_mut(geometry.0) else {
+            return false;
+        };
+        if !group.instances.remove(collider) {
+            return false;
+        }
+        if let Some(bounds) = group.instances.bounds(&group.pending_bounds()) {
+            self.tree.insert(bounds, geometry.0.into_raw_parts().0);
+        } else {
+            self.tree.remove(geometry.0.into_raw_parts().0);
+        }
+        true
+    }
+
+    /// Retire an unused geometry. Live bindings prevent premature destruction.
+    pub fn remove(&mut self, geometry: SharedGeometryHandle) -> bool {
+        if self
+            .groups
+            .get(geometry.0)
+            .is_none_or(|group| !group.instances.is_empty())
+        {
+            return false;
+        }
+        self.tree.remove(geometry.0.into_raw_parts().0);
+        self.groups.remove(geometry.0).is_some()
+    }
+
+    /// Query actual candidate instances against their current shared geometry bounds.
+    pub fn intersect_aabb<'a>(
+        &'a self,
+        bounds: &'a Aabb,
+    ) -> impl Iterator<Item = (SharedGeometryHandle, u32)> + 'a {
+        self.tree.intersect_aabb(bounds).flat_map(move |index| {
+            self.groups
+                .get_unknown_gen(index)
+                .into_iter()
+                .flat_map(move |(group, identity)| {
+                    group
+                        .instances
+                        .query(group.current.local_bounds, move |candidate| {
+                            candidate.intersects(bounds)
+                        })
+                        .map(move |collider| (SharedGeometryHandle(identity), collider))
+                })
+        })
+    }
+
+    /// Consume only changed group roots at the solver boundary. Even a shape edit
+    /// with equal AABBs is retained; bounds equality is not shape equality.
+    pub fn take_changes(&mut self) -> Vec<SharedGeometryChange> {
+        core::mem::take(&mut self.changed)
+            .into_iter()
+            .filter_map(|geometry| {
+                let group = self.groups.get_mut(geometry.0)?;
+                let previous = group.previous.take()?;
+                let changed_local = group.changed_local.take()?;
+                let affected_bounds = group.instances.bounds(&changed_local);
+                Some(SharedGeometryChange {
+                    geometry,
+                    previous,
+                    current: group.current.clone(),
+                    changed_local,
+                    affected_bounds,
+                })
+            })
+            .collect()
+    }
+}
