+thread_local! {
+    static MEASURE_ALLOC: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    static ALLOCATED_BYTES: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+struct MeasuredAllocator;
+unsafe impl std::alloc::GlobalAlloc for MeasuredAllocator {
+    unsafe fn alloc(&self, layout: std::alloc::Layout) -> *mut u8 {
+        MEASURE_ALLOC.with(|active| {
+            if active.get() {
+                ALLOCATED_BYTES.with(|bytes| bytes.set(bytes.get() + layout.size()));
+            }
+        });
+        unsafe { std::alloc::System.alloc(layout) }
+    }
+    unsafe fn dealloc(&self, pointer: *mut u8, layout: std::alloc::Layout) {
+        unsafe { std::alloc::System.dealloc(pointer, layout) }
+    }
+}
+#[global_allocator]
+static ALLOCATOR: MeasuredAllocator = MeasuredAllocator;
+fn allocations<T>(work: impl FnOnce() -> T) -> (T, usize) {
+    ALLOCATED_BYTES.with(|bytes| bytes.set(0));
+    MEASURE_ALLOC.with(|active| active.set(true));
+    let result = work();
+    MEASURE_ALLOC.with(|active| active.set(false));
+    (result, ALLOCATED_BYTES.with(|bytes| bytes.get()))
+}
+fn terrain_shape(n: usize) -> SharedShape {
+    SharedShape::compound(vec![(
+        Pose::translation((n - 1) as f32 / 2.0, 0.0, (n - 1) as f32 / 2.0),
+        SharedShape::heightfield(
+            rapier3d::parry::utils::Array2::repeat(n, n, 0.0),
+            Vector::new((n - 1) as f32, 1.0, (n - 1) as f32),
+        ),
+    )])
+}
+#[test]
+fn heightfield_range_retains_old_shape_and_allocates_only_changed_blocks() {
+    let mut groups = SharedGeometrySet::new();
+    let n = 1024;
+    let geometry = groups.insert(terrain_shape(n));
+    let old = groups.capture(geometry).unwrap();
+    groups.set_instance(
+        geometry,
+        7,
+        AffineTransform {
+            rows: [Vector::X, Vector::Y, Vector::Z],
+            translation: Vector::ZERO,
+        },
+    );
+    let (changed, bytes) =
+        allocations(|| groups.write_heightfield(geometry, &[100 * n as u32 + 100], &[2.0]));
+    assert!(changed);
+    assert!(bytes < 16 * 1024, "one sample copied {bytes} bytes");
+    let current = groups.capture(geometry).unwrap();
+    let ray = Ray::new(Vector::new(100.0, 10.0, 100.0), -Vector::Y);
+    assert_eq!(old.shape.cast_local_ray(&ray, 20.0, true), Some(10.0));
+    assert!((current.shape.cast_local_ray(&ray, 20.0, true).unwrap() - 8.0).abs() < 1e-4);
+    let changes = groups.take_changes();
+    assert_eq!(changes.len(), 1);
+    let bounds = changes[0].affected_bounds.unwrap();
+    assert!(bounds.mins.x >= 98.99 && bounds.maxs.x <= 101.01);
+    assert!(bounds.mins.z >= 98.99 && bounds.maxs.z <= 101.01);
+    let (_, scale_bytes) =
+        allocations(|| current.scaled_shape(Vector::new(2.0, 3.0, 4.0)).unwrap());
+    assert!(
+        scale_bytes < 8192,
+        "scale cloned full sample storage: {scale_bytes}"
+    );
+    assert!(groups.write_heightfield(geometry, &[100 * n as u32 + 100], &[-3.0]));
+    assert_eq!(groups.get(geometry).unwrap().local_bounds.maxs.y, 2.0);
+    assert_eq!(groups.get(geometry).unwrap().local_bounds.mins.y, -3.0);
+    assert!(!groups.write_heightfield(geometry, &[n as u32 * n as u32], &[1.0]));
+    assert!(!groups.write_heightfield(geometry, &[0], &[f32::NAN]));
+    assert_eq!(current.local_bounds.maxs.y, 2.0);
+    assert_eq!(current.local_bounds.mins.y, 0.0);
+    eprintln!("regional heightfield: 1024x1024 single sample allocation={bytes}, scale allocation={scale_bytes}");
+}
