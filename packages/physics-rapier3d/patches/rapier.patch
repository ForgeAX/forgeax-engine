+#[test]
+fn broad_phase_keeps_shared_instances_out_of_ordinary_tree_and_reports_geometry_pairs() {
+    use rapier3d::geometry::BroadPhasePairEvent;
+    let params = IntegrationParameters::default();
+    let mut bodies = RigidBodySet::new();
+    let mut colliders = ColliderSet::new();
+    let mut broad = BroadPhaseBvh::new();
+    let shared = colliders.insert(ColliderBuilder::ball(0.25));
+    let body = bodies.insert(RigidBodyBuilder::dynamic().translation(Vector::new(2.0, 0.0, 0.0)));
+    let other = colliders.insert_with_parent(ColliderBuilder::ball(0.5), body, &mut bodies);
+    let geometry = colliders.shared_geometry.insert(SharedShape::ball(0.25));
+    assert!(colliders.bind_shared_geometry(shared, geometry, Vector::ONE));
+    let mut events = Vec::new();
+    broad.update(
+        &params,
+        &colliders,
+        &bodies,
+        &[shared, other],
+        &[],
+        &[],
+        &mut events,
+    );
+    assert!(events.is_empty());
+    let narrow = NarrowPhase::new();
+    assert_eq!(
+        broad
+            .as_query_pipeline(
+                narrow.query_dispatcher(),
+                &bodies,
+                &colliders,
+                QueryFilter::default()
+            )
+            .bvh
+            .leaf_count(),
+        1
+    );
+    assert!(colliders
+        .shared_geometry
+        .adopt(geometry, SharedShape::ball(2.0)));
+    let changes = colliders.shared_geometry.take_changes();
+    broad.update(
+        &params,
+        &colliders,
+        &bodies,
+        &[],
+        &[],
+        &changes,
+        &mut events,
+    );
+    colliders.shared_geometry.finish_changes(&changes);
+    assert_eq!(broad.geometry_changed_pairs().len(), 1);
+    assert!(matches!(
+        events.as_slice(),
+        [BroadPhasePairEvent::AddPair(_)]
+    ));
+    events.clear();
+    assert!(colliders
+        .shared_geometry
+        .adopt(geometry, SharedShape::cuboid(2.0, 2.0, 2.0)));
+    let changes = colliders.shared_geometry.take_changes();
+    broad.update(
+        &params,
+        &colliders,
+        &bodies,
+        &[],
+        &[],
+        &changes,
+        &mut events,
+    );
+    colliders.shared_geometry.finish_changes(&changes);
+    assert_eq!(
+        broad.geometry_changed_pairs().len(),
+        1,
+        "same AABB still schedules actual contact work"
+    );
+    assert!(
+        events.is_empty(),
+        "existing pair does not need duplicate registration"
+    );
+    assert!(colliders
+        .shared_geometry
+        .adopt(geometry, SharedShape::ball(0.25)));
+    let changes = colliders.shared_geometry.take_changes();
+    broad.update(
+        &params,
+        &colliders,
+        &bodies,
+        &[],
+        &[],
+        &changes,
+        &mut events,
+    );
+    colliders.shared_geometry.finish_changes(&changes);
+    assert_eq!(
+        broad.geometry_changed_pairs().len(),
+        1,
+        "lost support remains solver input"
+    );
+    assert!(matches!(
+        events.as_slice(),
+        [BroadPhasePairEvent::DeletePair(_)]
+    ));
+}
