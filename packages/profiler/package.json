{
  "name": "@forgeax/engine-profiler",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "CPU profile capture, bounded recording, and deterministic offline analysis for forgeax-engine.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs"
    },
    "./browser-user-timing": {
      "types": "./dist/browser-user-timing.d.ts",
      "import": "./dist/browser-user-timing.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/generate-profile-types.mjs && node scripts/generate-validator.mjs && tsup",
    "test": "vitest run",
    "smoke:consumer": "node scripts/consume-smoke.mjs",
    "test:perf": "node ../../scripts/bench/profiler-overhead.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/index.mjs",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "library package without a canvas frame loop"
      },
      "bench": {
        "enabled": false,
        "reason": "performance gate runs through the package test:perf script"
      },
      "gate": {
        "enabled": true,
        "command": "pnpm --filter @forgeax/engine-profiler test:perf"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package"
      }
    }
  }
}
