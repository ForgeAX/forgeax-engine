{
  "name": "@forgeax/engine-rhi-debug",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Single-file v7 RHI tape capture, FrameModel projection, deterministic fresh-backend replay, and structured AI-readable inspection for forgeax-engine.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@forgeax/engine-rhi": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "pako": "^1.0.11"
  },
  "devDependencies": {
    "@forgeax/engine-rhi-null": "workspace:*",
    "@types/node": "^20.14.0",
    "@webgpu/types": "^0.1.74"
  },
  "peerDependencies": {
    "@forgeax/engine-rhi-webgpu": "workspace:*",
    "@forgeax/engine-rhi-wgpu": "workspace:*"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/index.mjs",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "debug instrumentation package, no hot render path"
      },
      "bench": {
        "enabled": false,
        "reason": "instrumentation package; bench focus stays on runtime/rhi"
      },
      "gate": {
        "enabled": false,
        "reason": "r12-lint runs at repo root via root package.json#scripts.r12-lint; not modelled as a per-package metric gate yet"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package"
      }
    }
  }
}
