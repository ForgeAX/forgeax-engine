{
  "name": "@forgeax/engine-runtime",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Renderer + Backend (WebGPU/WebGL2) async factory entry for forgeax-engine.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./internal/renderer-host": {
      "types": "./dist/renderer-host.d.ts",
      "import": "./dist/renderer-host.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "bench:nineslice": "node ../../scripts/bench/bench-nineslice-100panel.mjs"
  },
  "dependencies": {
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-animation": "workspace:*",
    "@forgeax/engine-audio-webaudio": "workspace:*",
    "@forgeax/engine-codec": "workspace:*",
    "@forgeax/engine-debug-draw": "workspace:*",
    "@forgeax/engine-font": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-geometry": "workspace:*",
    "@forgeax/engine-graphics-extras": "workspace:*",
    "@forgeax/engine-image": "workspace:*",
    "@forgeax/engine-input": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-pack": "workspace:^",
    "@forgeax/engine-profiler": "workspace:*",
    "@forgeax/engine-render-graph": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-skinning": "workspace:*",
    "@forgeax/engine-rhi": "workspace:*",
    "@forgeax/engine-rhi-null": "workspace:*",
    "@forgeax/engine-rhi-webgpu": "workspace:*",
    "@forgeax/engine-rhi-wgpu": "workspace:*",
    "@forgeax/engine-shader": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-vfx": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-terrain": "workspace:*",
    "@forgeax/engine-rhi-debug": "workspace:*",
    "@forgeax/engine-import": "workspace:*",
    "@forgeax/engine-naga": "workspace:*",
    "@forgeax/engine-shader-compiler": "workspace:*",
    "@forgeax/engine-physics": "workspace:*",
    "@forgeax/engine-physics-rapier3d": "workspace:*",
    "@forgeax/engine-state": "workspace:*",
    "@forgeax/engine-vfx-compiler": "workspace:*",
    "@forgeax/engine-vfx-render": "workspace:*",
    "@forgeax/engine-vite-plugin-shader": "workspace:*",
    "@forgeax/engine-vite-plugin-pack": "workspace:*",
    "@types/node": "^20.14.0"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/index.mjs",
        "compression": "gzip",
        "expected": 93148
      },
      "fps": {
        "enabled": false,
        "reason": "renderer entry without bundled canvas; fps reported by hello-triangle / hello-cube apps that consume the renderer"
      },
      "bench": {
        "enabled": false,
        "reason": "runtime owns no benchmarked hot path; the transparent-sort bench lives with its owner in @forgeax/engine-render"
      },
      "gate": {
        "enabled": true,
        "reason": "node scripts/forgeax/check-pipeline-vocabulary-isolation.mjs"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package"
      }
    }
  }
}
