{
  "name": "@forgeax/engine-skinning",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Optional skin and joint binding domain.",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs" }, "./package.json": "./package.json" },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": { "build": "tsup", "test": "vitest run" },
  "dependencies": {
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-plugin": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "forgeax": { "metrics": {
    "bundle-size": { "enabled": true, "path": "dist/index.mjs", "compression": "gzip" },
    "fps": { "enabled": false, "reason": "headless binding package" },
    "bench": { "enabled": false, "reason": "binding is validated by unit tests" },
    "gate": { "enabled": false, "reason": "no package binary gate" },
    "spike-report": { "enabled": false, "reason": "not a spike package" }
  }}
}
