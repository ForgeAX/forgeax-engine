{
  "name": "@forgeax/engine-tool-runtime",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Realm-neutral typed tool contributions and terminal contracts for AI authoring.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": { "enabled": true, "path": "dist/index.mjs", "compression": "gzip" },
      "fps": { "enabled": false, "reason": "Tool execution is outside the frame loop" },
      "bench": { "enabled": false, "reason": "The runtime contract owns no hot loop" },
      "gate": { "enabled": true, "command": "pnpm test", "cwd": "packages/tool-runtime" },
      "spike-report": { "enabled": false, "reason": "Production contract package" }
    }
  }
}
