{
  "name": "@forgeax/engine-vfx-compiler",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Build-time composition, validation, reflection, and deterministic cooking for authored VFX WGSL hooks.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@forgeax/engine-pack": "workspace:*",
    "@forgeax/engine-shader-compiler": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-vfx": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-naga": "workspace:*",
    "@webgpu/types": "^0.1.74"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/index.mjs",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "build-time compiler package; no frame loop or canvas"
      },
      "bench": {
        "enabled": false,
        "reason": "compiler correctness is covered by deterministic unit tests"
      },
      "gate": {
        "enabled": false,
        "reason": "public contract covered by package tests and workspace gates"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package"
      }
    }
  }
}
