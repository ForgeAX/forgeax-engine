{
  "name": "@forgeax/engine-vfx-render",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Downstream persistent GPU simulation and indirect renderer for cooked code-first particle effects.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-math": "workspace:*",
    "@forgeax/engine-render": "workspace:*",
    "@forgeax/engine-scene": "workspace:*",
    "@forgeax/engine-types": "workspace:*",
    "@forgeax/engine-vfx": "workspace:*"
  },
  "devDependencies": {
    "@forgeax/engine-render-graph": "workspace:*",
    "@forgeax/engine-rhi": "workspace:*",
    "@forgeax/engine-rhi-webgpu": "workspace:*",
    "@forgeax/engine-vfx-compiler": "workspace:*",
    "@webgpu/types": "^0.1.74"
  },
  "forgeax": {
    "materialPrograms": {
      "billboard.wgsl": { "bindings": "view-and-scene-depth", "sceneDepth": "before-pass" },
      "billboard-inputs.wgsl": { "bindings": "view-and-scene-depth", "sceneDepth": "before-pass" },
      "mesh.wgsl": { "bindings": "render-material" },
      "mesh-inputs.wgsl": { "bindings": "render-material" },
      "mesh-unlit.wgsl": { "bindings": "render-material" },
      "mesh-inputs-unlit.wgsl": { "bindings": "render-material" },
      "mesh-shadow.wgsl": { "bindings": "view-only" },
      "ribbon.wgsl": { "bindings": "view-only" },
      "ribbon-inputs.wgsl": { "bindings": "view-only" },
      "trail.wgsl": { "bindings": "view-only" },
      "trail-inputs.wgsl": { "bindings": "view-only" },
      "beam.wgsl": { "bindings": "view-only" },
      "beam-inputs.wgsl": { "bindings": "view-only" }
    },
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/index.mjs",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "renderer feature package has no host frame loop"
      },
      "bench": {
        "enabled": true,
        "reportSchema": "vfx-batch-b"
      },
      "gate": {
        "enabled": true,
        "reason": "public feature and dependency boundary checks"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package"
      }
    }
  }
}
