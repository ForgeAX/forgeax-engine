{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ForgeAX/forgeax-engine/sdk-candidate.schema.json",
  "title": "ForgeAX SDK sealed candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "sdkVersion",
    "engineCommit",
    "viewCommit",
    "artifacts",
    "npmPackages",
    "gates",
    "sealedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["3.0.0", "4.0.0"]
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]+$"
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-dev\\.(0|[1-9][0-9]*)\\.[0-9a-f]{12}|-rc\\.(0|[1-9][0-9]*))?$"
    },
    "engineCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceWorkflowRunId": {
      "type": "integer",
      "minimum": 1
    },
    "origin": {
      "type": "string",
      "enum": ["github-actions", "local"]
    },
    "localRunId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "npmPackages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/npmPackage"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "sealedAt": {
      "type": "string",
      "minLength": 1
    },
    "viewCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "4.0.0" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": { "origin": { "type": "string" } },
        "required": ["origin"]
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": "3.0.0" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": { "sourceWorkflowRunId": { "type": "integer" } },
        "required": ["sourceWorkflowRunId"],
        "not": {
          "anyOf": [
            { "properties": { "origin": { "type": "string" } }, "required": ["origin"] },
            { "properties": { "localRunId": { "type": "string" } }, "required": ["localRunId"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": "4.0.0" },
          "origin": { "const": "github-actions" }
        },
        "required": ["schemaVersion", "origin"]
      },
      "then": {
        "properties": { "sourceWorkflowRunId": { "type": "integer" } },
        "required": ["sourceWorkflowRunId"],
        "not": { "properties": { "localRunId": { "type": "string" } }, "required": ["localRunId"] }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": "4.0.0" },
          "origin": { "const": "local" }
        },
        "required": ["schemaVersion", "origin"]
      },
      "then": {
        "properties": { "localRunId": { "type": "string" } },
        "required": ["localRunId"],
        "not": {
          "properties": { "sourceWorkflowRunId": { "type": "integer" } },
          "required": ["sourceWorkflowRunId"]
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/].*$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "npmPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path", "integrity", "publishOrder"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["@forgeax/engine", "@forgeax/engine-sdk"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        },
        "publishOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "durationMs", "report", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["npm-consumer", "archive-browser", "reproducibility", "collision"]
        },
        "result": {
          "const": "passed"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
