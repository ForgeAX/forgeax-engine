{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ForgeAX/forgeax-engine/sdk-candidate.schema.json",
  "title": "ForgeAX SDK sealed candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "sdkVersion",
    "engineCommit",
    "viewCommit",
    "sourceWorkflowRunId",
    "artifacts",
    "npmPackages",
    "gates",
    "sealedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0.0"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]+$"
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-dev\\.(0|[1-9][0-9]*)\\.[0-9a-f]{12}|-rc\\.(0|[1-9][0-9]*))?$"
    },
    "engineCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceWorkflowRunId": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "npmPackages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/npmPackage"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "sealedAt": {
      "type": "string",
      "minLength": 1
    },
    "viewCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.)(?!.*(?:^|/)\\.\\.?/)[^/].*$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "npmPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path", "integrity", "publishOrder"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["@forgeax/engine", "@forgeax/engine-sdk"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        },
        "publishOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "durationMs", "report", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["npm-consumer", "archive-browser", "reproducibility", "collision"]
        },
        "result": {
          "const": "passed"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
