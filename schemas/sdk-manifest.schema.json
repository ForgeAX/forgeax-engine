{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ForgeaX-Games/forgeax-engine/sdk-manifest.schema.json",
  "title": "ForgeaX SDK archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sdkVersion",
    "engineCommit",
    "requirements",
    "capabilities",
    "packages",
    "templates",
    "skills",
    "resources",
    "templateResources",
    "source",
    "artifacts",
    "viewCommit"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.11.0"
    },
    "sdkVersion": {
      "type": "string",
      "minLength": 1
    },
    "engineCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "pnpmStoreFormat"],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "pnpm": {
          "type": "string",
          "minLength": 1
        },
        "pnpmStoreFormat": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["app", "render", "assets", "shader", "physics", "audio", "vfx", "ui", "debug"]
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "templateResources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/templateResource"
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "viewCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "format",
        "excluded",
        "gitDependencies",
        "fileCount",
        "byteCount",
        "prebuiltWasm"
      ],
      "properties": {
        "root": {
          "const": "source/engine"
        },
        "format": {
          "const": "git-archive-public-snapshot"
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              ".gitmodules",
              "forgeax-engine-assets",
              ".github",
              "third_party/wgpu/.github",
              "third_party/blitz/.github",
              "tools/view/.github"
            ]
          }
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1
        },
        "gitDependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "commit"],
            "properties": {
              "root": {
                "enum": ["third_party/wgpu", "third_party/blitz", "tools/view"]
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        "prebuiltWasm": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceWasm"
          }
        }
      }
    },
    "sourceWasm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "root", "files"],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^@forgeax/engine-.+$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "enginePath": {
          "type": "string",
          "minLength": 1,
          "description": "npm carrier: omit these bytes and materialize this relative path from the exact-version Engine dependency, verifying bytes and sha256."
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "root", "fileCount", "byteCount", "role"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^@forgeax/(?:engine(?:-.+)?|view)$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "pattern": "^(?:packages/[A-Za-z0-9._-]+|tools/view)$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": ["runtime", "tool"]
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "root": {
          "type": "string",
          "pattern": "^templates/[A-Za-z0-9._-]+$"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "fileCount", "byteCount"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "root": {
          "type": "string",
          "pattern": "^skills/[a-z0-9][a-z0-9-]*$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "package", "sourceRoot", "packageRoot", "files"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "package": {
          "type": "string",
          "pattern": "^@forgeax/engine-.+$"
        },
        "sourceRoot": {
          "type": "string",
          "pattern": "^packages/[A-Za-z0-9._/-]+$"
        },
        "packageRoot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        }
      }
    },
    "templateResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "files"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "root": {
          "type": "string",
          "pattern": "^templates/[A-Za-z0-9._-]+/assets/"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        }
      }
    }
  }
}
