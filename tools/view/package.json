  "scripts": {
    "build": "node scripts/build-tool.mjs",
    "build:viewer": "pnpm --filter @forgeax/view-viewer build",
    "dev": "node scripts/dev-viewer.mjs",
    "dev:ui": "node scripts/dev-viewer.mjs --fixture",
    "storybook": "pnpm --filter @forgeax/view-components storybook",
    "build:storybook": "pnpm --filter @forgeax/view-components build:storybook",
    "check:components": "pnpm --filter @forgeax/view-components check",
    "check:packages": "tsc -p tsconfig.json",
    "check:architecture": "node scripts/check-architecture.mjs && node --test test/source-boundaries.test.mjs test/architecture-ci.test.mjs test/no-legacy-surfaces.test.mjs test/chromium-sandbox-contract.test.mjs",
    "prepack": "pnpm run build",
    "test": "node --test scripts/release-npm.test.mjs test/*.test.mjs",
    "test:view": "node --test test/*.test.mjs",
    "test:resource-preview": "node scripts/verify-resource-preview-lifecycle.mjs",
    "test:package": "node --test test/package-aggregate.test.mjs"
  },
  "license": "Apache-2.0",
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": false,
        "reason": "View-owned product and interaction tests run in paired Engine test:view CI."
      },
      "fps": {
        "enabled": false,
        "reason": "View-owned product and interaction tests run in paired Engine test:view CI."
      },
      "bench": {
        "enabled": false,
        "reason": "View-owned product and interaction tests run in paired Engine test:view CI."
      },
      "gate": {
        "enabled": true,
        "command": "pnpm check:architecture",
        "cwd": "."
      },
      "spike-report": {
        "enabled": false,
        "reason": "View-owned product and interaction tests run in paired Engine test:view CI."
      }
    }
  }
