    "./schema": "./src/schema.ts",
    "./ui": "./src/ui/mount.tsx",
    "./ui/panel": "./src/ui/PluginsPanel.tsx"
  },
  "dependencies": {
    "@forgeax/engine-plugin": "workspace:*",
