{
  "name": "@forgeax/view-plugin-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ForgeaX View product plugin: host plugin manifest.",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend.ts",
    "./frontend": "./src/frontend.ts",
    "./identity": "./src/identity.ts",
    "./api": "./src/api.ts",
    "./runtime": "./src/runtime.ts",
    "./cli": "./src/cli.ts",
