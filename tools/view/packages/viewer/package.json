    "@forgeax/view-plugin-display": "workspace:*",
    "@forgeax/view-plugin-inspector": "workspace:*",
    "@forgeax/view-plugin-material": "workspace:*",
    "@forgeax/view-plugin-mesh": "workspace:*",
    "@forgeax/view-plugin-html": "workspace:*",
    "@forgeax/view-plugin-texture": "workspace:*",
    "@forgeax/view-plugin-asset": "workspace:*",
    "@forgeax/view-plugin-plugins": "workspace:*",
    "@forgeax/view-plugin-scene": "workspace:*",
    "@forgeax/view-plugin-scene-tree": "workspace:*",
    "@forgeax/view-plugin-viewport": "workspace:*",
    "dockview": "^6.6.1",
    "lucide-react": "^0.460.0",
