{
  "name": "@forgeax/view-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./catalog": "./src/catalog.ts",
    "./catalog/shared": "./src/catalog-shared.ts",
    "./catalog/backend": "./src/backend-catalog.ts",
    "./catalog/frontend": "./src/frontend-catalog.ts",
